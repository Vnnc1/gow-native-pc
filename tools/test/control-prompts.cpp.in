// Production input and label regression, with a fake host backend.
#include "raylib.h"
#include "runtime/ps2_pad.h"
#include "runtime/gow_prompt_input.h"
#include <cassert>
#include <cstring>
#include <cstdio>
#include <cstdlib>
#include <vector>
#include <mutex>
std::array<bool,512> keys{};
std::array<bool,8> mouse{};
std::array<bool,4> connected{};
std::array<std::array<bool,18>,4> buttons{};
std::array<std::array<float,4>,4> axes{};
bool focused=true;
extern "C" {
bool IsKeyDown(int c) { return c>=0 && c<512 && keys[c]; }
bool IsMouseButtonDown(int c) { return c>=0 && c<8 && mouse[c]; }
bool IsGamepadAvailable(int p) { return p>=0 && p<4 && connected[p]; }
bool IsGamepadButtonDown(int p,int b) { return buttons[p][b]; }
bool IsGamepadButtonPressed(int,int) { return false; }
float GetGamepadAxisMovement(int p,int a) { return axes[p][a]; }
const char *GetGamepadName(int) { return "Xbox"; }
void SetGamepadVibration(int,float,float,float) {}
bool IsWindowReady() { return true; }
bool IsWindowFocused() { return focused; }
double GetTime() { return 0; }
const char *glfwGetKeyName(int,int) { return nullptr; }
}
bool ps2PadWindowsRumble(uint8_t,bool) { return false; }
int tobiichiCodigosAccion(const char *,int *,int);
int tobiichiBotonMandoAccion(const char *);
bool tobiichiSticksTeclado(uint8_t (&)[4]);
@LABELS@
void env(const char *k,const char *v) {
#ifdef _WIN32
    _putenv_s(k,v);
#else
    setenv(k,v,1);
#endif
}
int main(int argc,char **argv) {
    Boton found;
    assert(colorDeBoton(0xFF9999FF,found) && found==BCruz);
    assert(colorDeBoton(0xFFCC6400,found) && found==BCirculo);
    assert(colorDeBoton(0xFFFF6699,found) && found==BCuadrado);
    assert(colorDeBoton(0xFF009955,found) && found==BTriangulo);
    assert(!colorDeBoton(0xFFFFFFFF,found));
    assert(rotuloDeBoton("R2",found) && found==BR2);
    assert(!rotuloDeBoton("LEVEL",found));
    int qteFaces=0;
    for (auto &symbol:kSimbolos) if (symbol.variante==VGriego && symbol.boton<=BTriangulo) ++qteFaces;
    assert(qteFaces==4);
    Icono icon{BCruz,VGriego,50,60,20,1,1,1,1};
    anotar(icon); anotar(icon); assert(g_construyendo.size()==1);
    gowIconosFrame(); assert(g_publicados.size()==1 && g_construyendo.empty());
    gowIconosFrame(); assert(g_publicados.empty());
    for(int i=0;i<300;++i) { icon.x=10.0f*i; anotar(icon); }
    assert(g_construyendo.size()==128); gowIconosFrame(); gowIconosFrame();
    bool custom=argc>1 && std::strcmp(argv[1],"custom")==0;
    if(custom) {
        env("TOBIICHI_TECLAS","cross=75,1000;circle=1001;square=1003;triangle=71;l1=341;li_arriba=87;li_der=68;hades=52;furia=86");
        env("TOBIICHI_MANDO","cross=5;circle=7;square=6;triangle=8;l1=12;start=15;select=13;furia=16");
    }
    assert(gowPromptFamily("Xbox Wireless Controller")==2);
    assert(gowPromptFamily("PS4 Controller")==3);
    assert(gowPromptFamily("Sony DualSense Wireless Controller")==4);
    assert(gowPromptFamily(nullptr)==2);
    connected[2]=true;
    gowPromptPoll(); assert(gowPromptGamepad()==2);
    keys[custom?KEY_K:KEY_SPACE]=true;
    gowPromptPoll(); assert(gowPromptGamepad()==-1);
    PSPadBackend backend; uint8_t data[32]{};
    backend.readState(0,0,data,32); assert(!(data[3]&0x40));
    axes[2][0]=.1f; gowPromptPoll(); assert(gowPromptGamepad()==-1);
    axes[2][0]=.8f; gowPromptPoll(); assert(gowPromptGamepad()==2);
    gowPromptPoll(); assert(gowPromptGamepad()==2); // A held key is not a new input.
    keys[custom?KEY_K:KEY_SPACE]=false; gowPromptPoll();
    mouse[custom?1:0]=true; gowPromptPoll(); assert(gowPromptGamepad()==-1);
    uint8_t sticks[4]{}; keys[KEY_D]=true;
    if(custom) assert(tobiichiSticksTeclado(sticks) && sticks[2]==255);
    focused=false; buttons[2][5]=true; gowPromptPoll(); assert(gowPromptGamepad()==-1);
    focused=true; gowPromptPoll(); assert(gowPromptGamepad()==-1);
    for(int p=0;p<4;++p) {
        connected[p]=true; buttons[p][6]=true;
        gowPromptPoll(); assert(gowPromptGamepad()==p);
        buttons[p][6]=false; gowPromptPoll();
    }
    connected[3]=false; gowPromptPoll(); assert(gowPromptGamepad()==-1);
    gow_prompt::preferMouse.store(false);
    assert(rotulo(ETeclado,BCruz)==(custom?"K":"#ESP"));
    assert(rotulo(ETeclado,BCirculo)==(custom?"#RAT1":"F"));
    assert(rotulo(EXbox,BCruz)==(custom?"Y":"A"));
    assert(rotulo(EPS4,BCruz)==(custom?"#TRIANGLE":"#CROSS"));
    assert(rotulo(EDualSense,BCuadrado)==(custom?"#CIRCLE":"#TRIANGLE"));
    assert(rotulo(EPS4,BSelect)=="SHARE");
    assert(rotulo(EDualSense,BSelect)=="CREATE");
    if(custom) {
        gow_prompt::preferMouse.store(true);
        assert(rotulo(ETeclado,BCruz)=="#RAT0");
        assert(rotulo(ETeclado,BArriba)=="4");
        assert(rotulo(ETeclado,BL3)=="V");
        assert(rotulo(EXbox,BArriba)=="#ARR");
        assert(rotulo(EPS4,BL3)=="L3" && rotulo(EPS4,BR3)=="L3");
        assert(rotulo(EXbox,BL1)=="RT"); assert(rotulo(EPS4,BL1)=="R2");
        assert(rotulo(ETeclado,BStart)=="-"); assert(rotulo(EXbox,BR1)=="-");
    }
    std::puts("PASS: active input, four slots, focus, drift, disconnect, production maps and all prompt families");
}
