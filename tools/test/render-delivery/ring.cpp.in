// Mock only GL completion. The allocator body is extracted from the delivery.
#include <cassert>
#include <cstdint>
#include <cstring>
#include <iostream>
#include <string>
#include <vector>
using GLsync = void *;
using GLenum = unsigned;
using GLsizeiptr = intptr_t;
constexpr unsigned kTimeoutExpired = 1, kAlreadySignaled = 2, kConditionSatisfied = 3;
constexpr unsigned kSyncFlushCommandsBit = 1, kSyncGpuCommandsComplete = 2, kArrayBuffer = 3;
unsigned submitted = 0, completed = 0, fences = 0, deletes = 0, finishes = 0;
unsigned waitResult = kConditionSatisfied;
bool nullFence = false;
struct Api {
    GLsync FenceSync(unsigned, unsigned) const {
        ++fences;
        return nullFence ? nullptr : reinterpret_cast<void *>(uintptr_t(submitted));
    }
    unsigned ClientWaitSync(GLsync fence, unsigned, uint64_t) const {
        if (waitResult == kAlreadySignaled || waitResult == kConditionSatisfied)
            completed = static_cast<unsigned>(reinterpret_cast<uintptr_t>(fence));
        return waitResult;
    }
    void DeleteSync(GLsync fence) const { assert(fence); ++deletes; }
    void Finish() const { completed = submitted; ++finishes; }
    void BindBuffer(unsigned, unsigned) const {}
    void BufferSubData(unsigned, unsigned, GLsizeiptr, const void *) const {}
};
const Api &gl() { static Api api; return api; }
struct Ring {
    static constexpr uint32_t kVertexRingBytes = 256;
    uint32_t vertexRingOffset = 0, vbo = 1;
    uint8_t storage[kVertexRingBytes]{};
    uint8_t *vertexRingMap = storage;
    GLsync vertexFence = nullptr; // Present only in the original implementation.
@IMPLEMENTATION@
};
int main(int argc, char **argv) {
    assert(argc == 2);
    const std::string mode = argv[1];
    if (mode == "timeout") waitResult = kTimeoutExpired;
    if (mode == "failed") waitResult = 99;
    if (mode == "null") nullFence = true;
    if (mode == "already") waitResult = kAlreadySignaled;
    Ring ring;
    uint8_t bytes[128]{};
    assert(ring.ringAppend(bytes, 128) == 0);
    ++submitted;
    assert(ring.ringAppend(bytes, 128) == 128);
    ++submitted;
    assert(fences == 0 && finishes == 0);
    if (mode == "nowrap") {
        std::cout << "PASS: no synchronization before wrap\n";
        return 0;
    }
    for (unsigned wrap = 0; wrap < 3; ++wrap) {
        const auto required = submitted;
        assert(ring.ringAppend(bytes, 128) == 0);
        // Completion must cover draws submitted before THIS reuse, not a previous wrap.
        assert(completed >= required && "mapped range overwritten before GPU completion");
        ++submitted;
        assert(ring.ringAppend(bytes, 128) == 128);
        ++submitted;
    }
    assert(deletes == (nullFence ? 0 : fences));
    std::cout << "PASS: three wraps, current GPU generation complete, mode=" << mode << '\n';
}
