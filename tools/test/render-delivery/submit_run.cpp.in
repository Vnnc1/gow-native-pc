// Compile the delivered implementation, not a rewritten model of its encoder.
#include "runtime/gs/gs_types.h"
#include <algorithm>
#include <array>
#include <cassert>
#include <cstring>
#include <iostream>
#include <mutex>
#include <xmmintrin.h>

struct GsInventory {
    static GsInventory &get() { static GsInventory instance; return instance; }
    bool enabled() const { return false; }
    void draw(const GSPrimitiveBatch &) {}
};
unsigned g_gsRunOverflows = 0;
void reportRunAnomaly(const char *) {}
constexpr size_t kPublishBytes = 1024 * 1024;
enum class Op : uint8_t { Mxcsr, DrawState, Run };
struct GSThreadedBackend {
    bool m_compactQueue = true, m_drawStateValid = false;
    uint32_t m_lastMxcsr = 0;
    GSDrawState m_lastDrawState{};
    std::mutex m_producerMutex;
    std::vector<uint8_t> m_open;
    std::vector<GSPrimitiveBatch> reference;
    void Submit(const GSPrimitiveBatch &batch) { reference.push_back(batch); }
    void PublishLocked() { assert(false && "test unexpectedly hit publication threshold"); }
    void SubmitRun(const GSDrawState &, const GSVertex *, const uint8_t *, uint32_t);
};
@IMPLEMENTATION@

bool equal(const GSVertex &a, const GSVertex &b) {
    return a.x == b.x && a.y == b.y && a.z == b.z && a.r == b.r && a.g == b.g &&
        a.b == b.b && a.a == b.a && a.q == b.q && a.s == b.s && a.t == b.t &&
        a.u == b.u && a.v == b.v && a.fog == b.fog;
}
template<class T> T read(const std::vector<uint8_t> &bytes, size_t at) {
    assert(at + sizeof(T) <= bytes.size());
    T value;
    std::memcpy(&value, bytes.data() + at, sizeof(T));
    return value;
}
int main(int argc, char **argv) {
    assert(argc == 2);
    unsigned mode = static_cast<unsigned>(std::stoul(argv[1]));
    const unsigned total = mode == 255 ? 129 : 1;
    std::vector<uint8_t> counts(total, static_cast<uint8_t>(mode));
    std::vector<GSVertex> vertices(total * 3);
    if (total > 1)
        for (unsigned i = 0; i < total; ++i) counts[i] = static_cast<uint8_t>(i % 5);
    for (unsigned i = 0; i < vertices.size(); ++i) {
        auto &v = vertices[i];
        v.x = float(i + 1); v.y = -float(i + 2); v.z = double(i + 3);
        v.q = 3; v.s = 4; v.t = 5; v.r = 6; v.g = 7; v.b = 8;
        v.a = 9; v.u = 10; v.v = 11; v.fog = 12;
    }
    GSThreadedBackend compact, classic;
    classic.m_compactQueue = false;
    GSDrawState state{};
    state.prim.type = GS_PRIM_POINT;
    classic.SubmitRun(state, vertices.data(), counts.data(), total);
    compact.SubmitRun(state, vertices.data(), counts.data(), total);
    size_t at = 0, primitive = 0, records = 0;
    while (at < compact.m_open.size()) {
        const auto op = static_cast<Op>(compact.m_open[at]);
        const uint32_t size = read<uint32_t>(compact.m_open, at + 1);
        at += 5;
        assert(at + size <= compact.m_open.size());
        if (op == Op::Run) {
            const uint32_t n = read<uint32_t>(compact.m_open, at);
            assert(n && n <= kGsRunMaxPrims);
            assert(size == 4 + n + n * 3 * sizeof(GSVertex));
            for (unsigned i = 0; i < n; ++i) {
                const auto &ref = classic.reference.at(primitive++);
                assert(std::min<unsigned>(compact.m_open[at + 4 + i], 3) == ref.vertexCount);
                for (unsigned v = 0; v < 3; ++v) {
                    const auto got = read<GSVertex>(compact.m_open, at + 4 + n + (i * 3 + v) * sizeof(GSVertex));
                    assert(equal(got, ref.vertices[v]));
                }
            }
            ++records;
        }
        at += size;
    }
    assert(primitive == total);
    assert(records == (total + 63) / 64);
    std::cout << "PASS: compact/classic vertex fields, count=" << total << " mode=" << mode << '\n';
}
