#include <algorithm>
#include <cassert>
#include <cmath>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <vector>
#include "runtime/gow_logic_present.h"

struct R5900Context { uint32_t pc = 0, cop0_status = 0x10000, gpr[32]{}; };
#define GPR_U32(ctx, n) ((ctx)->gpr[n])
struct Yield {};
struct EeScheduler {
    static constexpr uint64_t kEeClockHz = 294912000;
    uint64_t delayed = 0;
    uint64_t eeCycle = 100;
    uint64_t currentEeCycle() const { return eeCycle; }
    [[noreturn]] void delayCurrent(uint64_t cycles) { delayed = cycles; throw Yield{}; }
};
struct PS2Runtime {
    EeScheduler scheduler;
    std::vector<uint32_t> installed;
    auto &eeScheduler() { return scheduler; }
    bool replaceFunction(uint32_t pc, void (*)(uint8_t *, R5900Context *, PS2Runtime *)) {
        installed.push_back(pc); return true;
    }
};
uint32_t readGuest32(const uint8_t *p, uint32_t a) { uint32_t v; std::memcpy(&v, p+a, 4); return v; }
void writeGuest32(uint8_t *p, uint32_t a, uint32_t v) { std::memcpy(p+a, &v, 4); }
void putFloat(uint8_t *p, uint32_t a, float v) { std::memcpy(p+a, &v, 4); }
int originalWaits = 0, originalSteps = 0;
bool incomplete = false;
void sub_0017D778_0x17d778(uint8_t *p, R5900Context *c, PS2Runtime *) {
    ++originalSteps;
    putFloat(p, 0x29C64C, 1.0f/60);
    putFloat(p, 0x29C658, 1.0f/120);
    writeGuest32(p, 0x29C660, 0); // original consumes the one-shot fixed flag
    c->pc = incomplete ? 0x17D800 : c->gpr[31];
}
void sub_0017A1D0_0x17a1d0(uint8_t *, R5900Context *c, PS2Runtime *) {
    ++originalWaits; c->pc = c->gpr[31];
}
@PRODUCTION@

int main() {
    assert(gowParseLogicFps(nullptr) == 60 && gowParseLogicFps("") == 60);
    for (const char *v : {"0", "-120", "121", "120junk", " 120", "999999999999"})
        assert(gowParseLogicFps(v) == 60);
    assert(gowParseLogicFps("60") == 60 && gowParseLogicFps("120") == 120 && gowParseLogicFps("240") == 240);
    std::vector<uint8_t> ram(0x340000);
    uint8_t *p = ram.data();
    PS2Runtime rt;
    R5900Context ctx;
    auto setup = [&] {
        std::fill(ram.begin(), ram.end(), 0);
        writeGuest32(p, 0x29C65C, 1); writeGuest32(p, 0x29C654, 1);
        putFloat(p, 0x29C644, 1); putFloat(p, 0x29C648, 0.5f);
        ctx.pc = 0x17D778; ctx.gpr[31] = 0x1234; ctx.cop0_status = 0x10000;
        incomplete = false; g_logicNextSlot = 0;
    };
    unsigned cases = 0;
    for (int fps : {60, 120, 240}) for (uint32_t ticks : {0u, 2402u, 4805u, 9610u, 19220u, 100000u}) {
        setup(); g_logicFps = fps; writeGuest32(p, 0x29C670, ticks);
        gowLogicTimeStep(p, &ctx, &rt);
        const float expected = fps == 60 ? 1.0f/60 : std::clamp(ticks / 576600.0f, 1.0f/fps, 4.0f/60);
        assert(std::abs(gowLogicFloat(p, 0x29C64C) - expected) < 1e-7);
        assert(std::abs(gowLogicFloat(p, 0x29C658) - expected*0.5f) < 1e-7);
        assert(readGuest32(p, 0x29C654) == 1 && ctx.pc == ctx.gpr[31]); ++cases;
    }
    // Movies, fixed steps, one-shot fixed step, 30 fps floor, incomplete and resumed calls.
    for (int which = 0; which < 8; ++which) {
        setup(); g_logicFps = 120;
        if (which == 0) writeGuest32(p, 0x29C65C, 0);
        if (which == 1) writeGuest32(p, 0x29C660, 1);
        if (which == 2) writeGuest32(p, 0x29C654, 2);
        if (which == 3) writeGuest32(p, 0x29C838, 3);
        if (which == 4) writeGuest32(p, 0x29C838, 11);
        if (which == 5) incomplete = true;
        if (which == 6) ctx.pc = 0x17D800;
        if (which == 7) g_logicFps = 60;
        gowLogicTimeStep(p, &ctx, &rt);
        assert(gowLogicFloat(p, 0x29C64C) == 1.0f/60); ++cases;
    }
    setup(); g_logicFps = 120; writeGuest32(p, 0x331078, 3); writeGuest32(p, 0x29C670, 11520);
    gowLogicTimeStep(p, &ctx, &rt);
    assert(std::abs(gowLogicFloat(p, 0x29C64C) - 1.0f/60) < 1e-7);
    for (int fps : {120, 240}) {
        setup(); g_logicFps = fps; ctx.pc = 0x17A1D0; ctx.gpr[31] = 0x17A36C;
        rt.scheduler.eeCycle = 100; const uint64_t period = EeScheduler::kEeClockHz / fps;
        writeGuest32(p, 0x29C7D4, 10);
        const int before = originalWaits;
        gowLogicFrameWait(p, &ctx, &rt);
        assert(g_logicNextSlot == 100+period && readGuest32(p, 0x29C7D4) == 0);
        ctx.pc = 0x17A1D0; rt.scheduler.eeCycle = 110;
        bool yielded = false;
        try { gowLogicFrameWait(p, &ctx, &rt); } catch (Yield) { yielded = true; }
        assert(yielded && rt.scheduler.delayed == period-10 && ctx.pc == 0x17A36C);
        ctx.pc = 0x17A1D0; rt.scheduler.eeCycle = 100+10*period;
        gowLogicFrameWait(p, &ctx, &rt);
        assert(g_logicNextSlot == rt.scheduler.eeCycle+period && originalWaits == before); cases += 3;
    }
    for (int which = 0; which < 8; ++which) {
        setup(); g_logicFps = 120; ctx.pc = 0x17A1D0; ctx.gpr[31] = 0x17A36C;
        g_logicNextSlot = 1000;
        if (which == 0) ctx.gpr[31] = 0x8888;
        if (which == 1) ctx.pc = 0x17A200;
        if (which == 2) ctx.cop0_status = 0;
        if (which == 3) writeGuest32(p, 0x29C65C, 0);
        if (which == 4) writeGuest32(p, 0x29C660, 1);
        if (which == 5) writeGuest32(p, 0x29C654, 2);
        if (which == 6) writeGuest32(p, 0x29C838, 10);
        if (which == 7) g_logicFps = 60;
        int before = originalWaits;
        gowLogicFrameWait(p, &ctx, &rt);
        assert(originalWaits == before+1);
        assert(g_logicNextSlot == (which < 2 ? 1000u : 0u)); ++cases;
    }
    // zzz-328 test-only fixed step: every measured gameplay frame is exactly 1/60 s, whatever the elapsed fields.
    for (uint32_t ticks : {0u, 2402u, 4805u, 9610u, 19220u, 100000u}) {
        setup(); g_logicFps = 60; g_logicFixedStep = true; writeGuest32(p, 0x29C670, ticks);
        gowLogicTimeStep(p, &ctx, &rt);
        assert(std::abs(gowLogicFloat(p, 0x29C64C) - 1.0f/60) < 1e-7);
        assert(std::abs(gowLogicFloat(p, 0x29C658) - 0.5f/60) < 1e-7 && ctx.pc == ctx.gpr[31]); ++cases;
    }
    // Movies, game fixed steps, one-shot steps and incomplete/resumed calls keep the original result.
    for (int which = 0; which < 6; ++which) {
        setup(); g_logicFps = 60; g_logicFixedStep = true; writeGuest32(p, 0x29C670, 19220);
        if (which == 0) writeGuest32(p, 0x29C65C, 0);
        if (which == 1) writeGuest32(p, 0x29C660, 1);
        if (which == 2) writeGuest32(p, 0x29C654, 2);
        if (which == 3) writeGuest32(p, 0x29C838, 5);
        if (which == 4) incomplete = true;
        if (which == 5) ctx.pc = 0x17D800;
        gowLogicTimeStep(p, &ctx, &rt);
        assert(gowLogicFloat(p, 0x29C658) == 1.0f/120); ++cases;
    }
    g_logicFixedStep = false;
    // Registration: only with GOW_PAD_TEST=1, never together with the experimental rate.
    auto install = [&](const char *pad, const char *fixed, const char *fps) {
        _putenv_s("GOW_PAD_TEST", pad); _putenv_s("GOW_TEST_FIXED_STEP", fixed); _putenv_s("GOW_EXPERIMENTAL_LOGIC_FPS", fps);
        rt.installed.clear(); gowInstallLogicRate(rt);
    };
    install("1", "1", ""); assert(g_logicFixedStep && rt.installed == std::vector<uint32_t>({0x17D778}));
    install("", "1", ""); assert(!g_logicFixedStep && rt.installed.empty());
    install("1", "0", ""); assert(!g_logicFixedStep && rt.installed.empty());
    install("1", "1", "120"); assert(!g_logicFixedStep && rt.installed == std::vector<uint32_t>({0x17D778, 0x17A1D0}));
    install("", "", ""); rt.installed.clear(); cases += 4;
    _putenv_s("GOW_EXPERIMENTAL_LOGIC_FPS", "");
    gowInstallLogicRate(rt); assert(rt.installed.empty() && g_logicFps == 60);
    gow_logic_present::noteFlip(); assert(gow_logic_present::token(7) == 7);
    _putenv_s("GOW_EXPERIMENTAL_LOGIC_FPS", "120");
    gowInstallLogicRate(rt); assert(rt.installed == std::vector<uint32_t>({0x17D778, 0x17A1D0}));
    assert(gow_logic_present::token(7) == 0);
    gow_logic_present::noteFlip(); assert(gow_logic_present::token(7) == 1);
    gow_logic_present::noteFlip(); assert(gow_logic_present::token(7) == 2);
    std::printf("logic-rate: %u timestep/pacing cases, parser and opt-in registration passed\n", cases+1);
}
