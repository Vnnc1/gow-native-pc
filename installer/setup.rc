// Embed the manifest explicitly for llvm-rc, including per-monitor DPI and asInvoker.
#include <windows.h>

1 RT_MANIFEST "setup.manifest"

1 ICON "../launcher/icon.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION GOW_VERSION_MAJOR,GOW_VERSION_MINOR,GOW_VERSION_PATCH,0
PRODUCTVERSION GOW_VERSION_MAJOR,GOW_VERSION_MINOR,GOW_VERSION_PATCH,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "God of War Native PC Setup"
            VALUE "ProductName", "God of War Native PC"
            VALUE "CompanyName", "gow-native-pc"
            VALUE "FileVersion", GOW_VERSION
            VALUE "ProductVersion", GOW_VERSION
            VALUE "OriginalFilename", "gow-native-pc-setup.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
