+    // TEXSTUDY (temporary): PCSX2-format texture names and replacements.
+    // The name PCSX2 gives a texture's dump / replacement (GSTextureCache::HashCacheKey + GSTextureReplacements):
+    // "<tex hash>-<palette hash>-<bits>" (paletted) or "<tex hash>-<bits>", where tex hash = XXH3-64 of the texture's GS
+    // memory blocks in block-row order, palette hash = XXH3-64 of its 16 / 256 32-bit entries, bits = PSM | TW << 6 |
+    // TH << 10 (| TEXA for 16/24-bit colour). Only PCSX2's direct path (at least one block in each axis, no partial-format
+    // mask, no region); false for the others. The texture hash is kept in `tex` until the texture is decoded again.
+    bool pcsx2Key(const GSDrawState &s, Texture &tex, char (&name)[64])
+    {
+        const GSTex0Reg &t = s.context.tex0;
+        uint32_t bx = 0, by = 0;
+        bool fullMask = true;
+        switch (t.psm)
+        {
+        case 0x00: case 0x30: bx = 8; by = 8; break;                               // CT32, Z32
+        case 0x01: case 0x31: bx = 8; by = 8; fullMask = false; break;              // CT24, Z24
+        case 0x02: case 0x0A: case 0x32: case 0x3A: bx = 16; by = 8; break;         // CT16, CT16S, Z16, Z16S
+        case GS_PSM_T8: bx = 16; by = 16; break;
+        case GS_PSM_T4: bx = 32; by = 16; break;
+        default: bx = 8; by = 8; fullMask = false; break;                          // T8H, T4HL, T4HH
+        }
+        const uint32_t tw = 1u << std::min<uint32_t>(t.tw, 10u), th = 1u << std::min<uint32_t>(t.th, 10u);
+        if (!fullMask || tw < bx || th < by)
+            return false;
+        if (!tex.pcsx2Hashed)
+        {
+            const GSSwizzle::Format &f = GSSwizzle::GetFormat(t.psm);
+            XXH3_state_t state;
+            XXH3_64bits_reset(&state);
+            for (uint32_t y = 0; y < th; y += by)
