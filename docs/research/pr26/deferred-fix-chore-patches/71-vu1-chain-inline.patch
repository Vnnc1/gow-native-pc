Opt-in JIT chain adapter inlining: GOW_VU1X_CHAIN_INLINE=1, default off.
Choose the call target during block compilation, with no per-execution mode branch.
Reuse the unchanged chain implementation and AOT/DLL ABI; no arithmetic or cycle changes.
The first laptop experiment improved isolated VU1 cost but had a p99 outlier.
Final same-binary replay measured -0.39%, within observed run variation.
Keep the reference default until repeated frame tails and audio pass acceptance.

--- a/PS2Recomp/ps2xRuntime/src/lib/vu/ps2_vu1_x64.inl
+++ b/PS2Recomp/ps2xRuntime/src/lib/vu/ps2_vu1_x64.inl
@@ -53,6 +53,8 @@
 #include <unordered_map>
 #include <unordered_set>
 #include <vector>
+
+static VU1NativeFn vu1ChainInline(VU1NativeCtx &n, uint32_t next);
 
 namespace vu1x
 {
@@ -2344,7 +2346,15 @@
             // r13d = next pc; the next block's code when chain() allows it, as a tail jump
             a.movRR(kArg0, RBX);
             a.movRR32(kArg1, R13);
-            a.call(reinterpret_cast<const void *>(&VU1NativeAccess::chainFn));
+            // Select once while compiling blocks, never branch on this option at runtime.
+            static const bool inlineChain = [] {
+                const char *value = std::getenv("GOW_VU1X_CHAIN_INLINE");
+                const bool enabled = value && std::strcmp(value, "1") == 0;
+                std::fprintf(stderr, "[vu1-chain] inline=%u\n", enabled ? 1u : 0u);
+                return enabled;
+            }();
+            a.call(inlineChain ? reinterpret_cast<const void *>(&vu1ChainInline) :
+                                reinterpret_cast<const void *>(&VU1NativeAccess::chainFn));
             a.testRaxRax();
             const size_t noChain = a.jcc(CC_Z);
             // Same block: chainFn has completed exit/entry bookkeeping once. Reuse the frame and jump to its body.
@@ -2520,6 +2530,17 @@
     static_assert(VU1Interpreter::kFmacLatency == vu1x::kFlat, "vu1x::kFlat must follow the flag latency");
     VU1Interpreter::NativeState::Slot *sl = chain(n, next);
     return sl ? sl->fn : nullptr;
+}
+
+// Same bookkeeping and ABI as chainFn; Clang folds only this opt-in call site.
+static VU1NativeFn vu1ChainInline(VU1NativeCtx &n, uint32_t next)
+{
+    decltype(VU1NativeAccess::chain(n, next)) slot = nullptr;
+#if defined(__clang__)
+    [[clang::always_inline]]
+#endif
+    slot = VU1NativeAccess::chain(n, next);
+    return slot ? slot->fn : nullptr;
 }
 
