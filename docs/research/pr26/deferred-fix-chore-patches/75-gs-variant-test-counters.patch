 }
-GSHwBackend::~GSHwBackend() = default;
+GSHwBackend::~GSHwBackend()
+{
+    // Test-only counters since the last stats flush; no extra hot-path timing.
+    const char *diag = std::getenv("GOW_GS_VARIANT_DIAG");
+    if (diag && diag[0] == '1')
