--- /dev/null
+++ b/PS2Recomp/ps2xRuntime/src/lib/gs/gpu/gs_alpha_bounds.h
@@ -0,0 +1,22 @@
+#pragma once
+#include <cstdint>
+
+struct GSAlphaBoundsResult { bool allPass, allFail; };
+
+// Inclusive integer alpha interval. An unknown/invalid interval must not remove a pass.
+constexpr GSAlphaBoundsResult gsAlphaBounds(uint32_t test, uint32_t ref, uint32_t low, uint32_t high)
+{
+    if (low > high || high > 255 || ref > 255) return {false, false};
+    switch (test)
+    {
+    case 0: return {false, true};
+    case 1: return {true, false};
+    case 2: return {high < ref, low >= ref};
+    case 3: return {high <= ref, low > ref};
+    case 4: return {low == ref && high == ref, ref < low || ref > high};
+    case 5: return {low >= ref, high < ref};
+    case 6: return {low > ref, high <= ref};
+    case 7: return {ref < low || ref > high, low == ref && high == ref};
+    default: return {false, false};
+    }
+}
