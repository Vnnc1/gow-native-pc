--- /dev/null
+++ b/PS2Recomp/ps2xRuntime/src/lib/gs/gpu/gs_alpha_pass.h
@@ -0,0 +1,19 @@
+#pragma once
+
+#include <cstdint>
+
+struct GSAlphaPassPlan
+{
+    bool passing;
+    bool failing;
+};
+
+// Only the constant NEVER/ALWAYS predicates are folded. Texture alpha, DATE,
+// depth, framebuffer masks and the relative order of surviving draws stay intact.
+// forceNoTest affects the first pass only, matching the existing debug path.
+constexpr GSAlphaPassPlan gsAlphaPassPlan(bool ate, uint32_t atst, uint32_t afail,
+                                        bool forceNoTest, bool noFailPass, bool prune)
+{
+    return {!(prune && ate && !forceNoTest && atst == 0u),
+            ate && afail != 0u && !noFailPass && !(prune && atst == 1u)};
+}
