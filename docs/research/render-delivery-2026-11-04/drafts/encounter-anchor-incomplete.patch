+// Optional test-frame origin at a profile-supplied encounter position. Observation
+// only: never writes guest state or changes physics, clocks, RNG or enemy behavior.
+struct PositionAnchor {
+    bool enabled = false, valid = false;
+    float position[3] = {}, tolerance = 0;
+    unsigned long long minimumFrame = 0;
+    explicit PositionAnchor(const char *text) {
+        enabled = text && *text;
+        if (!enabled) return;
+        char extra = 0;
+        valid = std::sscanf(text, "%f,%f,%f,%f,%llu%c", &position[0], &position[1], &position[2],
+                            &tolerance, &minimumFrame, &extra) == 5 &&
+                std::isfinite(tolerance) && tolerance > 0 && minimumFrame <= 1000000;
+        for (float x : position) valid = valid && std::isfinite(x);
+    }
+    bool matches(uint64_t frame, uint32_t state, uint32_t pending, uint32_t movie, const float *at) const {
+        if (!valid || frame < minimumFrame || state != 11 || pending || movie) return false;
+        for (unsigned i = 0; i < 3; ++i)
+            if (!std::isfinite(at[i]) || std::abs(at[i] - position[i]) > tolerance) return false;
+        return true;
+    }
+};
