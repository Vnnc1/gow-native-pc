+#pragma once
+// Named Flash gestures only: never infer a requested input from a decorative circle.
+#include <array>
+#include <cmath>
+#include <chrono>
+#include <cstdint>
+#include <cstring>
+#include <mutex>
+namespace gow_qte_prompt {
+struct Sequence { std::array<unsigned,5> keys{}; unsigned count=0; };
+// Indices are up/right/down/left in the displayed game view. The USA full/half
+// arrows share meshes with mirrored/rotated matrices; names alone cannot give screen direction.
+inline Sequence sequence(const char *name,float m0=1,float m1=0,float m4=0,float m5=1) {
+    if (!name) return {};
+    const float det=m0*m5-m1*m4;
+    if (!std::isfinite(det) || std::fabs(det)<0.000001f) return {};
+    if (!std::strcmp(name,"360CW") || !std::strcmp(name,"360CCW"))
+        return det>0 ? Sequence{{0,1,2,3,0},5} : Sequence{{0,3,2,1,0},5};
+    if (std::strcmp(name,"Up180CW") && std::strcmp(name,"Up180CCW") &&
+        std::strcmp(name,"Down180CW") && std::strcmp(name,"Down180CCW")) return {};
+    // Verified shared half-arrow geometry runs +X -> +Y -> -X before its Flash matrix.
+    const float xs[]={m0,m4,-m0}, ys[]={m1,m5,-m1};
+    Sequence result;result.count=3;
+    for(unsigned i=0;i<3;++i) {
+        if (!std::isfinite(xs[i]) || !std::isfinite(ys[i])) return {};
+        result.keys[i] = std::fabs(xs[i])>std::fabs(ys[i]) ? (xs[i]>0?1:3) : (ys[i]>0?0:2);
+    }
+    return result;
+}
+struct AutoButtons {
+    uint16_t previous=0;
+    double started=0;
+    uint16_t apply(uint16_t buttons,uint16_t requested,double age,double now,bool enabled,bool focused) {
+        // Only one recognized face/shoulder prompt. Empty/stale/conflicting batches fail closed.
+        if (requested & ~0xf300u) requested = 0;
+        if (!enabled || !focused || age<0 || age>0.25 || !requested || (requested&(requested-1))) {
+            previous=0; return buttons;
+        }
+        if (requested!=previous || now<started) { previous=requested;started=now; }
+        const auto phase=static_cast<uint64_t>((now-started)*1000.0)%120u;
+        return phase<60 ? uint16_t(buttons&~requested) : uint16_t(buttons|requested);
+    }
+};
+inline std::mutex mutex;
+inline uint16_t buttons=0;
+inline std::chrono::steady_clock::time_point published{};
+inline void publish(uint16_t value) {
+    std::lock_guard<std::mutex> lock(mutex);buttons=value;published=std::chrono::steady_clock::now();
+}
+inline uint16_t apply(uint16_t input,bool enabled,bool focused) {
+    static AutoButtons assist;
+    std::lock_guard<std::mutex> lock(mutex);
+    const auto now=std::chrono::steady_clock::now();
+    return assist.apply(input,buttons,std::chrono::duration<double>(now-published).count(),
+                        std::chrono::duration<double>(now.time_since_epoch()).count(),enabled,focused);
+}
