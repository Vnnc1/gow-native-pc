+// gow-native-pc (patch 65): GOW_VU1_OPSTAT=1, every 5 s: the dynamic opcode mix of each program (per-pair counts; the
+// pair totals must match patch 63's [vu1-hot] pairs for the same entry). Percentages are of that program's pairs.
+static void vu1OpstatReport()
+{
+    if (!vu1op::enabled())
+        return;
+    static auto last = std::chrono::steady_clock::now();
+    const auto now = std::chrono::steady_clock::now();
+    if (now - last < std::chrono::seconds(5))
+        return;
+    const double wall = std::chrono::duration<double>(now - last).count();
+    last = now;
+    static vu1op::Bucket prev[2048];
+    struct Row { unsigned long long pc, pairs, runs, blocks, tail; vu1op::Bucket d; };
+    static Row rows[2048];
+    size_t count = 0u;
+    unsigned long long totalPairs = 0u;
+    for (size_t i = 0; i < 2048u; ++i)
+    {
+        const vu1op::Bucket &c = vu1op::bucket[i];
+        const vu1op::Bucket &p = prev[i];
+        if (c.pairs == p.pairs && c.runs == p.runs)
+            continue;
+        Row &r = rows[count++];
+        r.pc = i * 8u;
+        r.pairs = c.pairs - p.pairs;
+        r.runs = c.runs - p.runs;
+        r.blocks = c.blocks - p.blocks;
+        r.tail = c.tailBlocks - p.tailBlocks;
+        for (uint32_t k = 0; k < vu1op::kUCount; ++k)
+            r.d.up[k] = c.up[k] - p.up[k];
+        for (uint32_t k = 0; k < vu1op::kLCount; ++k)
+            r.d.lo[k] = c.lo[k] - p.lo[k];
+        r.d.flagWriters = c.flagWriters - p.flagWriters;
+        r.d.statusOps = c.statusOps - p.statusOps;
+        r.d.brStatic = c.brStatic - p.brStatic;
+        r.d.brDyn = c.brDyn - p.brDyn;
+        r.d.brCond = c.brCond - p.brCond;
+        r.d.waitQP = c.waitQP - p.waitQP;
+        r.d.accOps = c.accOps - p.accOps;
+        r.d.nopUpper = c.nopUpper - p.nopUpper;
+        totalPairs += r.pairs;
+        prev[i] = c;
+    }
+    std::sort(rows, rows + count, [](const Row &a, const Row &b) { return a.pairs > b.pairs; });
+    std::fprintf(stderr, "[vu1-op] total_pairs=%.2fM wall=%.2fs", static_cast<double>(totalPairs) * 1e-6, wall);
+    for (size_t i = 0; i < count && i < 6u; ++i)
+    {
+        const Row &r = rows[i];
+        const vu1op::Bucket &d = r.d;
+        const double n = r.pairs ? static_cast<double>(r.pairs) : 1.0;
+        std::fprintf(stderr,
+                     " | pc=%x pairs=%.2fM runs=%.0f/s blk=%.1f/n"
+                     " U[fmac %.1f acc %.1f spec %.1f nop %.1f oth %.1f]"
+                     " L[mem %.1f ialu %.1f br %.1f fdiv %.1f efu %.1f xgk %.1f nop %.1f oth %.1f]"
+                     " flagw %.1f stat %.1f waitqp %.1f accr %.1f nopU %.1f tail %.1f"
+                     " br[st %.1f dyn %.1f cond %.1f]",
+                     static_cast<unsigned>(r.pc), static_cast<double>(r.pairs) * 1e-6,
+                     static_cast<double>(r.runs) / wall,
+                     r.runs ? static_cast<double>(r.blocks) / static_cast<double>(r.runs) : 0.0,
+                     d.up[vu1op::kUFmac] * 100.0 / n, d.up[vu1op::kUFmacAcc] * 100.0 / n,
+                     d.up[vu1op::kUSpecial] * 100.0 / n, d.up[vu1op::kUNone] * 100.0 / n,
+                     d.up[vu1op::kUOther] * 100.0 / n,
+                     d.lo[vu1op::kLMem] * 100.0 / n, d.lo[vu1op::kLIalu] * 100.0 / n,
+                     d.lo[vu1op::kLBranch] * 100.0 / n, d.lo[vu1op::kLFdiv] * 100.0 / n,
+                     d.lo[vu1op::kLEfu] * 100.0 / n, d.lo[vu1op::kLXgkick] * 100.0 / n,
+                     d.lo[vu1op::kLNone] * 100.0 / n, d.lo[vu1op::kLOther] * 100.0 / n,
+                     d.flagWriters * 100.0 / n, d.statusOps * 100.0 / n, d.waitQP * 100.0 / n,
+                     d.accOps * 100.0 / n, d.nopUpper * 100.0 / n,
+                     r.blocks ? static_cast<double>(r.tail) / static_cast<double>(r.blocks) : 0.0,
+                     d.brStatic * 100.0 / n, d.brDyn * 100.0 / n, d.brCond * 100.0 / n);
+    }
+    std::fprintf(stderr, "\n");
+}
