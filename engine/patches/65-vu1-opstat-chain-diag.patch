+// gow-native-pc (patch 65): the opcode mix of a block, from the exact engine's decoder (so the categories mean the same
+// thing the interpreter does). Called once per slot setup, only while GOW_VU1_OPSTAT is on.
+void VU1NativeAccess::opstatClassify(VU1Interpreter &vu, const uint8_t *code, uint32_t pc, uint32_t count, vu1op::Cats &out)
+{
+    out = {};
+    for (uint32_t i = 0; i < count; ++i)
+    {
+        const VU1Interpreter::DecodedInstructionPair d = vu.decodeInstructionPair(code, pc + i * 8u);
+        ++out.pairs;
+        if (d.upperNop)
+            ++out.up[vu1op::kUNone], ++out.nopUpper;
+        else if (d.iBit)
+            ++out.up[vu1op::kUOther];
+        else
+        {
+            const uint32_t op = d.upper & 0x3Fu;
+            uint32_t cat = vu1op::kUFmac;
+            if (op <= 0x2Fu)
+            {
+                // the ACC variants of ADD/SUB/MADD/MSUB/MUL write ACC instead of the destination register
+                if (d.upperUsage.accWrite != 0u)
+                    cat = vu1op::kUFmacAcc;
+                if (op <= 0x0Fu)
+                    ++out.flagWriters; // ADD / SUB / MADD / MSUB also update the MAC flags
+            }
+            else
+            {
+                const uint32_t special = (d.upper & 3u) | ((d.upper >> 4) & 0x7Cu);
+                if ((special >= 0x10u && special <= 0x17u) || special == 0x1Du || special == 0x1Fu)
+                    cat = vu1op::kUSpecial; // ITOF / FTOI / ABS / CLIP
+                else if (d.upperUsage.accWrite != 0u)
+                    cat = vu1op::kUFmacAcc;
+                if (special <= 0x0Fu || (special >= 0x18u && special <= 0x1Cu) || special == 0x1Eu)
+                    ++out.flagWriters;
+            }
+            ++out.up[cat];
+            if (d.upperUsage.accRead != 0u || d.upperUsage.accWrite != 0u)
+                ++out.accOps;
+        }
+        if (d.iBit)
+        {
+            ++out.lo[vu1op::kLOther]; // no lower op is issued with an illegal upper
+            continue;
+        }
+        const VU1Interpreter::InstructionUsage &lu = d.lowerUsage;
+        uint32_t lcat = vu1op::kLOther;
+        switch (lu.pipeline)
+        {
