+// gow-native-pc (patch 65): GOW_VU1_OPSTAT=1, the dynamic opcode mix of each program (bucket = the run's entry PC, as in
+// patch 63). A block's pairs are classified once at slot setup with the exact engine's decoder; every execution adds that
+// block's static counts, so the sums are exact pair counts (they must equal patch 63's `pairs` for the same entry), not a
+// sample. Zero while unset (one branch per block / per run).
+namespace vu1op
+{
+    enum : uint8_t
+    {
+        kUFmac, kUFmacAcc, kUSpecial, kUNone, kUOther, kUCount // upper: FMAC / FMAC writing ACC / ITOF-FTOI-ABS-CLIP / NOP / other
+    };
+    enum : uint8_t
+    {
+        kLMem, kLIalu, kLBranch, kLFdiv, kLEfu, kLXgkick, kLNone, kLOther, kLCount // lower, by the decoder's pipeline
+    };
+    struct Cats // one block, counts in uint8_t (a block is at most 64 pairs)
+    {
+        uint8_t up[kUCount] = {}, lo[kLCount] = {};
+        uint8_t pairs = 0, flagWriters = 0, statusOps = 0, waitQP = 0, accOps = 0, nopUpper = 0;
+        uint8_t brStatic = 0, brDyn = 0, brCond = 0; // B / BAL | JR / JALR | IBEQ..IBGEZ (successor static for the first two)
+    };
+    struct Bucket
+    {
+        unsigned long long up[kUCount] = {}, lo[kLCount] = {};
+        unsigned long long pairs = 0, blocks = 0, runs = 0, tailBlocks = 0;
+        unsigned long long flagWriters = 0, statusOps = 0, waitQP = 0, accOps = 0, nopUpper = 0;
+        unsigned long long brStatic = 0, brDyn = 0, brCond = 0;
+    };
+    inline Bucket bucket[2048];
+    inline bool enabled()
+    {
+        static const bool on = [] {
+            const char *v = std::getenv("GOW_VU1_OPSTAT");
+            return v && v[0] != '0';
+        }();
+        return on;
+    }
+    inline uint32_t &current() // bucket of the run being executed (VU1 runs on one worker thread)
+    {
+        static thread_local uint32_t at = 0u;
+        return at;
+    }
+    inline void account(uint32_t pc, const Cats &c, bool tail)
+    {
+        Bucket &b = bucket[current()];
+        for (uint32_t i = 0; i < kUCount; ++i)
+            b.up[i] += c.up[i];
+        for (uint32_t i = 0; i < kLCount; ++i)
+            b.lo[i] += c.lo[i];
+        b.pairs += c.pairs, b.flagWriters += c.flagWriters, b.statusOps += c.statusOps;
+        b.waitQP += c.waitQP, b.accOps += c.accOps, b.nopUpper += c.nopUpper;
+        b.brStatic += c.brStatic, b.brDyn += c.brDyn, b.brCond += c.brCond;
+        ++b.blocks;
+        b.tailBlocks += tail;
+    }
+}
