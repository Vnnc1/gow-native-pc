+    // Puts a batch's vertices in the ring and points binding 0 at them (one glBindVertexBuffer per batch).
+    void appendVertices(const std::vector<HwVertex> &verts)
+    {
+        const Api &g = gl();
+        const size_t bytes = verts.size() * sizeof(HwVertex);
+        g.BindVertexArray(vao);
+        if (!vertexRing)
+        {
+            g.BindBuffer(kArrayBuffer, vbo);
+            g.BufferData(kArrayBuffer, static_cast<GLsizeiptr>(bytes), verts.data(), kStreamDraw);
+            return;
+        }
+        const uint32_t need = static_cast<uint32_t>((bytes + 63u) & ~static_cast<size_t>(63u));
+        if (vertexRingOffset + need > kVertexRingBytes)
+        {
+            if (vertexFence)
+            {
+                if (g.ClientWaitSync(vertexFence, 0, 0) == kTimeoutExpired)
+                    g.ClientWaitSync(vertexFence, kSyncFlushCommandsBit, 1000000000ull);
+                g.DeleteSync(vertexFence);
+            }
+            vertexFence = g.FenceSync(kSyncGpuCommandsComplete, 0);
+            vertexRingOffset = 0;
+        }
+        if (vertexRingMap)
+            std::memcpy(vertexRingMap + vertexRingOffset, verts.data(), bytes);
+        else
+        {
+            g.BindBuffer(kArrayBuffer, vbo);
+            g.BufferSubData(kArrayBuffer, vertexRingOffset, static_cast<GLsizeiptr>(bytes), verts.data());
+        }
+        g.BindVertexBuffer(0, vbo, vertexRingOffset, sizeof(HwVertex));
+        vertexRingOffset += need;
+    }
