+        tc.Run("fast RDRAM classification covers kseg0 kseg1 uncached mirrors and boundary wraps", [](TestCase &t)
+        {
+            PS2Memory mem;
+            t.IsTrue(mem.initialize(), "initialize memory");
+            uint8_t *rdram = mem.getRDRAM();
+            for (const uint32_t base : {0x00000000u, 0x20000000u, 0x80000000u, 0xA0000000u})
+            {
+                t.IsFalse(PS2Runtime::isSpecialAddress(base + 0x00001000u), "RDRAM mirror start must take fast path");
+                t.IsFalse(PS2Runtime::isSpecialAddress(base + PS2_RAM_SIZE - 4u), "RDRAM mirror end must take fast path");
+            }
+            t.IsTrue(PS2Runtime::isSpecialAddress(0x70000000u), "scratchpad base must remain special");
+            t.IsTrue(PS2Runtime::isSpecialAddress(0x70003FF0u), "scratchpad end must remain special");
+            t.IsTrue(PS2Runtime::isSpecialAddress(0x10000000u), "MMIO base must remain special");
+            t.IsTrue(PS2Runtime::isSpecialAddress(0x12000000u), "GS privileged MMIO must remain special");
+            Ps2FastWrite32(rdram, 0x81FFFFFEu, 0xAABBCCDDu);
+            t.Equals(Ps2FastRead32(rdram, 0xA1FFFFFEu), 0xAABBCCDDu, "unaligned RDRAM end wrap must match across mirrors");
+            t.Equals(rdram[PS2_RAM_SIZE - 2u], uint8_t{0xDDu}, "low byte at end-2");
+            t.Equals(rdram[0], uint8_t{0xBBu}, "wrapped byte at offset 0");
