+            t.Equals(Ps2ExtractEpi32(qr, 0), 0x11223344, "128-bit masked fast write/read lane 0");
+            t.Equals(Ps2ExtractEpi32(qr, 3), static_cast<int32_t>(0xDDEEFF00u), "128-bit masked fast write/read lane 3");
