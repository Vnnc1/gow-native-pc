Inline RDRAM mirror classification; remove impossible 128-bit wrap branches.
Keep scratchpad/MMIO classification and scalar boundary wrapping. Add memory regressions.
No gameplay performance measurement is claimed by this patch.

diff --git a/PS2Recomp/ps2xRuntime/include/ps2_runtime.h b/PS2Recomp/ps2xRuntime/include/ps2_runtime.h
index 61b6da8..3749a9d 100644
--- a/PS2Recomp/ps2xRuntime/include/ps2_runtime.h
+++ b/PS2Recomp/ps2xRuntime/include/ps2_runtime.h
@@ -442,8 +442,10 @@ public:
 
     static PS2_FORCEINLINE bool isSpecialAddress(uint32_t addr)
     {
-        // main RAM (almost every access) inline, the rest of the check out of line
-        return addr >= PS2_RAM_SIZE && Ps2IsSpecialAddress(addr);
+        // gow-native-pc (patch 30): physical RDRAM (0x00000000), uncached (0x20000000), kseg0 (0x80000000) and
+        // kseg1 (0xA0000000) all map to the low 32 MB when bits 31 and 29 are cleared; MMIO (0x10000000) and
+        // scratchpad (0x70000000) stay >= PS2_RAM_SIZE and take the out-of-line check.
+        return (addr & 0x5FFFFFFFu) >= PS2_RAM_SIZE && Ps2IsSpecialAddress(addr);
     }
 
 public:
