+inline std::string text(const std::filesystem::path &path) {
+    std::ifstream f(path,std::ios::binary|std::ios::ate);if(!f)return {};
+    auto n=f.tellg();if(n<0 || n>512)return {};std::string s(size_t(n),'\0');f.seekg(0);
+    if(!f.read(s.data(),s.size()))return {};return s;
+}
+inline std::vector<gow_native_saves::Slot> slots() {
+    const char *card=std::getenv("GOW_MC0");if(!card || assets().empty())return {};
+    const auto directory=text(assets()/"directory");
+    if(directory.empty() || directory.size()>32 || directory.find_first_of("/\\\r\n")!=std::string::npos)return {};
+    try{return gow_native_saves::read(std::filesystem::u8path(card),directory);}catch(...){return {};}
+}
+inline bool queue(int slot) {
+    if(!supported.load() || slot<0 || slot>3 || status.load()==1)return false;
+    const auto entries=slots();bool found=false;for(const auto &entry:entries)found|=entry.slot==slot;
+    if(!found)return false;
+    const int previous=status.exchange(1);if(previous==1)return false;
+    int empty=0;if(!request.compare_exchange_strong(empty,slot+1)){status.store(previous);return false;}
+    return true;
+}
+inline bool poll() {
+    if(!supported.load())return false;
+    const char *dir=std::getenv("GOW_MENU_SETTINGS");if(!dir || !*dir)return false;
+    auto file=std::filesystem::u8path(dir)/"load.request";const auto s=text(file);
+    if(s.empty())return false;
+    std::error_code error;std::filesystem::remove(file,error);if(error)return false;
+    if(s.size()!=2 || s[0]<'0' || s[0]>'3' || s[1]!='\n')return false;
+    const bool accepted=queue(s[0]-'0');
+    if(!accepted && status.load()!=1)status.store(-1);
+    return accepted;
+}
+}
