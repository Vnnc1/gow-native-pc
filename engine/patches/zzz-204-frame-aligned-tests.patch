@@ -0,0 +1,36 @@
+#pragma once
+#include <cstdint>
+#include "runtime/gow_frame_metrics.h"
+#include <cstdlib>
+#include <string>
+
+// Test-only timestamps: wall seconds, g<seconds> since gameplay, f<guest frames>.
+// Durations use the same unit as the timestamp. Normal player input never uses this.
+namespace gow_test_time {
+inline constexpr double gameplay = 1.0e6, frame = 2.0e6;
+inline double parse(const std::string &text) {
+    if (!text.empty() && text[0] == 'f') return frame + std::strtod(text.c_str() + 1, nullptr);
+    if (!text.empty() && text[0] == 'g') return gameplay + std::strtod(text.c_str() + 1, nullptr);
+    return std::strtod(text.c_str(), nullptr);
+}
+inline bool reached(double when, double wall, double start, uint64_t frames) {
+    if (when >= frame) return start >= 0.0 && frames >= when - frame;
+    if (when >= gameplay) return start >= 0.0 && wall - start >= when - gameplay;
+    return wall >= when;
+}
+}
+
+// Intervals between pad observations of consecutive guest frames, not display latency.
+struct GowTestFrameProbe {
+    gow_diagnostics::FrameWindow intervals;
+    uint64_t lastFrame = 0, skipped = 0;
+    double lastTime = 0;
+    void begin(uint64_t frame, double time) { intervals = {}; lastFrame = frame; lastTime = time; skipped = 0; }
+    void observe(uint64_t frame, double time) {
+        if (frame == lastFrame) return;
+        if (frame < lastFrame) { ++skipped; return; }
+        skipped += frame - lastFrame - 1;
+        intervals.add((time - lastTime) * 1000);
+        lastFrame = frame; lastTime = time;
+    }
+};
