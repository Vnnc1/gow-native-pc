 {
     try {
-        return static_cast<uint32_t>(std::stoull(text, nullptr, 0));
+        if (text.empty() || text.front() == '-') return false;
+        size_t end = 0;
+        const auto value = std::stoull(text, &end, 0);
+        if (end != text.size() || value > UINT32_MAX) return false;
+        out = static_cast<uint32_t>(value);
+        return true;
     } catch (...) {
-        return 0u;
+        return false;
     }
 }
 
