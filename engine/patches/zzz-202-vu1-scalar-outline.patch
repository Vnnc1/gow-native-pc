+// Keep scalar scheduling loops out of every chain frame. The common block exit
+// still records its history inline, and scalar issue/retirement order is unchanged.
+template <typename Slot, typename Pipeline>
+VU1N_NOINLINE static void vu1nFinishScalarTiming(VU1Interpreter &vu, const Slot &sl,
+                                               const uint8_t *cyc, uint64_t start, Pipeline fdivPipeline)
+{
+    if (sl.scalarCount <= std::size(sl.scalar))
+    {
+        for (uint32_t k = 0; k < sl.scalarCount; ++k)
+            VU1NativeAccess::scalarStart(vu, start + cyc[sl.scalar[k].pair], sl.scalar[k].latency, sl.scalar[k].fdiv);
+        return;
+    }
+    const auto &bt = *sl.bt;
+    for (const uint8_t i : bt.scalarPairs)
+    {
+        const auto &d = bt.dec[i];
+        VU1NativeAccess::scalarStart(vu, start + cyc[i], d.lowerUsage.latency, d.lowerUsage.pipeline == fdivPipeline);
+    }
+}
+
 // After a native block: it joins the history (its results that outlive it are found there when needed); FDIV/EFU stay
 // busy until their ready cycle.
 // An FDIV / EFU operation a native block started at `issue`: busy until its ready cycle.
@@ -791,18 +811,7 @@ VU1N_INLINE void VU1NativeAccess::finishBlockTiming(VU1Interpreter &vu, const VU
     vu.m_cycle = end;
     if (sl.scalarCount == 0u)
         return;
-    if (sl.scalarCount != NS::kScalarMany)
