@@ -0,0 +1,401 @@
+// gow-native-pc: background VU1 compiler (included at the end of ps2_vu1_native.inl). Opt-in: GOW_VU1N_JIT=<work folder>.
+//
+// A VU1 block the game reaches without native code runs in the exact engine (slow: an area the first-play recording did
+// not visit drops to ~26 fps). With the compiler on, the micro memory (16 KB) holding such a block is queued, once per
+// code generation; a worker thread at low priority writes the queued images to <work>/in, runs the same generator as the
+// build (tools/vu1/vu1n_gen.py --dll, blocks the game already has left out), compiles the module with the build's clang
+// and loads it. The VU1 thread registers its blocks at the next runNative entry and sets the dispatch slots up again, so
+// the area switches to native code a few seconds after it was first reached, while the game keeps running. The blocks
+// are the build's own code (same generator, same helpers through VU1JitApi): bit-exact with the build's native blocks,
+// checked by GOW_VU1N_VERIFY like them. Modules stay in <work>/<stamp> and are loaded at the next start, until the
+// generator, the headers or the compiler command change (stamp).
+//
+// Environment (the launcher sets them for clang builds): GOW_VU1N_JIT_CXX = clang++, GOW_VU1N_JIT_PY = python,
+// GOW_VU1N_JIT_GEN = vu1n_gen.py, GOW_VU1N_JIT_FLAGS = compiler flags (include folders, -O / -f options of the build).
+// GOW_VU1N_JIT_DELAY = milliseconds the worker waits for more images before a batch (default 400). Log lines: [vu1n-jit].
+//
+// Threads: images are queued by the VU1 thread (slot setup), modules are built and loaded by the worker, and blocks are
+// registered by the VU1 thread (the registry is only read there). One VU1 thread, as in this runtime.
+#if defined(_WIN32)
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include <windows.h>
+#else
+#include <dlfcn.h>
+#include <sys/wait.h>
+#endif
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <condition_variable>
+#include <deque>
+#include <filesystem>
+#include <fstream>
+#include <sstream>
+#include <thread>
+
+namespace vu1jit
+{
+    namespace fs = std::filesystem;
+
+    std::string env(const char *name)
+    {
+        const char *v = std::getenv(name);
+        return v ? std::string(v) : std::string();
+    }
+
+    uint64_t fnv64(const void *p, size_t n, uint64_t h = 1469598103934665603ull)
+    {
+        const auto *b = static_cast<const uint8_t *>(p);
+        for (size_t i = 0; i < n; ++i)
+            h = (h ^ b[i]) * 1099511628211ull;
+        return h;
+    }
+
+    std::string hex(uint64_t v)
+    {
+        char s[17];
+        std::snprintf(s, sizeof(s), "%016llx", static_cast<unsigned long long>(v));
+        return s;
+    }
+
+    std::string quote(const std::string &s) { return "\"" + s + "\""; }
+
+    // Runs a command line hidden (no console window from the game's GUI process), below normal priority, and waits.
+    // Output goes to the log file. Returns the exit code (-1: could not start).
+    int runHidden(const std::string &cmd, const std::string &log)
+    {
+#if defined(_WIN32)
+        SECURITY_ATTRIBUTES sa{sizeof(sa), nullptr, TRUE};
+        HANDLE out = CreateFileA(log.c_str(), FILE_APPEND_DATA, FILE_SHARE_READ | FILE_SHARE_WRITE, &sa, OPEN_ALWAYS,
+                                 FILE_ATTRIBUTE_NORMAL, nullptr);
+        STARTUPINFOA si{};
+        si.cb = sizeof(si);
+        si.dwFlags = STARTF_USESTDHANDLES;
+        si.hStdOutput = si.hStdError = out;
+        si.hStdInput = GetStdHandle(STD_INPUT_HANDLE);
+        PROCESS_INFORMATION pi{};
+        std::string line = cmd;
+        const BOOL ok = CreateProcessA(nullptr, line.data(), nullptr, nullptr, TRUE,
+                                       CREATE_NO_WINDOW | BELOW_NORMAL_PRIORITY_CLASS, nullptr, nullptr, &si, &pi);
+        if (out != INVALID_HANDLE_VALUE)
+            CloseHandle(out);
+        if (!ok)
+            return -1;
+        WaitForSingleObject(pi.hProcess, INFINITE);
+        DWORD code = 1;
+        GetExitCodeProcess(pi.hProcess, &code);
+        CloseHandle(pi.hThread);
+        CloseHandle(pi.hProcess);
+        return static_cast<int>(code);
+#else
+        const int rc = std::system(("nice -n 10 " + cmd + " >> " + quote(log) + " 2>&1").c_str());
+        return rc == -1 ? -1 : WEXITSTATUS(rc);
+#endif
+    }
+
+    VU1JitModuleFn loadModule(const fs::path &path)
+    {
+#if defined(_WIN32)
+        HMODULE m = LoadLibraryW(path.wstring().c_str());
+        return m ? reinterpret_cast<VU1JitModuleFn>(reinterpret_cast<void *>(GetProcAddress(m, "vu1n_jit_blocks"))) : nullptr;
+#else
+        void *m = dlopen(path.string().c_str(), RTLD_NOW | RTLD_LOCAL);
+        if (!m)
+            std::fprintf(stderr, "[vu1n-jit] %s\n", dlerror());
+        return m ? reinterpret_cast<VU1JitModuleFn>(dlsym(m, "vu1n_jit_blocks")) : nullptr;
+#endif
+    }
+
+    void registerIfNew(uint64_t key, VU1NativeFn fn, uint32_t pairs, const VU1TailDesc *tail, const VU1NativeLanes *lanes)
+    {
+        if (nativeRegistry().count(key) == 0u) // the build's own block wins (same code)
+            vu1nRegisterBlock(key, fn, pairs, tail, lanes);
+    }
+
+    const VU1JitApi &api()
+    {
+        static const VU1JitApi a{kVu1JitAbi, &registerIfNew,
+                                 [](VU1NativeCtx &n, uint32_t next) -> void * { return VU1NativeAccess::chain(n, next); },
+                                 &VU1NativeAccess::callLower,
+                                 &VU1NativeAccess::callUpper, &VU1NativeAccess::xgkick};
+        return a;
+    }
+
+    class Compiler
+    {
+    public:
+        static Compiler *get()
+        {
+            static Compiler *c = []() -> Compiler * {
+                const std::string dir = env("GOW_VU1N_JIT");
+                if (dir.empty() || dir == "0")
+                    return nullptr;
+                auto *x = new Compiler(dir);
+                if (!x->m_ok)
+                {
+                    delete x;
+                    return nullptr;
+                }
+                return x;
+            }();
+            return c;
+        }
+
+        // VU1 thread, slot setup without native code: queue this micro memory once per code generation.
+        void noteMiss(const uint8_t *code, uint64_t codeChanges, uint64_t &queuedAt)
+        {
+            if (queuedAt == codeChanges)
+                return;
+            queuedAt = codeChanges;
+            if (!m_knownTaken)
+                takeKnown();
+            const uint64_t h = fnv64(code, PS2_VU1_CODE_SIZE);
+            std::lock_guard<std::mutex> lock(m_mutex);
+            if (!m_images.insert(h).second)
+                return; // already compiled or queued
+            m_queue.emplace_back(h, std::vector<uint8_t>(code, code + PS2_VU1_CODE_SIZE));
+            ++m_queuedImages;
+            m_wake.notify_one();
+        }
+
+        // VU1 thread, runNative entry: register the modules the worker loaded. True when blocks were added (the caller's
+        // slots must be set up again).
+        bool poll(uint32_t &seen)
+        {
+            const uint32_t ready = m_readyCount.load(std::memory_order_acquire);
+            if (ready == seen)
+                return false;
+            seen = ready;
+            std::vector<VU1JitModuleFn> mods;
+            {
+                std::lock_guard<std::mutex> lock(m_mutex);
+                mods.swap(m_ready);
+            }
+            uint32_t blocks = 0;
+            for (VU1JitModuleFn f : mods)
+                blocks += f(&api());
+            if (blocks)
+                std::fprintf(stderr, "[vu1n-jit] %u blocks now native\n", blocks);
+            return true;
+        }
+
+        // tests: wait until the queue is empty and nothing is being compiled
+        void waitIdle()
+        {
+            std::unique_lock<std::mutex> lock(m_mutex);
+            m_idle.wait(lock, [&] { return m_queue.empty() && !m_busy; });
+        }
+
+    private:
+        explicit Compiler(const std::string &dir)
+        {
+            m_cxx = env("GOW_VU1N_JIT_CXX");
+            m_py = env("GOW_VU1N_JIT_PY");
+            m_gen = env("GOW_VU1N_JIT_GEN");
+            m_flags = env("GOW_VU1N_JIT_FLAGS");
+            if (const std::string d = env("GOW_VU1N_JIT_DELAY"); !d.empty())
+                m_delayMs = std::atoi(d.c_str());
+            if (m_cxx.empty() || m_py.empty() || m_gen.empty())
+            {
+                std::fprintf(stderr, "[vu1n-jit] off: GOW_VU1N_JIT_CXX, GOW_VU1N_JIT_PY and GOW_VU1N_JIT_GEN are needed\n");
+                return;
+            }
+            // stamp: modules of another generator / header set / compiler command are not reused
+            std::string genText;
+            {
+                std::ifstream g(m_gen, std::ios::binary);
+                std::stringstream ss;
+                ss << g.rdbuf();
+                genText = ss.str();
+            }
+            const std::string cmdId = m_cxx + "|" + m_flags;
+            uint64_t stamp = fnv64(genText.data(), genText.size(), kVu1JitAbi);
+            stamp = fnv64(cmdId.data(), cmdId.size(), stamp);
+            std::error_code ec;
+            m_dir = fs::path(dir) / hex(stamp);
+            fs::create_directories(m_dir / "in", ec);
+            if (ec)
+            {
+                std::fprintf(stderr, "[vu1n-jit] off: cannot create %s\n", m_dir.string().c_str());
+                return;
+            }
+            m_ok = true;
+            m_thread = std::thread([this] { worker(); });
+            m_thread.detach();
+            std::fprintf(stderr, "[vu1n-jit] on: %s\n", m_dir.string().c_str());
+        }
+
+        // the registry's keys (the build's blocks and earlier modules): left out of new modules
+        void takeKnown()
+        {
+            std::lock_guard<std::mutex> lock(m_mutex);
+            for (const auto &e : nativeRegistry())
+                m_known.insert(e.first);
+            m_knownTaken = true;
+        }
+
+        void readKeys(const fs::path &file)
+        {
+            std::ifstream f(file);
+            std::string line;
+            while (std::getline(f, line))
+                if (!line.empty())
+                    m_known.insert(std::stoull(line, nullptr, 16));
+        }
+
+        void worker()
+        {
+#if defined(_WIN32)
+            SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_BELOW_NORMAL);
+#endif
+            // modules of earlier sessions first: areas compiled before are native right away
+            {
+                std::vector<fs::path> old;
+                std::error_code ec;
+                for (const auto &e : fs::directory_iterator(m_dir, ec))
+                    if (e.path().extension() == kModuleExt)
+                        old.push_back(e.path());
+                std::sort(old.begin(), old.end());
+                for (const fs::path &p : old)
+                    if (VU1JitModuleFn f = loadModule(p))
+                    {
+                        std::lock_guard<std::mutex> lock(m_mutex);
+                        m_ready.push_back(f);
+                        readKeys(fs::path(p).replace_extension(".keys"));
+                        m_batch = std::max(m_batch, static_cast<uint32_t>(std::atoi(p.stem().string().c_str() + 4)) + 1u);
+                        m_readyCount.fetch_add(1u, std::memory_order_release);
+                    }
+                {
+                    std::lock_guard<std::mutex> lock(m_mutex);
+                    for (const auto &e : fs::directory_iterator(m_dir / "in", ec))
+                        m_images.insert(std::stoull(e.path().stem().string(), nullptr, 16));
+                }
+                if (!old.empty())
+                    std::fprintf(stderr, "[vu1n-jit] %zu modules from earlier sessions\n", old.size());
+            }
+            for (;;)
+            {
+                std::vector<std::pair<uint64_t, std::vector<uint8_t>>> batch;
+                {
+                    std::unique_lock<std::mutex> lock(m_mutex);
+                    m_wake.wait(lock, [&] { return !m_queue.empty(); });
+                    m_busy = true;
+                }
+                // more images usually follow the first miss of an area: wait a little and take them together
+                std::this_thread::sleep_for(std::chrono::milliseconds(m_delayMs));
+                std::vector<uint64_t> known;
+                {
+                    std::lock_guard<std::mutex> lock(m_mutex);
+                    while (!m_queue.empty())
+                    {
+                        batch.push_back(std::move(m_queue.front()));
+                        m_queue.pop_front();
+                    }
+                    known.assign(m_known.begin(), m_known.end());
+                }
+                build(batch, known);
+                {
+                    std::lock_guard<std::mutex> lock(m_mutex);
+                    m_busy = false;
+                }
+                m_idle.notify_all();
+            }
+        }
+
+        void build(const std::vector<std::pair<uint64_t, std::vector<uint8_t>>> &batch, const std::vector<uint64_t> &known)
+        {
+            const auto t0 = std::chrono::steady_clock::now();
+            const std::string name = "jit_" + std::to_string(m_batch++);
+            const fs::path log = m_dir / "jit.log";
+            std::vector<fs::path> images;
+            for (const auto &[h, code] : batch)
+            {
+                images.push_back(m_dir / "in" / (hex(h) + ".bin"));
+                std::ofstream(images.back(), std::ios::binary).write(reinterpret_cast<const char *>(code.data()),
+                                                                     static_cast<std::streamsize>(code.size()));
+            }
+            {
+                std::ofstream k(m_dir / (name + ".skip"));
+                for (const uint64_t key : known)
+                    k << hex(key) << '\n';
+            }
+            std::string gen = quote(m_py) + " -I " + quote(m_gen) + " " + quote(m_dir.string());
+            for (const fs::path &p : images)
+                gen += " " + quote(p.string());
+            gen += " --dll " + name + " --skip-keys " + quote((m_dir / (name + ".skip")).string());
+            if (runHidden(gen, log.string()) != 0)
+            {
+                std::fprintf(stderr, "[vu1n-jit] generator failed (%s)\n", log.string().c_str());
+                return;
+            }
+            std::error_code ec;
+            fs::remove(m_dir / (name + ".skip"), ec);
+            const fs::path keys = m_dir / (name + ".keys");
+            if (fs::file_size(keys, ec) == 0u)
+            {
+                fs::remove(m_dir / (name + ".cpp"), ec);
+                fs::remove(keys, ec);
+                return; // only blocks the game already has (or unsupported ones)
+            }
+            const fs::path mod = m_dir / (name + kModuleExt);
+            const std::string cc = quote(m_cxx) + " " + m_flags + " -shared " + kModuleFlags + " -o " + quote(mod.string()) + " " +
+                                   quote((m_dir / (name + ".cpp")).string());
+            if (runHidden(cc, log.string()) != 0)
+            {
+                std::fprintf(stderr, "[vu1n-jit] compile failed (%s)\n", log.string().c_str());
+                return;
+            }
+            VU1JitModuleFn f = loadModule(mod);
+            if (!f)
+            {
+                std::fprintf(stderr, "[vu1n-jit] could not load %s\n", mod.string().c_str());
+                return;
+            }
+            const double secs = std::chrono::duration<double>(std::chrono::steady_clock::now() - t0).count();
+            std::lock_guard<std::mutex> lock(m_mutex);
+            readKeys(keys);
+            m_ready.push_back(f);
+            m_readyCount.fetch_add(1u, std::memory_order_release);
+            std::fprintf(stderr, "[vu1n-jit] %s: %zu micro memories compiled in %.1f s\n", name.c_str(), batch.size(), secs);
+        }
+
+#if defined(_WIN32)
+        static constexpr const char *kModuleExt = ".dll";
+        static constexpr const char *kModuleFlags = "-static";
+#else
+        static constexpr const char *kModuleExt = ".so";
+        static constexpr const char *kModuleFlags = "-fPIC -fvisibility=hidden";
+#endif
+        bool m_ok = false;
+        std::string m_cxx, m_py, m_gen, m_flags;
+        int m_delayMs = 400;
+        fs::path m_dir;
+        std::thread m_thread;
+        std::mutex m_mutex;
+        std::condition_variable m_wake, m_idle;
+        std::deque<std::pair<uint64_t, std::vector<uint8_t>>> m_queue;
+        std::unordered_set<uint64_t> m_images, m_known;
+        bool m_knownTaken = false, m_busy = false;
+        std::vector<VU1JitModuleFn> m_ready;
+        std::atomic<uint32_t> m_readyCount{0};
+        uint32_t m_batch = 0;
+        unsigned long long m_queuedImages = 0;
+    };
+}
+
+unsigned long long VU1NativeAccess::nativeBlocksRun(const VU1Interpreter &vu)
+{
+    return vu.m_native ? vu.m_native->nativeBlocks : 0u;
+}
+
+// tests (tests/vu1_jit_test.cpp): wait for the background compiler
+void vu1nJitWaitIdle()
+{
+    if (vu1jit::Compiler *c = vu1jit::Compiler::get())
+        c->waitIdle();
+}
