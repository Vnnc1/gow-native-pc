+// gow-native-pc: background VU1 compiler (GOW_VU1N_JIT, ps2_vu1_jit.inl) end to end, without game data. A procedural
+// micro memory holds a vertex-transform loop (LQI, MULA/MADDA/MADD broadcast, CLIP, DIV + WAITQ, MULq, FCGET, FMAND,
+// SQI, IADDI, IBNE) and an FMAC/flag mix. Each program runs in the exact engine (native off) and with the compiler on:
+// the first run reaches blocks without native code (queued), the test waits for the module, and the next runs must be
+// native (nativeBlocksRun > 0) and match the exact engine under GOW_VU1N_VERIFY's rule (integers, MAC, clip, pc exact;
+// floats within 2e-4: the native backend's DIV / RSQRT round like the host, not like the PS2), for random inputs. The
+// test prints a digest of every native result: the same test built with the blocks compiled in (the build's AOT path,
+// "-" as work dir) must print the same digest, i.e. the background-compiled blocks are bit-identical to the build's.
+// Then the exact engine and the native blocks are timed on the loop.
+// Usage: vu1_jit_test <work dir> <vu1n_gen.py> <python> <clang++> "<compiler flags>" [trials]
+//        vu1_jit_test - [trials]                  (AOT build: blocks from tools/vu1/vu1n_gen.py compiled in)
+//        vu1_jit_test --write <micro memory.bin>  (input of that AOT build)
+#include <fstream>
+#include "runtime/ps2_memory.h"
+#include "runtime/ps2_vu1.h"
+#include "runtime/ps2_vu1_native.h"
+#include "runtime/gs/gs_frontend.h"
+#include <algorithm>
+#include <chrono>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <random>
+#include <string>
+#include <vector>
+
+void vu1nJitWaitIdle();
+
+namespace
+{
+constexpr uint32_t kNop = 0x2ffu, kLowerNop = 0x8000033cu, kEbit = 0x40000000u;
+
+uint32_t upper(uint32_t op, uint32_t dest, uint32_t ft, uint32_t fs, uint32_t fd)
+{
+    return op | (dest << 21) | (ft << 16) | (fs << 11) | (fd << 6);
+}
+uint32_t upperSp(uint32_t code, uint32_t dest, uint32_t ft, uint32_t fs)
+{
+    return 0x3Cu | (code & 3u) | ((code >> 2) << 6) | (dest << 21) | (ft << 16) | (fs << 11);
+}
+uint32_t lowerSp(uint32_t sp, uint32_t dest, uint32_t ft, uint32_t fs)
+{
+    return 0x80000000u | (dest << 21) | (ft << 16) | (fs << 11) | ((sp >> 2) << 6) | 0x3Cu | (sp & 3u);
+}
+uint32_t iaddiu(uint32_t ft, uint32_t fs, uint32_t imm)
+{
+    return (0x08u << 25) | ((imm >> 11) << 21) | (ft << 16) | (fs << 11) | (imm & 0x7FFu);
+}
+uint32_t iaddi(uint32_t ft, uint32_t fs, int32_t imm5)
+{
+    return (0x40u << 25) | (ft << 16) | (fs << 11) | ((static_cast<uint32_t>(imm5) & 0x1Fu) << 6) | 0x32u;
+}
+uint32_t ibne(uint32_t ft, uint32_t fs, int32_t off)
+{
+    return (0x29u << 25) | (ft << 16) | (fs << 11) | (static_cast<uint32_t>(off) & 0x7FFu);
+}
+uint32_t divq(uint32_t fs, uint32_t fsf, uint32_t ft, uint32_t ftf)
+{
+    return 0x80000000u | (ftf << 23) | (fsf << 21) | (ft << 16) | (fs << 11) | ((0x38u >> 2) << 6) | 0x3Cu | (0x38u & 3u);
+}
+
+struct Program
+{
+    uint32_t pc;
+    const char *name;
+};
+
+// micro memory: program A (transform loop) at 0, program B (FMAC / flag mix) at 0x400
+std::vector<uint8_t> microMemory(std::vector<Program> &programs)
+{
+    std::vector<uint8_t> code(PS2_VU1_CODE_SIZE);
+    std::vector<std::pair<uint32_t, uint32_t>> a = {
+        {iaddiu(1, 0, 8), kNop},                                 // vi1 = 8 vertices
+        {iaddiu(2, 0, 0x10), kNop},                              // vi2 = input qword
+        {iaddiu(3, 0, 0x80), kNop},                              // vi3 = output qword
+        {iaddiu(7, 0, 0x00F0), kNop},                            // vi7 = MAC mask (sign bits)
+        // loop (pc 0x20)
+        {lowerSp(0x34u, 0xFu, 1, 2), kNop},                      // LQI vf1, (vi2++)
+        {kLowerNop, upperSp(0x18u, 0xFu, 1, 10)},                // MULAx  ACC, vf10, vf1x
+        {kLowerNop, upperSp(0x09u, 0xFu, 1, 11)},                // MADDAy ACC, vf11, vf1y
+        {kLowerNop, upperSp(0x0Au, 0xFu, 1, 12)},                // MADDAz ACC, vf12, vf1z
+        {kLowerNop, upper(0x0Bu, 0xFu, 1, 13, 2)},               // MADDw  vf2, vf13, vf1w
+        {kLowerNop, upperSp(0x1Fu, 0xEu, 2, 2)},                 // CLIPw  vf2xyz, vf2w
+        {divq(0, 3, 2, 3), kNop},                                // DIV Q, vf0w, vf2w
+        {lowerSp(0x3Bu, 0, 0, 0), kNop},                         // WAITQ
+        {kLowerNop, upper(0x1Cu, 0xEu, 0, 2, 3)},                // MULq vf3xyz, vf2, Q
+        {(0x1Cu << 25) | (5u << 16), kNop},                      // FCGET vi5
+        {(0x1Au << 25) | (6u << 16) | (7u << 11), kNop},         // FMAND vi6, vi7
+        {lowerSp(0x35u, 0xFu, 3, 3), kNop},                      // SQI vf3, (vi3++)
+        {iaddi(1, 1, -1), kNop},                                 // IADDI vi1, vi1, -1
+        {ibne(0, 1, -14), kNop},                                 // IBNE vi1, vi0, loop
+        {kLowerNop, kNop},                                       // delay slot
+        {kLowerNop, kNop | kEbit},
+        {kLowerNop, kNop},
+    };
+    std::memcpy(code.data(), a.data(), a.size() * 8u);
+    programs.push_back({0u, "transform loop"});
+    std::vector<std::pair<uint32_t, uint32_t>> b = {
+        {kLowerNop, upper(0x28u, 0xFu, 5, 4, 6)},                // ADD vf6, vf4, vf5
+        {kLowerNop, upper(0x2Au, 0xEu, 6, 4, 7)},                // MUL vf7xyz, vf4, vf6
+        {kLowerNop, upper(0x2Du, 0x9u, 4, 7, 8)},                // MSUB vf8xw, vf7, vf4
+        {kLowerNop, upper(0x2Bu, 0xFu, 5, 8, 9)},                // MAX vf9, vf8, vf5
+        {(0x18u << 25) | (6u << 16) | (7u << 11), kNop},         // FMEQ vi6, vi7
+        {kLowerNop, upper(0x2Fu, 0xFu, 9, 6, 14)},               // MINI vf14, vf6, vf9
+        {kLowerNop, upperSp(0x1Du, 0xFu, 15, 14)},               // ABS vf15, vf14
+        {kLowerNop, upperSp(0x14u, 0xFu, 16, 15)},               // FTOI0 vf16, vf15
+        {kLowerNop, kNop | kEbit},
+        {kLowerNop, kNop},
+    };
+    std::memcpy(code.data() + 0x400, b.data(), b.size() * 8u);
+    programs.push_back({0x400u, "FMAC / flag mix"});
+    return code;
+}
+
+float pick(std::mt19937 &rng)
+{
+    switch (rng() % 5u)
+    {
+    case 0:
+    {
+        static const uint32_t special[] = {0x00000000u, 0x80000000u, 0x3F800000u, 0x7F7FFFFFu, 0xFF7FFFFFu,
+                                           0x7F800000u, 0x00800000u, 0x7FC00000u, 0x00000001u};
+        uint32_t bits = special[rng() % (sizeof(special) / sizeof(special[0]))];
+        float f;
+        std::memcpy(&f, &bits, 4);
+        return f;
+    }
+    default:
+        return std::uniform_real_distribution<float>(-8.0f, 8.0f)(rng);
+    }
+}
+
+struct Inputs
+{
+    float vf[17][4];
+    uint8_t data[0x100 * 16];
+};
+
+Inputs randomInputs(std::mt19937 &rng)
+{
+    Inputs in{};
+    for (auto &r : in.vf)
+        for (float &c : r)
+            c = pick(rng);
+    for (uint32_t q = 0x10; q < 0x10 + 8; ++q) // input vertices
+        for (uint32_t c = 0; c < 4; ++c)
+        {
+            const float v = c == 3 ? std::uniform_real_distribution<float>(0.5f, 4.0f)(rng) : pick(rng);
+            std::memcpy(in.data + q * 16 + c * 4, &v, 4);
+        }
+    return in;
+}
+
+struct Result
+{
+    VU1State state;
+    std::vector<uint8_t> data;
+    unsigned long long native;
+};
+
+Result run(PS2Memory &mem, GS &gs, uint32_t pc, const Inputs &in)
+{
+    VU1Interpreter vu;
+    VU1State &s = vu.state();
+    for (uint32_t r = 1; r < 17; ++r)
+        std::memcpy(s.vf[r], in.vf[r], 16);
+    std::memcpy(mem.getVU1Data(), in.data, sizeof(in.data));
+    vu.execute(mem.getVU1Code(), PS2_VU1_CODE_SIZE, mem.getVU1Data(), PS2_VU1_DATA_SIZE, gs, &mem, pc);
+    return {vu.state(), std::vector<uint8_t>(mem.getVU1Data(), mem.getVU1Data() + sizeof(in.data)),
+            VU1NativeAccess::nativeBlocksRun(vu)};
+}
+
+// The status register's sticky bits are not modelled by native blocks (ps2_vu1_native.inl; GOW_VU1N_VERIFY leaves it out
+// too). Everything else must match bit for bit (GOW_VU1N_VERIFY allows 2e-4 on floats; this test does not).
+bool close(uint32_t a, uint32_t b) // GOW_VU1N_VERIFY's rule (ps2_vu1_core.cpp)
+{
+    if (a == b)
+        return true;
+    if (((a | b) & 0x7F800000u) == 0u)
+        return false; // integer-like words compare exactly
+    float fa, fb;
+    std::memcpy(&fa, &a, 4);
+    std::memcpy(&fb, &b, 4);
+    if (!std::isfinite(fa) || !std::isfinite(fb))
+        return false;
+    return std::fabs(fa - fb) <= 2e-4f * std::max(1.0f, std::max(std::fabs(fa), std::fabs(fb)));
+}
+bool closeWords(const void *x, const void *y, size_t bytes, unsigned &inexact)
+{
+    for (size_t i = 0; i < bytes; i += 4)
+    {
+        uint32_t a, b;
+        std::memcpy(&a, static_cast<const uint8_t *>(x) + i, 4);
+        std::memcpy(&b, static_cast<const uint8_t *>(y) + i, 4);
+        if (!close(a, b))
+            return false;
+        inexact += a != b;
+    }
+    return true;
+}
+bool same(const Result &x, const Result &y, unsigned &inexact)
+{
+    const VU1State &a = x.state, &b = y.state;
+    return closeWords(a.vf, b.vf, sizeof(a.vf), inexact) && closeWords(a.acc, b.acc, sizeof(a.acc), inexact) &&
+           closeWords(&a.q, &b.q, 4, inexact) && closeWords(x.data.data(), y.data.data(), x.data.size(), inexact) &&
+           std::memcmp(a.vi, b.vi, sizeof(a.vi)) == 0 && (a.mac & 0xF0FFu) == (b.mac & 0xF0FFu) && a.clip == b.clip &&
+           a.pc == b.pc;
+}
+uint64_t digest(uint64_t h, const Result &r)
+{
+    const auto mix = [&h](const void *p, size_t n) {
+        for (size_t i = 0; i < n; ++i)
+            h = (h ^ static_cast<const uint8_t *>(p)[i]) * 1099511628211ull;
+    };
+    mix(r.state.vf, sizeof(r.state.vf));
+    mix(r.state.acc, sizeof(r.state.acc));
+    mix(r.state.vi, sizeof(r.state.vi));
+    mix(&r.state.q, 4);
+    mix(&r.state.mac, 4);
+    mix(&r.state.clip, 4);
+    mix(&r.state.pc, 4);
+    mix(r.data.data(), r.data.size());
+    return h;
+}
+
+void setNative(bool on)
+{
+#if defined(_WIN32)
+    _putenv_s("GOW_VU1_NATIVE_OFF", on ? "" : "1");
+#else
+    if (on)
+        unsetenv("GOW_VU1_NATIVE_OFF");
+    else
+        setenv("GOW_VU1_NATIVE_OFF", "1", 1);
+#endif
+}
+}
+
+int main(int argc, char **argv)
+{
+    if (argc == 3 && std::strcmp(argv[1], "--write") == 0)
+    {
+        std::vector<Program> programs;
+        const auto code = microMemory(programs);
+        std::ofstream f(argv[2], std::ios::binary);
+        f.write(reinterpret_cast<const char *>(code.data()), static_cast<std::streamsize>(code.size()));
+        return f ? 0 : 2;
+    }
+    const bool aot = argc >= 2 && std::strcmp(argv[1], "-") == 0;
+    if (!aot && argc < 6)
+    {
+        std::fprintf(stderr, "usage: vu1_jit_test <work dir> <vu1n_gen.py> <python> <clang++> \"<flags>\" [trials]\n");
+        return 2;
+    }
+    if (aot)
+        ; // blocks compiled into this executable
+    else
+    {
+#if defined(_WIN32)
+    _putenv_s("GOW_VU1N_JIT", argv[1]);
+    _putenv_s("GOW_VU1N_JIT_GEN", argv[2]);
+    _putenv_s("GOW_VU1N_JIT_PY", argv[3]);
+    _putenv_s("GOW_VU1N_JIT_CXX", argv[4]);
+    _putenv_s("GOW_VU1N_JIT_FLAGS", argv[5]);
+    _putenv_s("GOW_VU1N_JIT_DELAY", "50");
+#else
+    setenv("GOW_VU1N_JIT", argv[1], 1);
+    setenv("GOW_VU1N_JIT_GEN", argv[2], 1);
+    setenv("GOW_VU1N_JIT_PY", argv[3], 1);
+    setenv("GOW_VU1N_JIT_CXX", argv[4], 1);
+    setenv("GOW_VU1N_JIT_FLAGS", argv[5], 1);
+    setenv("GOW_VU1N_JIT_DELAY", "50", 1);
+#endif
+    }
+    const unsigned trials = aot ? (argc > 2 ? static_cast<unsigned>(std::atoi(argv[2])) : 300u)
+                                : (argc > 6 ? static_cast<unsigned>(std::atoi(argv[6])) : 300u);
+    PS2Memory mem;
+    if (!mem.initialize())
+        return 2;
+    GS gs;
+    gs.init(mem.getGSVRAM(), 4u * 1024u * 1024u, &mem.gs());
+    std::vector<Program> programs;
+    const auto code = microMemory(programs);
+    std::memcpy(mem.getVU1Code(), code.data(), code.size());
+
+    std::mt19937 rng(20261026u);
+    // 1. first runs: no native code yet (misses queue the micro memory), then wait for the module
+    const auto t0 = std::chrono::steady_clock::now();
+    for (const Program &p : programs)
+    {
+        setNative(true);
+        const Result r = run(mem, gs, p.pc, randomInputs(rng));
+        std::printf("%-16s first run: %llu native blocks%s\n", p.name, r.native,
+                    aot ? " (compiled in)" : " (0 expected: not compiled yet)");
+    }
+    if (!aot)
+    {
+        vu1nJitWaitIdle();
+        std::printf("background compile finished in %.2f s\n",
+                    std::chrono::duration<double>(std::chrono::steady_clock::now() - t0).count());
+    }
+
+    // 2. exact engine vs compiled, random inputs
+    unsigned long long cases = 0, nativeBlocks = 0;
+    unsigned inexact = 0, edge = 0;
+    uint64_t dig = 1469598103934665603ull;
+    for (unsigned t = 0; t < trials; ++t)
+    {
+        const Inputs in = randomInputs(rng);
+        for (const Program &p : programs)
+        {
+            setNative(false);
+            const Result ref = run(mem, gs, p.pc, in);
+            setNative(true);
+            const Result got = run(mem, gs, p.pc, in);
+            if (got.native == 0u)
+            {
+                std::fprintf(stderr, "%s: still no native blocks after the background compile\n", p.name);
+                return 1;
+            }
+            if (!same(ref, got, inexact) && ++edge <= 2u)
+            {
+                // the native backend's known edge cases (also in the build's own native code, see the digest): the
+                // inputs include Inf / NaN / denormals, where a DIV result's zero sign or last bits can differ
+                const VU1State &x = ref.state, &y = got.state;
+                for (int r = 0; r < 32; ++r)
+                    if (std::memcmp(x.vf[r], y.vf[r], 16))
+                        std::fprintf(stderr, "  vf%d %08x %08x %08x %08x / %08x %08x %08x %08x\n", r,
+                                     *(const uint32_t *)&x.vf[r][0], *(const uint32_t *)&x.vf[r][1], *(const uint32_t *)&x.vf[r][2], *(const uint32_t *)&x.vf[r][3],
+                                     *(const uint32_t *)&y.vf[r][0], *(const uint32_t *)&y.vf[r][1], *(const uint32_t *)&y.vf[r][2], *(const uint32_t *)&y.vf[r][3]);
+                for (int r = 0; r < 16; ++r)
+                    if (x.vi[r] != y.vi[r])
+                        std::fprintf(stderr, "  vi%d %d / %d\n", r, x.vi[r], y.vi[r]);
+                if (std::memcmp(x.acc, y.acc, 16)) std::fprintf(stderr, "  acc differs\n");
+                if (x.status != y.status) std::fprintf(stderr, "  status %x / %x\n", x.status, y.status);
+                if (x.q != y.q) std::fprintf(stderr, "  q %g / %g\n", x.q, y.q);
+                for (size_t i = 0; i < ref.data.size(); i += 4)
+                    if (std::memcmp(&ref.data[i], &got.data[i], 4))
+                        std::fprintf(stderr, "  data qw %zx.%zu %08x / %08x\n", i / 16, (i % 16) / 4, *(const uint32_t *)&ref.data[i], *(const uint32_t *)&got.data[i]);
+                std::fprintf(stderr, "%s: differs from the exact engine on trial %u (above: exact / native)\n", p.name, t);
+            }
+            nativeBlocks += got.native;
+            dig = digest(dig, got);
+            ++cases;
+        }
+    }
+    std::printf("exact engine vs %s: %llu cases, %llu within GOW_VU1N_VERIFY's rule, %u outside it (edge inputs); "
+                "%llu native blocks run\n",
+                aot ? "compiled-in blocks" : "background-compiled blocks", cases, cases - edge, edge, nativeBlocks);
+    std::printf("digest of the native results: %016llx\n", static_cast<unsigned long long>(dig));
+
+    // 3. speed of the transform loop: one interpreter reused (as the game's VU1), 8 vertices per run
+    const Inputs in = randomInputs(rng);
+    double exactUs = 0, nativeUs = 0;
+    for (bool native : {false, true})
+    {
+        setNative(native);
+        VU1Interpreter vu;
+        constexpr int kRuns = 200000;
+        double best = 1e30;
+        for (int rep = 0; rep < 3; ++rep)
+        {
+            const auto s = std::chrono::steady_clock::now();
+            for (int i = 0; i < kRuns; ++i)
+            {
+                VU1State &st = vu.state();
+                for (uint32_t r = 1; r < 17; ++r)
+                    std::memcpy(st.vf[r], in.vf[r], 16);
+                std::memcpy(mem.getVU1Data(), in.data, sizeof(in.data) / 4); // the input vertices
+                vu.execute(mem.getVU1Code(), PS2_VU1_CODE_SIZE, mem.getVU1Data(), PS2_VU1_DATA_SIZE, gs, &mem, 0u);
+            }
+            best = std::min(best, std::chrono::duration<double, std::micro>(std::chrono::steady_clock::now() - s).count() / kRuns);
+        }
+        (native ? nativeUs : exactUs) = best;
+        std::printf("transform loop, %-15s %.3f us per run (8 vertices)\n", native ? "native blocks:" : "exact engine:", best);
+    }
+    std::printf("native blocks are %.1fx faster than the exact engine here\n", exactUs / nativeUs);
+    return 0;
+}
