+
+# gow-native-pc: background VU1 compiler (GOW_VU1N_JIT, ps2_vu1_jit.inl). gow_vu1_jit_test compiles its blocks while it
+# runs (vu1n_gen.py --dll + the compiler and flags given on its command line); gow_vu1_jit_aot_test has the same blocks
+# compiled in. Both print a digest of their native results: equal digests = the background-compiled blocks are the
+# build's own code, bit for bit. Run: gow_vu1_jit_test <work dir> <vu1n_gen.py> <python> <clang++> "<flags>" [trials]
+# and gow_vu1_jit_aot_test - [trials].
+find_package(Python3 COMPONENTS Interpreter)
+set(GOW_VU1_JIT_SOURCE "${CMAKE_CURRENT_LIST_DIR}/../../tests/vu1_jit_test.cpp")
