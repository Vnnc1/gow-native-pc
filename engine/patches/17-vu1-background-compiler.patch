+// gow-native-pc: background VU1 compiler (ps2_vu1_jit.inl, GOW_VU1N_JIT). Blocks the game reaches without native code are
+// generated (tools/vu1/vu1n_gen.py --dll) and compiled while it runs, into a module (DLL / shared object) that does not
+// link against the game: the VU1NativeAccess functions its blocks call that are not inline in this header come through
+// this table, filled by the runtime. abi: kVu1JitAbi of the runtime; a module built from other headers registers nothing.
+struct VU1JitApi
+{
+    uint64_t abi;
+    void (*reg)(uint64_t key, VU1NativeFn fn, uint32_t pairs, const VU1TailDesc *tail, const VU1NativeLanes *lanes);
+    void *(*chain)(VU1NativeCtx &, uint32_t); // VU1Interpreter::NativeState::Slot *
+    void (*callLower)(VU1NativeCtx &, uint32_t, uint32_t, uint32_t);
+    void (*callUpper)(VU1NativeCtx &, uint32_t, uint32_t);
+    void (*xgkick)(VU1NativeCtx &, uint32_t);
+};
+// version (bump when the generated code's contract changes) and the sizes of what the blocks touch
+constexpr uint64_t kVu1JitAbi = (1ull << 48) | (static_cast<uint64_t>(sizeof(VU1State)) << 32) |
+                                (static_cast<uint64_t>(sizeof(VU1NativeCtx)) << 16) |
+                                (VU1NativeAccess::kSlotSize + sizeof(VU1JitApi));
+using VU1JitModuleFn = uint32_t (*)(const VU1JitApi *);
+#if defined(_WIN32)
+#define VU1N_JIT_EXPORT __declspec(dllexport)
+#else
+#define VU1N_JIT_EXPORT __attribute__((visibility("default")))
+#endif
+
 
