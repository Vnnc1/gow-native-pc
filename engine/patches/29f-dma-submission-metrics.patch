+        tc.Run("native DMA counters count each submitted operation once", [](TestCase &t)
+        {
+            PS2Memory mem;
+            t.IsTrue(mem.initialize(), "initialize memory");
+            using Path = PS2Memory::DmaPath;
+            // Zeroed VIF words are NOPs; GIF delivery is captured without a renderer.
+            uint32_t delivered = 0;
+            mem.setGifPacketCallback([&](const uint8_t *, uint32_t) { ++delivered; });
+            for (const auto path : {Path::Vif0, Path::Vif1, Path::Gif})
+            {
+                const uint64_t before = mem.dmaStartCount();
+                mem.sendDma(path, 0x28000u, 1u);
+                mem.sendDma(path, 0x28000u, 0u);
+                writeDmaTag(mem.getRDRAM(), 0x28000u, makeDmaTag(0u, 7u, 0u, false));
+                mem.sendDmaChain(path, 0x28000u);
+                t.Equals(mem.dmaStartCount(), before + 3u, "flat, empty flat and empty chain each count once");
+                std::memset(mem.getRDRAM() + 0x28000u, 0, 16u);
+            }
+            t.Equals(delivered, 1u, "empty submissions do not deliver payloads");
+            for (const uint32_t channel : {0x10008000u, 0x10009000u, 0x1000A000u, 0x1000D000u, 0x1000D400u})
+            {
+                const uint64_t before = mem.dmaStartCount();
+                mem.writeIORegister(channel + 0x10u, 0x28000u);
+                mem.writeIORegister(channel + 0x20u, 1u);
+                mem.writeIORegister(channel, 0x100u);
+                t.Equals(mem.dmaStartCount(), before + 1u, "MMIO submission counts once including scratchpad");
+            }
+            t.IsTrue(mem.initialize(), "memory can be reinitialized");
+            t.Equals(mem.dmaStartCount(), 0ull, "reinitialization clears the diagnostic counter");
+        });
