+    PS2Runtime::RecompiledFunction g_worldDirect = nullptr, g_worldClipped = nullptr;
+    void drawWorldCircle(uint8_t *ram, R5900Context *ctx, PS2Runtime *runtime,
+                         uint32_t entry, PS2Runtime::RecompiledFunction original)
+    {
+        const uint32_t caller = GPR_U32(ctx, 31), matrix = GPR_U32(ctx, 7);
+        const bool knownCaller = entry == 0x158020 ? caller == 0x157EF0 :
+            (caller == 0x157F0C || caller == 0x157FD0);
+        Icono icon;
+        if (g_activo && ctx->pc == entry && knownCaller && matrix >= 64 && matrix - 64 == GPR_U32(ctx, 29) &&
+            g_construyendo.size() < 128 &&
+            worldCircleIcon(ram, GPR_U32(ctx, 5), GPR_U32(ctx, 6), matrix - 64, GPR_U32(ctx, 20), icon)) {
+            anotar(icon);
+            if (g_replacementsReady.load(std::memory_order_relaxed)) {
+                ctx->pc = caller;
+                return;
+            }
+        }
+        original(ram, ctx, runtime);
+    }
+    void drawWorldDirect(uint8_t *ram, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        drawWorldCircle(ram, ctx, runtime, 0x158020, g_worldDirect);
+    }
+    void drawWorldClipped(uint8_t *ram, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        drawWorldCircle(ram, ctx, runtime, 0x158B40, g_worldClipped);
     }
 
