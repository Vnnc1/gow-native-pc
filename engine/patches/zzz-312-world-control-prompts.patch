+    // USA model submission, after animation/visibility selection in 0x157A60.
+    // The submitted matrix is view-space; the preceding stack matrix is world-space.
+    bool worldCircleIcon(const uint8_t *ram, uint32_t node, uint32_t mesh,
+                         uint32_t worldMatrix, uint32_t meshIndex, Icono &icon)
+    {
+        if (!valida(node, 0xE8) || !valida(mesh, 0x54) || !valida(worldMatrix, 64)) return false;
+        if ((leer32(ram, node) & 0xFFFFu) != 15u) return false;
+        const uint32_t model = leer32(ram, node + 0x18);
+        if (!valida(model, 0x20) || (leer32(ram, model) & 0xFFFFu) != 1u) return false;
+        const uint32_t resource = leer32(ram, model + 0x1C);
+        constexpr char name[] = "gominigamecircle";
+        if (!valida(resource, 12 + sizeof(name)) ||
+            std::memcmp(ram + resource + 12, name, sizeof(name)) != 0) return false;
+        const uint32_t count = leer32(ram, node + 0xE0);
+        if (count == 0 || count > 64 || meshIndex >= count) return false;
+        uint32_t bounds;
+        if (leer32(ram, mesh + 0x20) & 0x10u) {
+            const uint32_t groups = leer32(ram, mesh + 8);
+            if (groups > 4096) return false;
+            bounds = mesh + 0x50 + 4 * groups;
+        } else bounds = node + 0x124 + 20 * meshIndex;
+        const uint32_t camera = leer32(ram, 0x35FA98);
+        if (!valida(bounds, 20) || !valida(camera, 0x80)) return false;
+        float world[16], viewProjection[16], center[3];
+        for (unsigned i = 0; i < 16; ++i) {
+            world[i] = leerF(ram, worldMatrix + 4 * i);
+            viewProjection[i] = leerF(ram, camera + 0x40 + 4 * i);
+            if (!std::isfinite(world[i]) || !std::isfinite(viewProjection[i])) return false;
+        }
+        const float radius = leerF(ram, bounds + 4);
+        if (!std::isfinite(radius) || radius <= 0 || radius > 4096) return false;
+        for (unsigned i = 0; i < 3; ++i) {
+            const float value = leerF(ram, bounds + 8 + 4 * i);
+            if (!std::isfinite(value)) return false;
+            center[i] = value;
+        }
+        float position[3];
+        for (unsigned i = 0; i < 3; ++i)
+            position[i] = center[0] * world[i] + center[1] * world[4+i] +
+                          center[2] * world[8+i] + world[12+i];
+        float clip[4];
+        for (unsigned i = 0; i < 4; ++i) {
+            clip[i] = position[0] * viewProjection[i] + position[1] * viewProjection[4+i] +
+                      position[2] * viewProjection[8+i] + viewProjection[12+i];
+            if (!std::isfinite(clip[i])) return false;
+        }
+        if (clip[3] <= 1.0f || std::fabs(clip[0]) > clip[3] || std::fabs(clip[1]) > clip[3]) return false;
+        const float scale = std::hypot(world[0], world[1], world[2]);
+        const float projectionScale = std::hypot(viewProjection[1], viewProjection[5], viewProjection[9]);
+        const float diameter = 480.0f * radius * scale * projectionScale / clip[3];
+        if (!std::isfinite(diameter) || diameter <= 0) return false;
+        // The bound includes the original flares; keep the mapped button readable without covering combat.
+        icon = Icono{BCirculo, VNormal, 320.0f * (1.0f + clip[0]/clip[3]),
+                     240.0f * (1.0f + clip[1]/clip[3]), std::clamp(diameter * 0.5f, 24.0f, 96.0f),
+                     1, 1, 1, 1, true};
+        return true;
+    }
