     } stats;
     bool statsEnabled = std::getenv("GOW_GS_HW_STATS") != nullptr;
 
+    // GPU-side frame timing (GOW_GS_GPU_PROFILE=1). `gs_ms` is thread busy time: it cannot tell CPU submission
+    // apart from the GPU still drawing. Two GL_TIMESTAMP counters per frame do; the queue reads them four frames
+    // later so nothing stalls (gs_gpu_profile.h, already exercised by ps2xTest). Opt-in: each timestamp costs a
+    // driver round trip and some drivers are slow at it.
+    GSGpuProfile::Queue gpuProfile;
+    bool gpuProfileOn = std::getenv("GOW_GS_GPU_PROFILE") != nullptr;
+    GLuint gpuBeginQuery = 0, gpuEndQuery = 0;
+    bool gpuSampleOpen = false, gpuNeedBegin = true;
+
+    GLuint takeQuery()
+    {
+        const Api &g = gl();
+        if (!gpuProfile.freeQueries.empty())
+        {
+            const GLuint q = gpuProfile.freeQueries.back();
+            gpuProfile.freeQueries.pop_back();
+            return q;
+        }
+        GLuint q = 0;
+        g.GenQueries(1, &q);
+        return q;
+    }
+
+    // Called before the first draw of a frame; no-op when profiling is off or a sample is still open.
+    void beginGpuSample()
+    {
+        if (!gpuProfileOn || gpuSampleOpen || !gpuNeedBegin || !gl().QueryCounter || !gl().GenQueries)
+            return;
+        gpuBeginQuery = takeQuery();
+        gpuEndQuery = takeQuery();
+        gl().QueryCounter(gpuBeginQuery, kTimestamp);
+        gpuSampleOpen = true;
+        gpuNeedBegin = false;
+    }
+
+    // Called from Present, after the frame's draws: closes the sample and reports whatever windows are ready.
+    void endGpuSample()
+    {
+        const Api &g = gl();
+        if (gpuProfileOn && gpuSampleOpen)
+        {
+            g.QueryCounter(gpuEndQuery, kTimestamp);
+            if (gpuProfile.sampleAllowed())
+                gpuProfile.pending.push_back({0u, gpuBeginQuery, gpuEndQuery, {}});
+            gpuProfile.endFrame();
+            gpuSampleOpen = false;
+        }
+        gpuNeedBegin = true;
+        if (!gpuProfileOn || gpuProfile.pending.empty())
+            return;
+        gpuProfile.collect(
+            [&](uint32_t id)
+            {
+                GLuint64 available = 0;
+                g.GetQueryObjectui64v(id, kQueryResultAvailable, &available);
+                return available != 0;
+            },
+            [&](uint32_t id)
+            {
+                GLuint64 ns = 0;
+                g.GetQueryObjectui64v(id, kQueryResult, &ns);
+                return static_cast<uint64_t>(ns);
+            },
+            [](const GSGpuProfile::Window &w)
+            {
+                if (w.count[0] == 0u)
+                    return;
+                uint64_t maxNs = 0u;
+                for (const auto &sample : w.rasterTimes) // kind 0 samples: (duration ns, info)
+                    maxNs = std::max(maxNs, sample.first);
+                std::fprintf(stderr, "[gs-gpu] frames=%llu gpu_ms=%.2f max_ms=%.2f\n",
+                             static_cast<unsigned long long>(w.count[0]), double(w.ns[0]) / 1e6 / double(w.count[0]),
+                             double(maxNs) / 1e6);
+            });
+    }
+
