diff --git a/PS2Recomp/ps2xRuntime/include/runtime/gs/gs_texture_budget.h b/PS2Recomp/ps2xRuntime/include/runtime/gs/gs_texture_budget.h
new file mode 100644
--- /dev/null
+++ b/PS2Recomp/ps2xRuntime/include/runtime/gs/gs_texture_budget.h
@@ -0,0 +1,27 @@
+#pragma once
+#include <cstdint>
+
+// Evict least-recently-used uploads before allocating storage. The active texture's
+// reference must survive; a single oversized texture is allowed to exceed the budget.
+template<class Map, class Texture, class Release>
+void gsReserveTextureBytes(Map &textures, Texture &active, uint64_t &bytes,
+                           uint64_t incoming, uint64_t budget, Release release)
+{
+    bytes -= active.allocatedBytes;
+    active.allocatedBytes = 0;
+    const uint64_t available = incoming < budget ? budget - incoming : 0;
+    while (bytes > available)
+    {
+        auto oldest = textures.end();
+        for (auto it = textures.begin(); it != textures.end(); ++it)
+            if (&it->second != &active && it->second.allocatedBytes &&
+                (oldest == textures.end() || it->second.lastUse < oldest->second.lastUse))
+                oldest = it;
+        if (oldest == textures.end()) break;
+        bytes -= oldest->second.allocatedBytes;
+        release(oldest->second);
+        textures.erase(oldest);
+    }
+    active.allocatedBytes = incoming;
+    bytes += incoming;
+}
