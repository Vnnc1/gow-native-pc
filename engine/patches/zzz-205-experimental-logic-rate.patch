diff --git a/PS2Recomp/ps2xRuntime/include/runtime/gow_logic_present.h b/PS2Recomp/ps2xRuntime/include/runtime/gow_logic_present.h
new file mode 100644
index 0000000..8832715
--- /dev/null
+++ b/PS2Recomp/ps2xRuntime/include/runtime/gow_logic_present.h
@@ -0,0 +1,18 @@
+#pragma once
+#include <atomic>
+#include <cstdint>
+
+// A game flip can precede the next 60 Hz VBlank in the experimental high-rate mode.
+namespace gow_logic_present
+{
+    inline std::atomic<bool> enabled{false};
+    inline std::atomic<uint64_t> flips{0};
+    inline void noteFlip()
+    {
+        if (enabled.load(std::memory_order_relaxed)) flips.fetch_add(1, std::memory_order_release);
+    }
+    inline uint64_t token(uint64_t vblank)
+    {
+        return enabled.load(std::memory_order_relaxed) ? flips.load(std::memory_order_acquire) : vblank;
+    }
+}
