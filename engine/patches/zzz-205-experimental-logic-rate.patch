+    // Experimental USA logic-rate adapter.
+    // gow_logic_rate.cpp (GPL-3.0). Keep VBlank/audio/movie clocks unchanged.
+    // BEGIN experimental logic rate (also compiled by the isolated regression test).
+    int g_logicFps = 60;
+    uint64_t g_logicNextSlot = 0;
+
+    int gowParseLogicFps(const char *value)
+    {
+        if (!value || !*value || std::strcmp(value, "60") == 0) return 60;
+        if (std::strcmp(value, "120") == 0) return 120;
+        if (std::strcmp(value, "240") == 0) return 240;
+        std::fprintf(stderr, "[gow-logic-config] invalid rate; using original 60 Hz\n");
+        return 60;
+    }
+
+    float gowLogicFloat(const uint8_t *rdram, uint32_t address)
+    {
+        float value;
+        std::memcpy(&value, rdram + address, sizeof(value));
+        return value;
+    }
+
+    bool gowLogicOriginalStep(const uint8_t *rdram)
+    {
+        const uint32_t movie = readGuest32(rdram, 0x0029C838u);
+        return readGuest32(rdram, 0x0029C65Cu) == 0u || readGuest32(rdram, 0x0029C660u) != 0u ||
+               readGuest32(rdram, 0x0029C654u) != 1u || (movie >= 3u && movie <= 11u);
+    }
+
+    void gowLogicTimeStep(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        const bool entry = ctx->pc == 0x0017D778u;
+        const bool measured = readGuest32(rdram, 0x0029C65Cu) != 0u;
+        const bool once = readGuest32(rdram, 0x0029C660u) != 0u;
+        const uint32_t ra = GPR_U32(ctx, 31);
+        sub_0017D778_0x17d778(rdram, ctx, runtime);
+        // The current generated leaf has no checkpoints. Never patch an incomplete return.
+        if (!entry || ctx->pc != ra || g_logicFps <= 60 || !measured || once || gowLogicOriginalStep(rdram))
+            return;
+        const uint32_t ticks = readGuest32(rdram, 0x0029C670u);
+        const float perField = readGuest32(rdram, 0x00331078u) == 3u ? 115.2f : 96.1f;
+        const float lower = 6000.0f / static_cast<float>(g_logicFps);
+        const float hundredths = std::min(std::max(static_cast<float>(ticks) / perField, lower), 400.0f);
+        const float delta = (hundredths / 100.0f) / 60.0f;
+        const float scaled = delta * gowLogicFloat(rdram, 0x0029C644u) * gowLogicFloat(rdram, 0x0029C648u);
+        std::memcpy(rdram + 0x0029C64Cu, &delta, sizeof(delta));
+        std::memcpy(rdram + 0x0029C658u, &scaled, sizeof(scaled));
+    }
+
+    void gowLogicFrameWait(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        const uint32_t ra = GPR_U32(ctx, 31);
+        const bool frameEnd = ctx->pc == 0x0017A1D0u && ra == 0x0017A36Cu;
+        if (g_logicFps <= 60 || !frameEnd || (ctx->cop0_status & 0x10000u) == 0u || gowLogicOriginalStep(rdram))
+        {
+            if (frameEnd)
+            {
+                if (g_logicNextSlot != 0u) writeGuest32(rdram, 0x0029C7D4u, 0u);
+                g_logicNextSlot = 0u;
+            }
+            sub_0017A1D0_0x17a1d0(rdram, ctx, runtime);
+            return;
+        }
+        const uint64_t period = EeScheduler::kEeClockHz / static_cast<uint64_t>(g_logicFps);
+        const uint64_t now = runtime->eeScheduler().currentEeCycle();
+        writeGuest32(rdram, 0x0029C7D4u, 0u);
+        ctx->pc = ra;
+        // Rebase late frames; do not issue catch-up bursts to inflate the counter.
+        if (g_logicNextSlot == 0u || now >= g_logicNextSlot)
+        {
+            g_logicNextSlot = now + period;
+            return;
+        }
+        const uint64_t wait = g_logicNextSlot - now;
+        g_logicNextSlot += period;
+        runtime->eeScheduler().delayCurrent(wait);
+    }
+
+    void gowInstallLogicRate(PS2Runtime &runtime)
+    {
+        g_logicFps = gowParseLogicFps(std::getenv("GOW_EXPERIMENTAL_LOGIC_FPS"));
+        g_logicNextSlot = 0u;
+        gow_logic_present::flips.store(0, std::memory_order_relaxed);
+        gow_logic_present::enabled.store(g_logicFps > 60, std::memory_order_relaxed);
+        if (g_logicFps > 60)
+        {
+            runtime.replaceFunction(0x0017D778u, gowLogicTimeStep);
+            runtime.replaceFunction(0x0017A1D0u, gowLogicFrameWait);
+        }
+        std::fprintf(stderr, "[gow-logic-config] fps=%d experimental=%d vblank=60\n", g_logicFps, g_logicFps > 60);
+    }
+    // END experimental logic rate.
+
