new file mode 100644
index 0000000..b1ab92e
--- /dev/null
+++ b/PS2Recomp/ps2xRuntime/src/lib/gs/gs_diag_clock.h
@@ -0,0 +1,51 @@
+#pragma once
+// gow-native-pc (patch 89): single TSC-to-nanosecond conversion for every [gs-*] diagnostic.
+//
+// Contract:
+//  * cycles() reads the CPU time-stamp counter of the calling thread; on x86/x86-64 Windows it is the
+//    invariant, synchronized counter, so one nsPerTick value is valid on the producer (VU1 worker) and
+//    on the render worker.
+//  * The calibration is a one-shot 10 ms steady_clock sample cached in a function-local static. Every
+//    diagnostic site must use this helper instead of calibrating its own copy, otherwise two counters
+//    reported in the same window are not comparable.
+//  * On a non-x86 build cycles() returns 0 and nsPerTick() returns 1.0 so the printed arithmetic stays
+//    finite (the diagnostic then reads cycles, not nanoseconds).
+#include <chrono>
+#include <cstdint>
+#if defined(_MSC_VER)
+#include <intrin.h>
+#elif defined(__x86_64__) || defined(__i386__)
+#include <x86intrin.h>
+#endif
+
+namespace gsdiag
+{
+constexpr double kReportSeconds = 5.0;   // every [gs-*] line is printed once per this window
+constexpr double kCalibrationMs = 10.0;  // steady_clock sample length used to derive ns per TSC tick
+
+inline uint64_t cycles()
+{
+#if defined(_MSC_VER) || defined(__x86_64__) || defined(__i386__)
+    return static_cast<uint64_t>(__rdtsc());
+#else
+    return 0u;
+#endif
+}
+
+inline double nsPerTick()
+{
+    static const double value = []
+    {
+        const auto t0 = std::chrono::steady_clock::now();
+        const uint64_t c0 = cycles();
+        while (std::chrono::steady_clock::now() - t0 <
+               std::chrono::milliseconds(static_cast<int>(kCalibrationMs)))
+        {
+        }
+        const uint64_t c1 = cycles();
+        const double ns = std::chrono::duration<double, std::nano>(std::chrono::steady_clock::now() - t0).count();
+        return (ns > 0.0 && c1 > c0) ? ns / static_cast<double>(c1 - c0) : 1.0;
+    }();
+    return value;
+}
+} // namespace gsdiag
