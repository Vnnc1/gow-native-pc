diff --git a/PS2Recomp/ps2xRuntime/include/runtime/gow_save_backup.h b/PS2Recomp/ps2xRuntime/include/runtime/gow_save_backup.h
new file mode 100644
--- /dev/null
+++ b/PS2Recomp/ps2xRuntime/include/runtime/gow_save_backup.h
@@ -0,0 +1,103 @@
+#pragma once
+
+#include <atomic>
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <ctime>
+#include <filesystem>
+#include <fstream>
+#include <mutex>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+namespace gow_saves
+{
+    struct Result { bool ok = false; std::string message; };
+    inline std::mutex backupMutex;
+    // Published by the EE save completion; consumed only by the host drawing thread.
+    inline std::atomic<int> notification{0};
+
+    inline Result snapshot(const std::string &label, const char *source)
+    {
+        std::lock_guard<std::mutex> lock(backupMutex);
+        const char *cardValue = std::getenv("GOW_MC0"), *rootValue = std::getenv("GOW_SAVES_DIR");
+        if (!cardValue || !*cardValue || !rootValue || !*rootValue)
+            return {false, "Start the game from the launcher to use save backups."};
+        namespace fs = std::filesystem;
+        fs::path folder;
+        try
+        {
+            const auto card = fs::u8path(cardValue), root = fs::u8path(rootValue);
+            std::error_code error;
+            const auto size = fs::file_size(card, error);
+            // The runtime uses an 8 MiB PS2 card, with or without spare/ECC bytes.
+            if (error || (size != 0x800000u && size != 0x840000u))
+                return {false, "No valid memory card yet: save at an altar first."};
+            const auto before = fs::last_write_time(card);
+            std::vector<char> bytes(static_cast<size_t>(size));
+            std::ifstream in(card, std::ios::binary);
+            in.read(bytes.data(), static_cast<std::streamsize>(bytes.size()));
+            if (!in || in.peek() != std::char_traits<char>::eof() || fs::last_write_time(card) != before)
+                return {false, "The memory card changed during backup; try again after saving."};
+            in.close();
+            fs::create_directories(root);
+            const std::time_t now = std::time(nullptr);
+            std::tm local{};
+#ifdef _WIN32
+            if (localtime_s(&local, &now) != 0) throw std::runtime_error("invalid backup time");
+#else
+            if (!localtime_r(&now, &local)) throw std::runtime_error("invalid backup time");
+#endif
+            char stamp[32], shown[32];
+            std::strftime(stamp, sizeof(stamp), "%Y%m%d-%H%M%S", &local);
+            std::strftime(shown, sizeof(shown), "%Y-%m-%d %H:%M:%S", &local);
+            // Atomic reservation also protects against a simultaneous launcher backup.
+            for (unsigned n = 0; n < 10000; ++n)
+            {
+                const auto candidate = root / (std::string(stamp) + (n ? "-" + std::to_string(n + 1) : ""));
+                if (fs::create_directory(candidate)) { folder = candidate; break; }
+            }
+            if (folder.empty()) return {false, "Could not reserve a backup folder."};
+            std::string safeLabel;
+            for (unsigned char ch : label)
+                if (ch >= 32 && ch != '"' && ch != '\\') safeLabel += static_cast<char>(ch);
+            {
+                std::ofstream out(folder / "Mcd001.ps2.tmp", std::ios::binary);
+                out.write(bytes.data(), static_cast<std::streamsize>(bytes.size()));
+                out.close();
+                if (!out) throw std::runtime_error("card write failed");
+                std::ofstream info(folder / "save.json", std::ios::binary);
+                info << "{\n  \"label\": \"" << safeLabel << "\",\n  \"time\": \"" << shown
+                     << "\",\n  \"source\": \"" << source << "\",\n  \"card\": \"Mcd001.ps2\",\n  \"bytes\": " << size << "\n}\n";
+                info.close();
+                if (!info) throw std::runtime_error("metadata write failed");
+            }
+            // Readers require this final name: no partially written backup becomes visible.
+            fs::rename(folder / "Mcd001.ps2.tmp", folder / "Mcd001.ps2");
+            std::fprintf(stderr, "[gow-saves] source=%s saved=%s bytes=%zu\n", source,
+                         folder.filename().string().c_str(), bytes.size());
+            return {true, "Saved: " + folder.filename().string()};
+        }
+        catch (const std::exception &)
+        {
+            // Only files created in this call's exclusively reserved directory are removed.
+            if (!folder.empty())
+            {
+                std::error_code ignored;
+                fs::remove(folder / "Mcd001.ps2.tmp", ignored);
+                fs::remove(folder / "save.json", ignored);
+                fs::remove(folder, ignored);
+            }
+            std::fprintf(stderr, "[gow-saves] source=%s backup failed\n", source);
+            return {false, "Could not write the launcher backup. The game's memory card was not changed."};
+        }
+    }
+
+    inline void automaticBackup()
+    {
+        const auto result = snapshot("", "auto");
+        notification.store(result.ok ? 1 : -1, std::memory_order_release);
+    }
+}
