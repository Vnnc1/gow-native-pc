+    // USA altar transaction: the second write commits the slot index after the payload.
+    // Keep the original async operation and resume behavior; never snapshot a pending/error result.
+    void gowAltarSaveWrite(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        const bool finalWrite = ctx->pc == 0x0022E800u && GPR_U32(ctx, 31) == 0x002306C0u &&
+                                GPR_U32(ctx, 4) == 0u && GPR_U32(ctx, 7) == 0x44u;
+        sub_0022E800_0x22e800(rdram, ctx, runtime);
+        if (finalWrite && ctx->pc == 0x002306C0u && GPR_U32(ctx, 2) == 1u &&
+            readGuest32(rdram, 0x002A1284u) == 0u && readGuest32(rdram, 0x002A128Cu) == 0x44u)
+            gow_saves::automaticBackup();
+    }
