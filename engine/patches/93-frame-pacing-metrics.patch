 // Owned by the guest thread. Fixed storage, one clock read per frame, no hot-path allocation.
 // Intervals describe entry to the configured guest frame function, not GPU/display presentation.
+//
+// gow-native-pc (patch 93): the mean alone hides frame pacing. This window now also answers the two
+// questions a hitch report has to answer: how many frames are noticeably slower than the typical one
+// (stutter ratio), and how long the worst uninterrupted stretch of slow frames is (longest run). The
+// percentile/streak work happens once per report window on a copy, never per frame.
 namespace gow_diagnostics {
 struct FrameWindow {
+    struct Analysis {
+        double mean = 0, p50 = 0, p95 = 0, p99 = 0, p999 = 0, max = 0, jitter = 0;
+        size_t samples = 0;
+        uint64_t stutterFrames = 0, spikeFrames = 0, longestRun = 0;
+        double stutterRatio = 0;
+    };
     std::array<double, 4096> intervals{};
-    uint64_t count = 0, overBudget = 0, over33 = 0, over50 = 0, over100 = 0;
+    uint64_t count = 0, overBudget = 0, over33 = 0, over50 = 0, over100 = 0, over200 = 0, over300 = 0;
     double total = 0, maximum = 0;
     void add(double ms) {
         if (!std::isfinite(ms) || ms < 0) return;
         intervals[count % intervals.size()] = ms;
         ++count; total += ms; maximum = std::max(maximum, ms);
         overBudget += ms > 1000.0 / 60.0; over33 += ms > 1000.0 / 30.0;
-        over50 += ms > 50.0; over100 += ms > 100.0;
+        over50 += ms > 50.0; over100 += ms > 100.0; over200 += ms > 200.0; over300 += ms > 300.0;
     }
     size_t samples() const { return static_cast<size_t>(std::min<uint64_t>(count, intervals.size())); }
-    void sort() { std::sort(intervals.begin(), intervals.begin() + samples()); }
-    double percentile(unsigned percent) const {
+    // One pass over the stored order (ring order above 4096 samples) plus one sort of a copy.
+    Analysis analyze() const {
+        Analysis a;
         const size_t n = samples();
-        if (!n) return 0;
-        const size_t rank = std::max<size_t>(1, (n * std::min(100u, percent) + 99) / 100);
-        return intervals[rank - 1];
+        a.samples = n;
+        if (!n) return a;
+        std::array<double, 4096> sorted{};
+        std::copy(intervals.begin(), intervals.begin() + n, sorted.begin());
+        std::sort(sorted.begin(), sorted.begin() + n);
+        const auto at = [&](unsigned permille) { // permille: 500 = p50, 950 = p95, 999 = p99.9
+            const size_t rank = std::max<size_t>(1, (n * permille + 999) / 1000);
+            return sorted[rank - 1];
+        };
+        a.mean = total / static_cast<double>(count);
+        a.p50 = at(500); a.p95 = at(950); a.p99 = at(990); a.p999 = at(999); a.max = maximum;
+        double squares = 0;
+        for (size_t i = 0; i < n; ++i) {
+            const double d = sorted[i] - a.mean;
+            squares += d * d;
+        }
+        a.jitter = std::sqrt(squares / static_cast<double>(n));
+        const double stutter = 1.5 * a.p50, spike = std::max(2.0 * a.p50, 100.0);
+        uint64_t run = 0;
+        for (size_t i = 0; i < n; ++i) {
+            const double ms = intervals[i];
+            if (ms > stutter) ++a.stutterFrames;
+            if (ms > spike) ++a.spikeFrames;
+            run = ms > 2.0 * a.p50 ? run + 1 : 0;
+            a.longestRun = std::max(a.longestRun, run);
+        }
+        a.stutterRatio = static_cast<double>(a.stutterFrames) / static_cast<double>(n);
+        return a;
     }
 };
 }
