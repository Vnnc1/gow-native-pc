+    {
+        for (uint32_t y = 0; y < height; ++y)
+        {
+            uint8_t *row = pixels.data() + y * kHostFrameWidth * 4u;
+            for (uint32_t x = 0; x < width; ++x)
+                row[x * 4u + 3u] = 255u;
