+        if (!date)
+            return true;
+
+        const bool datm = ((testReg >> 15) & 0x1u) != 0u;
+        switch (framePsm)
+        {
+        case GS_PSM_CT32:
+            return (((rawFramebufferPixel >> 31) & 0x1u) != 0u) == datm;
+        case GS_PSM_CT16:
+        case GS_PSM_CT16S:
+            return (((rawFramebufferPixel >> 15) & 0x1u) != 0u) == datm;
+        case GS_PSM_CT24:
+            // RGB24 has no destination alpha, so DATE always passes.
+            return true;
+        default:
+            return true;
+        }
