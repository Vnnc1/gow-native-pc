+        {
+            const uint8_t *row = pixels.data() + y * kHostFrameWidth * 4u;
+            for (uint32_t x = 0; x < width; ++x)
+            {
+                if (row[x * 4u] != 0u || row[x * 4u + 1u] != 0u || row[x * 4u + 2u] != 0u)
