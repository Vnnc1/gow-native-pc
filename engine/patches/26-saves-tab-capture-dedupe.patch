+    std::string cleanLabel(const char *text)
+    {
+        std::string out;
+        for (const char *c = text; *c && out.size() < 40u; ++c)
+        {
+            const unsigned char ch = static_cast<unsigned char>(*c);
+            if (std::isalnum(ch) || ch == ' ' || ch == '-' || ch == '_' || ch == '.' || ch == ',' || ch >= 0x80u)
+                out += static_cast<char>(ch); // no quotes or backslashes: the label goes into save.json as is
+        }
+        while (!out.empty() && out.back() == ' ')
+            out.pop_back();
+        return out;
+    }
+
+    void listSaves(SavesState &state)
+    {
+        state.saves.clear();
+        state.listed = true;
+        const std::string root = envPath("GOW_SAVES_DIR");
+        std::error_code error;
+        if (root.empty() || !std::filesystem::is_directory(root, error))
+            return;
+        for (const auto &entry : std::filesystem::directory_iterator(root, error))
+        {
+            if (!entry.is_directory(error) || !std::filesystem::exists(entry.path() / "Mcd001.ps2", error))
+                continue;
+            SaveEntry save{entry.path().filename().string(), {}};
+            std::ifstream info(entry.path() / "save.json");
+            const std::string text((std::istreambuf_iterator<char>(info)), std::istreambuf_iterator<char>());
+            const size_t key = text.find("\"label\": \"");
+            if (key != std::string::npos)
+            {
+                const size_t from = key + 10u, to = text.find('"', from);
+                if (to != std::string::npos)
+                    save.label = text.substr(from, to - from);
+            }
+            state.saves.push_back(std::move(save));
+        }
+        std::sort(state.saves.begin(), state.saves.end(),
+                  [](const SaveEntry &a, const SaveEntry &b) { return a.folder > b.folder; });
+    }
+
+    // Reads the card file; a read that overlaps a game save (size or write time changed) is retried.
+    bool readCard(const std::filesystem::path &card, std::vector<char> &bytes)
+    {
+        for (int attempt = 0; attempt < 5; ++attempt)
+        {
+            std::error_code error;
+            const auto before = std::filesystem::last_write_time(card, error);
+            if (error)
+                return false;
+            std::ifstream in(card, std::ios::binary);
+            bytes.assign(std::istreambuf_iterator<char>(in), std::istreambuf_iterator<char>());
+            const auto after = std::filesystem::last_write_time(card, error);
+            if (!error && before == after && !bytes.empty())
+                return true;
+            std::this_thread::sleep_for(std::chrono::milliseconds(200));
+        }
+        return false;
+    }
+
+    std::string snapshotCard(const std::string &label)
+    {
+        const std::string card = envPath("GOW_MC0");
+        const std::string root = envPath("GOW_SAVES_DIR");
+        if (card.empty() || root.empty())
+            return "Start the game from the launcher to use saves (GOW_MC0 / GOW_SAVES_DIR not set).";
+        std::vector<char> bytes;
+        if (!readCard(card, bytes))
+            return "No memory card yet: save at an altar in the game first.";
+        const std::time_t now = std::time(nullptr);
+        char stamp[32];
+        std::strftime(stamp, sizeof(stamp), "%Y%m%d-%H%M%S", std::localtime(&now));
+        char shown[32];
+        std::strftime(shown, sizeof(shown), "%Y-%m-%d %H:%M:%S", std::localtime(&now));
+        std::filesystem::path folder = std::filesystem::path(root) / stamp;
+        std::error_code error;
+        for (int n = 2; std::filesystem::exists(folder, error); ++n)
+            folder = std::filesystem::path(root) / (std::string(stamp) + "-" + std::to_string(n));
+        std::filesystem::create_directories(folder, error);
+        if (error)
+            return "Could not create " + folder.string();
+        {
+            std::ofstream out(folder / "Mcd001.ps2.tmp", std::ios::binary);
+            out.write(bytes.data(), static_cast<std::streamsize>(bytes.size()));
+            if (!out)
+                return "Could not write " + (folder / "Mcd001.ps2").string();
+        }
+        std::filesystem::rename(folder / "Mcd001.ps2.tmp", folder / "Mcd001.ps2", error);
+        std::ofstream info(folder / "save.json");
+        info << "{\n  \"label\": \"" << label << "\",\n  \"time\": \"" << shown << "\",\n  \"source\": \"F1\",\n"
+             << "  \"card\": \"Mcd001.ps2\",\n  \"bytes\": " << bytes.size() << "\n}\n";
+        std::fprintf(stderr, "[gow-saves] saved %s (%zu bytes)\n", folder.string().c_str(), bytes.size());
+        return "Saved: " + folder.filename().string() + (label.empty() ? std::string() : " (" + label + ")");
+    }
+
+    void drawSavesTab()
+    {
+        SavesState &state = savesState();
+        if (!state.listed)
+            listSaves(state);
+        const std::string card = envPath("GOW_MC0");
+        ImGui::TextWrapped("Keeps a copy of the memory card so a test can start again from here. Save at an altar "
+                           "in the game first: the copy holds the game's own last save, not the exact moment.");
+        ImGui::TextWrapped("To go back to a copy: close the game, open the launcher's Saves page, choose it, start "
+                           "the game and load from the game's menu.");
+        std::error_code error;
+        if (!card.empty() && std::filesystem::exists(card, error))
+        {
+            const auto age = std::filesystem::file_time_type::clock::now() - std::filesystem::last_write_time(card, error);
+            const long long minutes = std::chrono::duration_cast<std::chrono::minutes>(age).count();
+            ImGui::Text("Memory card last written by the game %lld min ago", minutes < 0 ? 0ll : minutes);
+        }
+        ImGui::Separator();
+        ImGui::SetNextItemWidth(260.0f);
+        ImGui::InputTextWithHint("##label", "label (optional, e.g. after the ship)", state.label, sizeof(state.label));
+        ImGui::SameLine();
+        if (ImGui::Button("Save a copy of the card"))
+        {
+            state.status = snapshotCard(cleanLabel(state.label));
+            state.label[0] = '\0';
+            listSaves(state);
+        }
+        ImGui::SameLine();
+        if (ImGui::Button("Refresh"))
+            listSaves(state);
+        if (!state.status.empty())
+            ImGui::TextWrapped("%s", state.status.c_str());
+        ImGui::Separator();
+        ImGui::Text("Copies in %s:", envPath("GOW_SAVES_DIR").c_str());
+        for (const SaveEntry &save : state.saves)
+            ImGui::BulletText("%s  %s", save.folder.c_str(), save.label.c_str());
+        if (state.saves.empty())
+            ImGui::TextDisabled("none yet");
+    }
