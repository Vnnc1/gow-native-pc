diff --git a/PS2Recomp/ps2xRuntime/include/runtime/gow_queue_metrics.h b/PS2Recomp/ps2xRuntime/include/runtime/gow_queue_metrics.h
new file mode 100644
--- /dev/null
+++ b/PS2Recomp/ps2xRuntime/include/runtime/gow_queue_metrics.h
@@ -0,0 +1,46 @@
+#pragma once
+#include <algorithm>
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+
+// Producer-owned capacity-wait counters. Callers serialize access; flush after producers stop.
+// Wall time includes scheduling/spinning, not GPU time. No clocks on the disabled path.
+class GowQueueMetrics
+{
+public:
+    using Clock = std::chrono::steady_clock;
+    struct Entry { uint64_t waits = 0, ns = 0, maxNs = 0, queuedPeak = 0; };
+    explicit GowQueueMetrics(unsigned queue) : queue(queue) {}
+    const bool enabled = [] {
+        const char *v = std::getenv("GOW_SYNC_DIAG");
+        return v && v[0] == '1';
+    }();
+    void add(uint64_t ns, uint64_t queued)
+    {
+        if (!enabled) return;
+        for (Entry *e : {&total, &window}) {
+            ++e->waits; e->ns += ns;
+            e->maxNs = std::max(e->maxNs, ns);
+            e->queuedPeak = std::max(e->queuedPeak, queued);
+        }
+        const auto now = Clock::now();
+        if (now - start >= std::chrono::seconds(5)) emit(now, false);
+    }
+    Entry snapshot() const { return total; }
+    void flush() { if (enabled) emit(Clock::now(), true); }
+private:
+    unsigned queue; // 1: GS stage (queued bytes); 2: backend (queued chunks).
+    Entry total{}, window{};
+    Clock::time_point start = enabled ? Clock::now() : Clock::time_point{};
+    void emit(Clock::time_point now, bool final)
+    {
+        if (window.waits) std::fprintf(stderr,
+            "[gow-queue] queue=%u window=%.6f waits=%llu wait_ms=%.6f max_ms=%.6f queued_peak=%llu final=%u\n",
+            queue, std::chrono::duration<double>(now - start).count(),
+            (unsigned long long)window.waits, window.ns / 1e6, window.maxNs / 1e6,
+            (unsigned long long)window.queuedPeak, unsigned(final));
+        window = {}; start = now;
+    }
+};
