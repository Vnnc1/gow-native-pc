+// zzz-329: +1 when the guide turns clockwise on screen, -1 counter-clockwise, 0 when it is not a turn.
+inline int turnOf(const Sequence &guide) {
+    if (guide.count<2 || guide.keys[0]>3 || guide.keys[1]>3) return 0;
+    const unsigned step=(guide.keys[1]+4u-guide.keys[0])%4u;
+    return step==1u ? 1 : step==3u ? -1 : 0;
+}
+// Digital keys jump between 8 directions and fall back to the centre between taps, which a stick-rotation QTE
+// does not read as a turn. While a recognized rotation guide is on screen, the keys the player presses become
+// targets of one continuous full-deflection sweep: it never passes through the centre, takes the shorter way
+// round (the guide's way when opposite) and moves at a bounded rate, so even a slow game frame samples the
+// intermediate angles. Angles are degrees clockwise from screen up. Outside a guide the axes are untouched.
+class KeyboardSweep {
+public:
+    static constexpr double kDegreesPerSecond=900.0; // half turn 0.2 s, full turn 0.4 s
+    static constexpr double kGrace=0.25;             // a released key keeps the stick out this long (taps work)
+    static constexpr double kMaxStep=0.1;            // a stalled reader never makes the sweep jump
+    bool apply(int turn,double now,uint8_t &x,uint8_t &y) {
+        if (!turn || !std::isfinite(now)) { reset(); return false; }
+        const double dt=m_active && now>m_last ? std::fmin(now-m_last,kMaxStep) : 0.0;
+        m_last=now;
+        const int dx=(x>128)-(x<128), dy=(y>128)-(y<128);
+        if (dx || dy) {
+            const double held=wrap(std::atan2(double(dx),double(-dy))*57.29577951308232);
+            if (!m_active) { m_angle=held; m_active=true; }
+            m_target=held; m_released=-1.0;
+        } else {
+            if (!m_active) return false;
+            if (m_released<0.0) m_released=now;
+            if (now-m_released>kGrace && distance(m_angle,m_target)<0.5) { reset(); return false; }
+        }
+        const double forward=wrap(turn>0 ? m_target-m_angle : m_angle-m_target);
+        const double way=forward<=180.0 ? double(turn) : -double(turn);
+        const double remaining=forward<=180.0 ? forward : 360.0-forward;
+        m_angle=wrap(m_angle+way*std::fmin(remaining,kDegreesPerSecond*dt));
+        const double radians=m_angle/57.29577951308232;
+        x=static_cast<uint8_t>(std::lround(128.0+127.0*std::sin(radians)));
+        y=static_cast<uint8_t>(std::lround(128.0-127.0*std::cos(radians)));
+        return true;
+    }
+    void reset() { m_active=false; m_released=-1.0; }
+    bool active() const { return m_active; }
+private:
+    static double wrap(double a) { a=std::fmod(a,360.0); return a<0.0 ? a+360.0 : a; }
+    static double distance(double a,double b) { const double d=wrap(a-b); return d>180.0 ? 360.0-d : d; }
+    bool m_active=false;
+    double m_angle=0.0, m_target=0.0, m_last=0.0, m_released=-1.0;
+};
 inline std::mutex mutex;
 inline uint16_t buttons=0;
+inline Sequence guide{};
 inline std::chrono::steady_clock::time_point published{};
-inline void publish(uint16_t value) {
-    std::lock_guard<std::mutex> lock(mutex);buttons=value;published=std::chrono::steady_clock::now();
+inline void publish(uint16_t value,const Sequence &rotation=Sequence{}) {
+    std::lock_guard<std::mutex> lock(mutex);buttons=value;guide=rotation;published=std::chrono::steady_clock::now();
+}
+// The rotation guide of the last complete guest frame; empty once publication stops (250 ms, like the buttons).
+inline Sequence activeGuide() {
+    std::lock_guard<std::mutex> lock(mutex);
+    const double age=std::chrono::duration<double>(std::chrono::steady_clock::now()-published).count();
+    return age>=0.0 && age<=0.25 ? guide : Sequence{};
 }
