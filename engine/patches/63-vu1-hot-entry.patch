 }
 
+// gow-native-pc (patch 63): GOW_VU1_HOT=1, every 5 s: the VU1 wall time split by the entry PC of the program runs (one
+// exact sample per run, unlike patch 62's 1/8 block sampling). `ns_pair` is the block execution cost of that program,
+// excluding the per-run entry/exit that the same thread pays once per run.
+static void vu1HotReport()
+{
+    static const bool enabled = std::getenv("GOW_VU1_HOT") != nullptr;
+    if (!enabled)
+        return;
+    static auto last = std::chrono::steady_clock::now();
+    const auto now = std::chrono::steady_clock::now();
+    if (now - last < std::chrono::seconds(5))
+        return;
+    const double wall = std::chrono::duration<double>(now - last).count();
+    last = now;
+    static const double toMs = [] {
+        const auto t0 = std::chrono::steady_clock::now();
+        const uint64_t c0 = vu1cost::ticks();
+        while (std::chrono::steady_clock::now() - t0 < std::chrono::milliseconds(10)) {}
+        const uint64_t c1 = vu1cost::ticks();
+        const double ms = std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - t0).count();
+        return ms > 0.0 ? 1.0 / (static_cast<double>(c1 - c0) / ms) : 0.0;
+    }();
+    static vu1cost::HotEntry prev[2048];
+    struct Row { double ms; unsigned long long pc, runs, pairs, blocks; };
+    static Row rows[2048];
+    size_t count = 0u;
+    double totalMs = 0.0;
+    for (size_t i = 0; i < 2048u; ++i)
+    {
+        const vu1cost::HotEntry &c = vu1cost::hot[i];
+        const vu1cost::HotEntry &p = prev[i];
+        if (c.runs == p.runs)
+            continue;
+        const double ms = static_cast<double>(c.ticks - p.ticks) * toMs;
+        rows[count++] = Row{ms, i * 8u, c.runs - p.runs, c.pairs - p.pairs, c.blocks - p.blocks};
+        totalMs += ms;
+        prev[i] = c;
+    }
+    std::sort(rows, rows + count, [](const Row &a, const Row &b) { return a.ms > b.ms; });
+    std::fprintf(stderr, "[vu1-hot] total_ms=%.0f entries=%zu wall=%.2fs", totalMs, count, wall);
+    for (size_t i = 0; i < count && i < 8u; ++i)
+    {
+        const Row &r = rows[i];
+        std::fprintf(stderr, " | pc=%x %.0fms %.1f%% runs=%.0f/s pairs=%.2fM ns_pair=%.1f",
+                     static_cast<unsigned>(r.pc), r.ms, totalMs > 0.0 ? r.ms * 100.0 / totalMs : 0.0,
+                     static_cast<double>(r.runs) / wall, static_cast<double>(r.pairs) * 1e-6,
+                     r.pairs ? r.ms * 1e6 / static_cast<double>(r.pairs) : 0.0);
+    }
+    std::fprintf(stderr, "\n");
+}
