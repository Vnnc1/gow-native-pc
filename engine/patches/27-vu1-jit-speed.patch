+
+    // prologue: 6 pushes + 8 bytes keep rsp 16-byte aligned (entry rsp = 8 mod 16); the same bytes in every block
+    void emitPrologue(Asm &a)
+    {
+        a.push(RBX); a.push(RBP); a.push(R12); a.push(R13); a.push(R14); a.push(R15);
+        a.subRsp(kStackBytes + 8u);
+        a.movRR(RBX, kArg0);
+        a.lea(R12, RSP, static_cast<int32_t>(kFrameOffset));
+        a.movRM(R14, RBX, static_cast<int32_t>(offsetof(VU1NativeCtx, s)));
+        a.movRM(R15, RBX, static_cast<int32_t>(offsetof(VU1NativeCtx, data)));
+        a.movRI64(RBP, reinterpret_cast<uint64_t>(&kConst[0][0]));
+    }
+    uint32_t prologueSize()
+    {
+        static const uint32_t size = [] { Asm a; emitPrologue(a); return static_cast<uint32_t>(a.c.size()); }();
+        return size;
+    }
