+            {kLowerNop, up(MADDbc + 1, XYZW, 2, 5, 6)},                     // vf6 = ACC + vf5 * wy
+            {loSp(MR32, XYZW, 7, 6), kNop},
+            {loSp(MFIR, X, 8, 6), kNop},
+            {kLowerNop, upA(ITOF4, X, 8, 8)},
+            {lo(SQ, XYZW, 6, 3, 0), kNop},
+            {lo(SQ, XYZW, 7, 3, 1), kNop},
+            {iaddiu(2, 2, 2), kNop},
+            {iaddiu(3, 3, 2), kNop},
+            {iaddi(5, 5, -1), kNop},
+        };
+        p.insert(p.end(), body.begin(), body.end());
+        p.push_back({br(IBNE, 0, 5, back(p, loop)), kNop});
+        p.push_back({kLowerNop, kNop});
+        endProgram(p);
+        place(p, "skin");
+    }
+    { // cull: triangles (three positions), backface test on the sign of the cross product's z
+        Pairs p = {
+            {lo(ILW, X, 5, 0, 0), kNop},
+            {iaddiu(2, 0, 1), kNop},
+            {iaddiu(3, 0, 0x200), kNop},
+            {iaddiu(7, 0, 0x0020), kNop},                            // MAC sign bit of z
+        };
+        const size_t loop = p.size();
+        Pairs body = {
+            {loSp(LQI, XYZW, 1, 2), kNop},
+            {loSp(LQI, XYZW, 2, 2), kNop},
+            {loSp(LQI, XYZW, 3, 2), up(SUB, XYZ, 1, 2, 4)},           // e1 = v1 - v0
+            {kLowerNop, up(SUB, XYZ, 1, 3, 5)},                       // e2 = v2 - v0
+            {kLowerNop, upA(OPMULA, XYZ, 5, 4)},
+            {kLowerNop, up(OPMSUB, XYZ, 4, 5, 6)},                    // n = e1 x e2
+            {kLowerNop, up(MUL, XYZ, 1, 6, 8)},
+            {kLowerNop, upA(ADDAbc + 0, XYZ, 8, 0)},
+            {kLowerNop, up(MSUB, XYZW, 0, 0, 9) },                    // MAC writer near the flag reader
+            {kLowerNop, kNop},
+            {kLowerNop, kNop},
+            {kLowerNop, kNop},
+            {lo(FMAND, 0, 8, 7, 0), kNop},                            // vi8 = MAC & sign mask
+            {lo(FMEQ, 0, 9, 7, 0), kNop},
+        };
+        p.insert(p.end(), body.begin(), body.end());
+        p.push_back({br(IBEQ, 8, 0, 4), kNop});                       // facing away: skip the stores
+        p.push_back({kLowerNop, kNop});
+        p.push_back({loSp(SQI, XYZW, 3, 1), kNop});
+        p.push_back({loSp(SQI, XYZW, 3, 2), kNop});
+        p.push_back({loSp(SQI, XYZW, 3, 3), kNop});
+        p.push_back({iaddi(5, 5, -1), kNop});
+        p.push_back({br(IBNE, 0, 5, back(p, loop)), kNop});
+        p.push_back({kLowerNop, kNop});
+        endProgram(p);
+        place(p, "cull");
+    }
+    return code;
+}
+
+uint64_t mix(uint64_t h, const void *p, size_t n)
+{
+    for (size_t i = 0; i < n; ++i)
+        h = (h ^ static_cast<const uint8_t *>(p)[i]) * 1099511628211ull;
+    return h;
+}
+
+std::vector<uint32_t> programStarts(const uint8_t *code)
+{
+    std::vector<uint32_t> out;
+    const auto pair = [&](uint32_t i, uint32_t &l, uint32_t &u) { std::memcpy(&l, code + i * 8u, 4); std::memcpy(&u, code + i * 8u + 4u, 4); };
+    const uint32_t pairs = PS2_VU1_CODE_SIZE / 8u;
+    std::vector<bool> start(pairs, false);
+    for (uint32_t i = 0; i < pairs; ++i)
+    {
+        uint32_t l, u, pl = 0, pu = 0;
+        pair(i, l, u);
+        if (l == 0u && u == 0u)
+            continue;
+        if (i > 0)
+            pair(i - 1, pl, pu);
+        if (i == 0 || (pl == 0u && pu == 0u))
+            start[i] = true;
+        if (((u >> 30) & 1u) && i + 2u < pairs)
+            start[i + 2u] = true;
+    }
+    for (uint32_t i = 0; i < pairs; ++i)
+    {
+        uint32_t l, u;
+        pair(i, l, u);
+        if (start[i] && !(l == 0u && u == 0u))
+            out.push_back(i * 8u);
+    }
+    return out;
+}
+
+struct Inputs
+{
+    VU1State state{};
+    std::vector<uint32_t> data;
+};
+
+// seeded inputs: finite floats in VF registers and VU memory, small integers where programs read counts and indices
+Inputs makeInputs(uint32_t seed, uint32_t count)
+{
+    std::mt19937 rng(seed);
+    const auto flt = [&](float lo, float hi) { return std::uniform_real_distribution<float>(lo, hi)(rng); };
+    Inputs in;
+    in.data.assign(PS2_VU1_DATA_SIZE / 4, 0u);
+    for (int r = 1; r < 32; ++r)
+        for (int c = 0; c < 4; ++c)
+            in.state.vf[r][c] = flt(-2.0f, 2.0f);
+    in.state.vf[0][3] = 1.0f;
+    for (int c = 0; c < 4; ++c)
+        in.state.vf[15][c] = 2048.0f;
+    in.state.q = 1.0f, in.state.i = 1.0f, in.state.p = 1.0f;
+    for (size_t q = 1; q < 0x200; ++q)
+        for (int c = 0; c < 4; ++c)
+            in.data[q * 4 + c] = fbits(c == 3 ? 1.0f : flt(-100.0f, 100.0f));
+    for (size_t q = 2; q < 0x200; q += 2) // skin: bone indices 0..7 in z / w of the weights qwords
+        in.data[q * 4 + 2] = rng() % 8u, in.data[q * 4 + 3] = rng() % 8u;
+    for (size_t q = 0x300; q < 0x320; ++q)
+        for (int c = 0; c < 4; ++c)
+            in.data[q * 4 + c] = fbits(flt(-1.0f, 1.0f));
+    in.data[0] = count;
+    in.data[0x1FF * 4] = 0x8000u; // transform's XGKICK address: an empty GIF tag with EOP
+    return in;
+}
+}
+
+int main(int argc, char **argv)
+{
+    const std::string mode = argc > 1 ? argv[1] : "";
+    if (mode == "--write" && argc > 2)
+    {
+        std::vector<Program> programs;
+        const auto code = microMemory(programs);
+        std::ofstream(argv[2], std::ios::binary).write(reinterpret_cast<const char *>(code.data()), static_cast<std::streamsize>(code.size()));
+        return 0;
+    }
+    if (mode == "exact")
+        setEnv("GOW_VU1_NATIVE_OFF", "1");
+    else if (mode == "hybrid")
+        setEnv("GOW_VU1N_X64", "1");
+    else if (mode == "jit")
+        setEnv("GOW_VU1N_X64", "1"), setEnv("GOW_VU1X_ONLY", "1");
+    else
+    {
+        std::fprintf(stderr, "usage: vu1_bench exact|hybrid|jit [reps]   |   vu1_bench --write <file>\n");
+        return 2;
+    }
+    const unsigned reps = argc > 2 ? static_cast<unsigned>(std::max(1, std::atoi(argv[2]))) : 2000u;
+
+    PS2Memory mem;
+    if (!mem.initialize())
+        return 2;
+    GS gs;
+    gs.init(mem.getGSVRAM(), 4u * 1024u * 1024u, &mem.gs());
+    uint64_t digest = 1469598103934665603ull;
+    // one line per workload: the synthetic programs, then each external image (all its program starts)
+    struct Work
+    {
+        std::string name;
+        std::vector<uint8_t> code;
+        std::vector<uint32_t> pcs;
+        uint32_t count;
+    };
+    std::vector<Work> work;
+    {
+        std::vector<Program> programs;
+        const auto code = microMemory(programs);
+        for (const Program &p : programs)
+            work.push_back({p.name, code, {p.pc}, 48u});
+    }
+    {
+        std::string list = GOW_VU1_BENCH_LIST;
+        for (size_t p = 0; p < list.size();)
+        {
+            const size_t e = list.find(';', p);
+            const std::string file = list.substr(p, e == std::string::npos ? std::string::npos : e - p);
+            p = e == std::string::npos ? list.size() : e + 1;
+            std::ifstream in(file, std::ios::binary);
+            std::vector<uint8_t> code((std::istreambuf_iterator<char>(in)), std::istreambuf_iterator<char>());
+            if (code.size() == PS2_VU1_CODE_SIZE)
+                work.push_back({file.substr(file.find_last_of("/\\") + 1), code, programStarts(code.data()), 16u});
+        }
+    }
+    double total = 0.0;
+    unsigned long long nativeTotal = 0;
+    for (const Work &w : work)
+    {
+        std::memcpy(mem.getVU1Code(), w.code.data(), PS2_VU1_CODE_SIZE);
+        const Inputs in = makeInputs(77u, w.count);
+        VU1Interpreter vu; // one interpreter reused, as the game's VU1
+        const auto runOnce = [&](uint32_t pc) {
+            vu.state() = in.state;
+            std::memcpy(mem.getVU1Data(), in.data.data(), PS2_VU1_DATA_SIZE);
+            vu.execute(mem.getVU1Code(), PS2_VU1_CODE_SIZE, mem.getVU1Data(), PS2_VU1_DATA_SIZE, gs, &mem, pc, 0u, 0u, 200000u);
+        };
+        unsigned long long cycles = 0;
+        for (uint32_t pc : w.pcs) // first pass: JIT compilation; its results go into the digest
+        {
+            runOnce(pc);
+            const VU1State &s = vu.state();
+            digest = mix(digest, s.vf, sizeof(s.vf));
+            digest = mix(digest, s.vi, sizeof(s.vi));
+            digest = mix(digest, s.acc, sizeof(s.acc));
+            digest = mix(digest, &s.q, 4);
+            digest = mix(digest, &s.mac, 4);
+            digest = mix(digest, &s.clip, 4);
+            digest = mix(digest, &s.pc, 4);
+            digest = mix(digest, mem.getVU1Data(), PS2_VU1_DATA_SIZE);
+            cycles += s.cycles;
+        }
+        const unsigned long long before = VU1NativeAccess::nativeBlocksRun(vu);
+        // timed: VU memory reset is outside the clock (a 16 KB copy would dominate small programs)
+        double best = 1e30;
+        for (int round = 0; round < 3; ++round)
+        {
+            double t = 0.0;
+            for (unsigned r = 0; r < reps; ++r)
+                for (uint32_t pc : w.pcs)
+                {
+                    vu.state() = in.state;
+                    std::memcpy(mem.getVU1Data(), in.data.data(), PS2_VU1_DATA_SIZE);
+                    const auto t0 = std::chrono::steady_clock::now();
+                    vu.execute(mem.getVU1Code(), PS2_VU1_CODE_SIZE, mem.getVU1Data(), PS2_VU1_DATA_SIZE, gs, &mem, pc, 0u, 0u, 200000u);
+                    t += std::chrono::duration<double, std::micro>(std::chrono::steady_clock::now() - t0).count();
+                }
+            best = std::min(best, t / reps);
+        }
+        const unsigned long long native = (VU1NativeAccess::nativeBlocksRun(vu) - before) / (3ull * reps);
+        nativeTotal += native;
+        total += best;
+        std::printf("%-26s %9.2f us per pass  %7llu VU cycles  %6llu native blocks\n", w.name.c_str(), best, cycles, native);
+    }
+    std::printf("mode %s: total %.2f us per pass\n", mode.c_str(), total);
+#if defined(__x86_64__) || defined(_M_X64)
+    unsigned long long compiled = 0, unsupported = 0, bytes = 0, ns = 0;
+    vu1xStats(compiled, unsupported, bytes, ns);
+    if (compiled || unsupported)
+        std::printf("x64 JIT: %llu blocks compiled (%llu bytes, %.1f us each), %llu left to the exact engine\n", compiled, bytes,
+                    compiled ? ns / 1000.0 / compiled : 0.0, unsupported);
+#endif
+    std::printf("digest %016llx\n", static_cast<unsigned long long>(digest));
+    (void)nativeTotal;
+    return 0;
+}
