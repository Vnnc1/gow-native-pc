+            e.movsx16(RCX, k.useVibFt ? frVib(k.i) : viM(k.ft));
+            e.alu32(0x39, RAX, RCX);
+            cc = k.op == 0x28 ? CC_E : CC_NE;
+        }
+        else
+        {
+            e.alu32(0x85, RAX, RAX);
+            cc = k.op == 0x2C ? CC_L : k.op == 0x2D ? CC_G : k.op == 0x2E ? CC_LE : CC_GE;
+        }
+        e.movi32(R13, k.endPc);
+        e.movi32(RDX, target);
+        e.cmov(cc, R13, RDX);
+    }
