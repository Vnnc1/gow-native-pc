+            {lo(LQ, XYZW, 12, 8, 0x302), upA(MADDAbc + 1, XYZW, 1, 11)},
+            {lo(LQ, XYZW, 13, 8, 0x303), upA(MADDAbc + 2, XYZW, 1, 12)},
+            {lo(LQ, XYZW, 14, 9, 0x300), up(MADDbc + 3, XYZW, 1, 13, 4)},  // vf4 = bone 0 * position
+            {lo(LQ, XYZW, 15, 9, 0x301), upA(MULAbc + 0, XYZW, 1, 14)},
+            {lo(LQ, XYZW, 16, 9, 0x302), upA(MADDAbc + 1, XYZW, 1, 15)},
