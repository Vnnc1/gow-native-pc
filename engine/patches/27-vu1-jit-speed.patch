+    // branch pair: r13d = the next pc (hBranch + hNext), the link register written as hBranch does
+    void emitBranch(Ctx &cx, const Imm &k)
+    {
+        E &e = cx.e;
+        const uint32_t link = (k.pc + 16u) / 8u;
+        const uint32_t target = static_cast<uint32_t>(k.imm);
+        switch (k.op)
+        {
+        case 0x20: e.movi32(R13, target); return;
+        case 0x21:
+            if (k.ft)
+                e.st32i(viM(k.ft), link);
+            e.movi32(R13, target);
+            return;
+        case 0x24: case 0x25:
+            e.movzx16(RAX, viM(k.fs));
+            e.shl32(RAX, 3);
+            e.alu32i(4, RAX, 0x3FFF);
+            e.r(0, false, {0x89}, RAX, R13); // mov r13d, eax
+            if (k.op == 0x25 && k.ft)
+                e.st32i(viM(k.ft), link);
+            return;
+        default:
+            break;
+        }
+        e.movsx16(RAX, k.useVibFs ? frVib(k.i) : viM(k.fs));
+        uint8_t cc;
+        if (k.op == 0x28 || k.op == 0x29)
