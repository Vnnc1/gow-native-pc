+
+#if defined(__x86_64__) || defined(_M_X64)
+void vu1xStats(unsigned long long &compiled, unsigned long long &unsupported, unsigned long long &codeBytes, unsigned long long &nanos);
+#endif
+
+#ifndef GOW_VU1_BENCH_LIST
+#define GOW_VU1_BENCH_LIST ""
+#endif
+
+namespace
+{
+constexpr uint32_t kNop = 0x2ffu, kLowerNop = 0x8000033cu, kE = 1u << 30, kI = 1u << 31;
+constexpr uint32_t X = 8, Y = 4, Z = 2, W = 1, XYZ = 0xE, XYZW = 0xF;
+
+void setEnv(const char *k, const char *v)
+{
+#if defined(_WIN32)
+    _putenv_s(k, v);
+#else
+    setenv(k, v, 1);
+#endif
+}
+
+// ---- encoders (VU1 instruction formats; field names as in the PS2 VU manual)
+uint32_t up(uint32_t op, uint32_t dest, uint32_t ft, uint32_t fs, uint32_t fd) { return op | (dest << 21) | (ft << 16) | (fs << 11) | (fd << 6); }
+uint32_t upA(uint32_t code, uint32_t dest, uint32_t ft, uint32_t fs) { return 0x3Cu | (code & 3u) | ((code >> 2) << 6) | (dest << 21) | (ft << 16) | (fs << 11); }
+uint32_t loSp(uint32_t sp, uint32_t dest, uint32_t ft, uint32_t fs) { return 0x80000000u | (dest << 21) | (ft << 16) | (fs << 11) | ((sp >> 2) << 6) | 0x3Cu | (sp & 3u); }
+uint32_t lo(uint32_t op, uint32_t dest, uint32_t ft, uint32_t fs, int32_t imm11) { return (op << 25) | (dest << 21) | (ft << 16) | (fs << 11) | (static_cast<uint32_t>(imm11) & 0x7FFu); }
+uint32_t iaddiu(uint32_t it, uint32_t is, uint32_t imm) { return (0x08u << 25) | ((imm >> 11) << 21) | (it << 16) | (is << 11) | (imm & 0x7FFu); }
+uint32_t iaddi(uint32_t it, uint32_t is, int32_t imm5) { return (0x40u << 25) | (it << 16) | (is << 11) | ((static_cast<uint32_t>(imm5) & 0x1Fu) << 6) | 0x32u; }
+uint32_t ialu(uint32_t fn, uint32_t id, uint32_t is, uint32_t it) { return (0x40u << 25) | (it << 16) | (is << 11) | (id << 6) | fn; }
+uint32_t br(uint32_t op, uint32_t it, uint32_t is, int32_t off) { return (op << 25) | (it << 16) | (is << 11) | (static_cast<uint32_t>(off) & 0x7FFu); }
+uint32_t divq(uint32_t fs, uint32_t fsf, uint32_t ft, uint32_t ftf) { return loSp(0x38u, (ftf << 2) | fsf, ft, fs); }
+uint32_t fbits(float f) { uint32_t b; std::memcpy(&b, &f, 4); return b; }
+// upper ops
+enum : uint32_t { ADDbc = 0x00, MADDbc = 0x08, MAXbc = 0x10, MULbc = 0x18, MULq = 0x1C, MINIi = 0x1F, ADD = 0x28, MUL = 0x2A, MAX = 0x2B, SUB = 0x2C, MSUB = 0x2D };
+enum : uint32_t { ADDAbc = 0x00, MADDAbc = 0x08, ITOF4 = 0x11, FTOI0 = 0x14, FTOI4 = 0x15, MULAbc = 0x18, CLIP = 0x1F, OPMULA = 0x2E, MULA = 0x2A, ADDA = 0x28 };
+constexpr uint32_t OPMSUB = 0x2E; // upper op 0x2E (vector form)
+enum : uint32_t { LQ = 0x00, SQ = 0x01, ILW = 0x04, ISW = 0x05, FCAND = 0x12, FMEQ = 0x18, FMAND = 0x1A, IBEQ = 0x28, IBNE = 0x29, IBGTZ = 0x2D };
+enum : uint32_t { MR32 = 0x31, LQI = 0x34, SQI = 0x35, WAITQ = 0x3B, MFIR = 0x3D, XGKICK = 0x6C };
+
+using Pairs = std::vector<std::pair<uint32_t, uint32_t>>;
+void endProgram(Pairs &p) { p.push_back({kLowerNop, kNop | kE}); p.push_back({kLowerNop, kNop}); }
+int32_t back(const Pairs &p, size_t loop) { return static_cast<int32_t>(loop) - static_cast<int32_t>(p.size()) - 1; }
+
+struct Program
+{
+    uint32_t pc;
+    const char *name;
+};
+
+// Data layout: qword 0 = header (x: count, integer), inputs from qword 1, outputs from 0x200, constants at 0x300.
+std::vector<uint8_t> microMemory(std::vector<Program> &programs)
+{
+    std::vector<uint8_t> code(PS2_VU1_CODE_SIZE);
+    uint32_t at = 0;
+    const auto place = [&](Pairs &p, const char *name) {
+        programs.push_back({at, name});
+        std::memcpy(code.data() + at, p.data(), p.size() * 8u);
+        at += static_cast<uint32_t>(p.size()) * 8u + 64u;
+    };
+    { // transform: vf10-13 matrix, vf15 screen offset; vi5 count, vi2 in, vi3 out, vi4 kick address
+        Pairs p = {
+            {lo(ILW, X, 5, 0, 0), kNop},
+            {iaddiu(2, 0, 1), kNop},
+            {iaddiu(3, 0, 0x200), kNop},
+            {iaddiu(4, 0, 0x1FF), kNop},
+            {iaddiu(7, 0, 0x20), kNop},
+        };
+        const size_t loop = p.size();
+        Pairs body = {
+            {loSp(LQI, XYZW, 1, 2), kNop},
+            {loSp(LQI, XYZW, 2, 2), upA(MULAbc + 0, XYZW, 1, 10)},
+            {loSp(LQI, XYZW, 3, 2), upA(MADDAbc + 1, XYZW, 1, 11)},
+            {kLowerNop, upA(MADDAbc + 2, XYZW, 1, 12)},
+            {kLowerNop, up(MADDbc + 3, XYZW, 1, 13, 4)},
+            {kLowerNop, upA(CLIP, XYZ, 4, 4)},
+            {divq(0, 3, 4, 3), kNop},
+            {kLowerNop, up(MULbc + 3, XYZW, 0, 3, 3)},          // colour * vf0w (a stand-in for a scale)
+            {loSp(WAITQ, 0, 0, 0), up(ADD, XYZW, 3, 3, 3)},
+            {lo(FCAND, 0, 0, 0, 0) | 0x3Fu, up(MULq, XYZ, 0, 4, 4)},
+            {iaddiu(6, 1, 0), up(MULq, XYZ, 0, 2, 2)},
+            {kLowerNop, up(ADD, XYZ, 15, 4, 4)},
+            {kLowerNop, upA(FTOI4, XYZW, 4, 4)},
+            {kLowerNop, upA(FTOI0, XYZW, 3, 3)},
+            {loSp(SQI, XYZW, 3, 2), kNop},
+            {loSp(SQI, XYZW, 3, 3), kNop},
+            {loSp(SQI, XYZW, 3, 4), kNop},
+            {lo(ISW, W, 6, 3, -1), kNop},
+            {iaddi(5, 5, -1), kNop},
+        };
+        p.insert(p.end(), body.begin(), body.end());
+        p.push_back({br(IBNE, 0, 5, back(p, loop)), kNop});
+        p.push_back({kLowerNop, kNop});
+        p.push_back({loSp(XGKICK, 0, 0, 4), kNop});
+        endProgram(p);
+        place(p, "transform");
+    }
+    { // light: vf16-18 normal matrix, vf19-21 light directions (rows), vf22-24 light colours, vf25 ambient
+        Pairs p = {
+            {lo(ILW, X, 5, 0, 0), kNop},
+            {iaddiu(2, 0, 1), kNop},
+            {iaddiu(3, 0, 0x200), kNop},
+        };
+        const size_t loop = p.size();
+        Pairs body = {
+            {lo(LQ, XYZ, 1, 2, 0), kNop},
+            {kLowerNop, upA(MULAbc + 0, XYZ, 1, 16)},
+            {kLowerNop, upA(MADDAbc + 1, XYZ, 1, 17)},
+            {kLowerNop, up(MADDbc + 2, XYZ, 1, 18, 2)},              // vf2 = normal in view space
+            {kLowerNop, upA(MULAbc + 0, XYZ, 2, 19)},
+            {kLowerNop, upA(MADDAbc + 1, XYZ, 2, 20)},
+            {kLowerNop, up(MADDbc + 2, XYZ, 2, 21, 3)},              // vf3 = three dot products
+            {kLowerNop, up(MAXbc + 0, XYZ, 0, 3, 3)},                // max(dot, 0)
+            {kLowerNop, upA(MULAbc + 0, XYZ, 3, 22)},
+            {kLowerNop, upA(MADDAbc + 1, XYZ, 3, 23)},
+            {kLowerNop, upA(MADDAbc + 2, XYZ, 3, 24)},
+            {kLowerNop, up(MADDbc + 3, XYZ, 0, 25, 4)},              // + ambient * vf0w
+            {fbits(255.0f), up(MINIi, XYZ, 0, 4, 4) | kI},           // I = 255 (I-bit pair), clamp later pairs
+            {kLowerNop, up(MINIi, XYZ, 0, 4, 4)},
+            {kLowerNop, upA(FTOI0, XYZ, 4, 4)},
+            {lo(SQ, XYZ, 4, 3, 0), kNop},
+            {iaddiu(2, 2, 1), kNop},
+            {iaddiu(3, 3, 1), kNop},
+            {iaddi(5, 5, -1), kNop},
+        };
+        p.insert(p.end(), body.begin(), body.end());
+        p.push_back({br(IBGTZ, 0, 5, back(p, loop)), kNop});
+        p.push_back({kLowerNop, kNop});
+        endProgram(p);
+        place(p, "light");
+    }
+    { // skin: bone matrices at 0x300 (4 qwords each), per vertex: position, weights (x, y), bone indices (z, w as ints)
+        Pairs p = {
+            {lo(ILW, X, 5, 0, 0), kNop},
+            {iaddiu(2, 0, 1), kNop},
+            {iaddiu(3, 0, 0x200), kNop},
+        };
+        const size_t loop = p.size();
+        Pairs body = {
+            {lo(LQ, XYZW, 1, 2, 0), kNop},                           // position
+            {lo(LQ, XYZW, 2, 2, 1), kNop},                           // weights
+            {lo(ILW, Z, 6, 2, 1), kNop},                             // bone 0 index
+            {lo(ILW, W, 7, 2, 1), kNop},                             // bone 1 index
