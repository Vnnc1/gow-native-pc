+    {
+        std::mutex mutex;
+        CodeArena arena;
+        std::vector<std::unique_ptr<Block>> blocks;
+        std::unordered_set<uint64_t> failed;
+        std::unordered_map<const void *, Block *> byFn; // block code -> its block (despeculate)
+        uint32_t workingClipOff = 0;
+        unsigned long long compiled = 0, unsupported = 0, codeBytes = 0, nanos = 0, despeculated = 0;
+    };
+    State &state()
+    {
+        static State s;
+        return s;
+    }
+    // GOW_VU1X_SPECULATE=0: compile every block for vf00-only entry lanes (as vu1n_gen.py with no entry analysis)
+    bool speculateEnabled()
+    {
+        static const bool on = [] { const char *v = std::getenv("GOW_VU1X_SPECULATE"); return !(v && v[0] == '0'); }();
+        return on;
+    }
+    bool enabled()
+    {
+        static const bool on = [] {
+            const char *v = std::getenv("GOW_VU1N_X64");
+            const bool e = v && v[0] && v[0] != '0';
+            if (e)
+                std::fprintf(stderr, "[vu1x] x86-64 JIT on (inline tier %s, %s, speculation %s)\n", inlineEnabled() ? "on" : "off",
+                             avxEnabled() ? "AVX" : "SSE4.1", speculateEnabled() ? "on" : "off");
+            return e;
+        }();
+        return on;
+    }
+    // the VF lanes of a state that hold no Inf/NaN bits (exponent != 255), bit r*4 + lane
+    L128 cleanLanes(const VU1State &st)
+    {
+        L128 out;
+        for (uint32_t r = 0; r < 32; ++r)
+            for (uint32_t c = 0; c < 4; ++c)
+            {
+                uint32_t bits;
+                std::memcpy(&bits, &st.vf[r][c], 4);
+                if ((bits & 0x7F800000u) != 0x7F800000u)
+                    out = out | L128::lanes(r, 1u << c);
+            }
+        return out;
+    }
+
+    // translate + emit + register under `key`; the caller holds g.mutex
+    bool build(State &g, uint32_t pc, const uint32_t *words, uint32_t count, uint64_t key, L128 entry)
+    {
+        const auto t0 = std::chrono::steady_clock::now();
+        auto blk = std::make_unique<Block>();
+        blk->imms.reserve(8u * count + 16u);
+        blk->stmts.reserve(8u * count + 16u);
+        if (!translate(pc, words, count, *blk, entry))
+        {
+            g.failed.insert(key);
+            ++g.unsupported;
+            return false;
+        }
+        const std::vector<uint8_t> code = emit(*blk, g.workingClipOff, g.arena.lo(), g.arena.span());
+        void *fn = g.arena.put(code);
+        if (!fn)
+        {
+            g.failed.insert(key);
+            return false;
+        }
+        // GOW_VU1X_DUMP=<dir>: each block's x86 code as <dir>/<pc>_<key>.bin (objdump -D -b binary -mi386:x86-64 to read it)
+        static const char *dumpDir = std::getenv("GOW_VU1X_DUMP");
+        if (dumpDir && *dumpDir)
+        {
+            char name[64];
+            std::snprintf(name, sizeof(name), "/%04x_%016llx%s.bin", pc, static_cast<unsigned long long>(key), blk->speculative ? "_s" : "");
+            if (FILE *f = std::fopen((std::string(dumpDir) + name).c_str(), "wb"))
+            {
+                std::fwrite(code.data(), 1, code.size(), f);
+                std::fclose(f);
+            }
+        }
+        blk->pc = pc, blk->count = count, blk->key = key;
+        if (blk->speculative)
+            blk->words.assign(words, words + count * 2u);
+        vu1nRegisterBlock(key, reinterpret_cast<VU1NativeFn>(fn), count | (blk->readsEntry ? 0x10000u : 0u),
+                          blk->hasTail ? &blk->tail : nullptr, &blk->lanes);
+        g.byFn[fn] = blk.get();
+        g.blocks.push_back(std::move(blk));
+        ++g.compiled;
+        g.codeBytes += code.size();
+        g.nanos += static_cast<unsigned long long>(std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now() - t0).count());
+        return true;
+    }
+
+    // A block without native code: translate, emit, register (key = vu1n::blockKey). False: unsupported (the exact engine
+    // keeps it; remembered so the translation is not tried again). entryState: the VU state the block is about to run
+    // with; its clean VF lanes are the entry assumption (speculation: the code skips nrm() on them, the runtime checks
+    // them on every entry and despeculate() replaces the block when a check fails).
+    bool compile(uint32_t pc, const uint32_t *words, uint32_t count, uint64_t key, uint32_t workingClipOff, const VU1State *entryState)
+    {
+        State &g = state();
+        std::lock_guard<std::mutex> lock(g.mutex);
+        if (g.failed.count(key))
+            return false;
+        g.workingClipOff = workingClipOff;
+        return build(g, pc, words, count, key, entryState && speculateEnabled() ? cleanLanes(*entryState) : L128{});
+    }
+
+    // An entry lane check failed for the block whose code is fn: when it is a speculative JIT block, compile it again for
+    // vf00-only entry lanes (req = 0, never checked) under the same key. True: re-registered (set the slot up again).
+    bool despeculate(const void *fn)
+    {
+        State &g = state();
+        std::lock_guard<std::mutex> lock(g.mutex);
+        const auto it = g.byFn.find(fn);
+        if (it == g.byFn.end() || !it->second->speculative)
+            return false;
+        if (it->second->replaced) // already recompiled (for another interpreter's slot): the registry has the new code
+            return true;
+        Block &old = *it->second;
+        old.replaced = true;
+        ++g.despeculated;
+        const std::vector<uint32_t> words = old.words;
+        return build(g, old.pc, words.data(), old.count, old.key, L128{});
+    }
 }
 
