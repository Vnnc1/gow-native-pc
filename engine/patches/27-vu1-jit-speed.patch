+// gow-native-pc: VU1 backend benchmark (x86-64 JIT against the build's generator code), without game data.
+//
+// A synthetic micro memory holds four programs written like PS2 renderer microcode (the shapes God of War's VU1 code
+// has: unrolled pairs, broadcast matrix multiplies, Q divides, CLIP + FCAND, FTOI/ITOF, LQI/SQI streams, XGKICK):
+//   transform  per vertex: LQI position / ST / colour, MULAx-MADDAy-MADDAz-MADDw matrix, CLIPw, DIV + WAITQ, MULq,
+//              ADD screen offset, FTOI4 / FTOI0, FCAND + ISW of the ADC bit, SQI x3, IBNE loop, XGKICK
+//   light      per vertex: normal matrix, three light dot products (MUL + ADDAy / MADDAz broadcast), MAX with 0,
+//              colour mix (MULAx / MADDAy / MADDz), MINIi clamp (I-bit immediate), FTOI0, SQ with offsets, IBGTZ loop
+//   skin       per vertex: ILW bone index, IADD matrix address, LQ x4 with offsets, MULAx / MADDA weighted blend of two
+//              bones, MR32, MFIR / ITOF4, IADDI / IBNE
+//   cull       per triangle: OPMULA / OPMSUB cross product (exact-engine call-outs in both backends), MUL + ADDA dot,
+//              FMAND / FMEQ on the sign bits, IBEQ skip, SQI, loop
+// Modes (one binary, the same blocks, the same inputs):
+//   vu1_bench exact  [reps]   the exact engine alone (GOW_VU1_NATIVE_OFF)
+//   vu1_bench hybrid [reps]   the game's setup: blocks compiled into this build (vu1n_gen.py, the AOT path) + the x86-64
+//                             JIT for blocks the build lacks (GOW_VU1N_X64)
+//   vu1_bench jit    [reps]   the x86-64 JIT alone (GOW_VU1X_ONLY drops the compiled-in blocks)
+//   vu1_bench --write <file>  the synthetic micro memory (input of the AOT parts, tools/ci/pruebas_vu1.cmake)
+// hybrid and jit must print the same digest (the JIT is bit-identical to the generator's code); "jit/hybrid" in the
+// summary is the JIT's cost against the AOT code on the same programs, the number to drive below 1.0x-ish.
+// With -DGOW_VU1_BENCH_DIR=<folder of 16 KB .bin images> at configure time (e.g. the user's data/<game>/vu1_capture:
+// game-derived, never committed) those images are compiled in too and every program start in them (pc 0, after a zero
+// gap, after an E-bit delay slot) is run with seeded inputs as one more line.
+#include "runtime/ps2_memory.h"
+#include "runtime/ps2_vu1.h"
+#include "runtime/ps2_vu1_native.h"
+#include "runtime/gs/gs_frontend.h"
+#include <algorithm>
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
