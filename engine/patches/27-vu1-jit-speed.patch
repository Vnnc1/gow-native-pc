+    // arena: the reserved code range (lo, span) for the JIT -> JIT jump past the prologue
+    std::vector<uint8_t> emit(const Block &blk, uint32_t workingClipOff, uint64_t arenaLo, uint32_t arenaSpan)
+    {
+        Asm a;
+        // Avoid repeated byte-vector reallocations while emitting a new block.
+        a.c.reserve(256u + blk.stmts.size() * 160u);
+        Ctx cx{a, E{a, avxEnabled()}, {}, workingClipOff};
+        const bool inl = inlineEnabled();
+        emitPrologue(a);
+        std::vector<size_t> toRet;
+        bool branchInline = false;
+        const size_t count = blk.stmts.size();
+        // VF registers each statement reads normalised / may write (for the frame.nv cache, see loadNorm)
+        std::vector<Use> use(count);
+        for (size_t idx = 0; idx < count; ++idx)
+        {
+            const Stmt &st = blk.stmts[idx];
+            const Imm &k = blk.imms[st.imm];
+            Use &u = use[idx];
+            const uint32_t ft = 1u << k.ft;
+            switch (st.inl)
+            {
+            case IN_FMAC:
+                u.ldn = (k.aNorm ? 1u << k.fs : 0u) | (k.bNorm ? ft : 0u);
+                u.writes = k.store && !k.toAcc ? 1u << k.fd : 0u;
+                break;
+            case IN_CLIP: u.ldn = (1u << k.fs) | ft; break;
+            case IN_FTOI: case IN_ABS: u.ldn = 1u << k.fs; u.writes = ft; break;
+            case IN_ITOF: case IN_MOVE: case IN_LQ: case IN_LQI: u.writes = ft; break;
+            case IN_SPECIAL: u.writes = (k.op == 0x31 || k.op == 0x36 || k.op == 0x3D || k.op == 0x64) ? ft : 0u; break;
+            case IN_SQ: case IN_SQI: case IN_ILW: case IN_ISW: case IN_IADDIU: case IN_ISUBIU: case IN_IADDI: case IN_IADD:
+            case IN_ISUB: case IN_IAND: case IN_IOR: case IN_ISET: case IN_FLAG: case IN_BACKUP: case IN_BRANCH: case IN_HALT:
+            case IN_TAILQ: case IN_TAILC: case IN_PUSHMAC: case IN_PUSHCLIP: case IN_NEXT:
+                break;
+            default: u.writes = ~0u; break; // a helper: anything
+            }
+        }
+        cx.use = &use;
+        for (size_t idx = 0; idx < count; ++idx)
+        {
+            const Stmt &st = blk.stmts[idx];
+            const Imm &k = blk.imms[st.imm];
+            cx.idx = idx;
+            if (inl)
+            {
+                if (st.inl == IN_NEXT) // r13d = next pc: set by the branch, else the block end
+                {
+                    if (!branchInline)
+                        cx.e.movi32(R13, k.endPc);
+                    continue;
+                }
+                if (st.inl == IN_HALT) // D/T exit: only when enabled, through the helper (flushes the flags, returns the end)
+                {
+                    cx.e.movzx8(RAX, stM(k.flagT ? offsetof(VU1State, tBitEnabled) : offsetof(VU1State, dBitEnabled)));
+                    a.testEaxEax();
+                    const size_t skip = a.jcc(CC_Z);
+                    emitCallHelper(a, st.fn, k);
+                    toRet.push_back(a.jmp());
+                    a.patch(skip, a.c.size());
+                    continue;
+                }
+                if (st.inl != IN_NONE && emitInline(cx, k, st.inl))
+                {
+                    branchInline |= st.inl == IN_BRANCH;
+                    cx.cached &= ~use[idx].writes;
+                    continue;
+                }
+            }
+            cx.cached = 0u; // a helper may write any VF register
+            emitCallHelper(a, st.fn, k);
+            if (st.exitIfNonZero)
+            {
+                a.testEaxEax();
+                toRet.push_back(a.jcc(CC_NZ));
+            }
+            if (st.inl == IN_NEXT)
+                a.movRR32(R13, RAX); // hNext's result
+        }
+        const auto epilogue = [&] {
+            a.addRsp(kStackBytes + 8u);
+            a.pop(R15); a.pop(R14); a.pop(R13); a.pop(R12); a.pop(RBP); a.pop(RBX);
+        };
+        if (blk.ebit)
+            a.movEaxImm(kVu1nEnded | blk.endPc);
+        else
+        {
+            // r13d = next pc; the next block's code when chain() allows it, as a tail jump
+            a.movRR(kArg0, RBX);
+            a.movRR32(kArg1, R13);
+            a.call(reinterpret_cast<const void *>(&VU1NativeAccess::chainFn));
+            a.testRaxRax();
+            const size_t noChain = a.jcc(CC_Z);
+            if (arenaSpan)
+            {
+                // JIT code (in the reserved range): the same frame, ctx, VU state, data and constants; skip its prologue
+                a.movRR(RCX, RAX);
+                a.movRI64(RDX, arenaLo);
+                a.b(0x48); a.b(0x29); a.b(0xD1);                                  // sub rcx, rdx
+                a.b(0x48); a.b(0x81); a.modrm(3, 7, RCX); a.d32(arenaSpan);       // cmp rcx, span
+                const size_t other = a.jcc(0x3);                                  // jae: not JIT code
+                a.b(0x48); a.b(0x05); a.d32(prologueSize());                      // add rax, prologue
+                a.jmpR(RAX);
+                a.patch(other, a.c.size());
+            }
+            a.movRR(kArg0, RBX);
+            epilogue();
+            a.jmpR(RAX);
+            a.patch(noChain, a.c.size());
+            a.movRR32(RAX, R13);
+            a.orEaxImm(kVu1nDone);
+        }
+        const size_t ret = a.c.size();
+        for (size_t at : toRet)
+            a.patch(at, ret);
+        epilogue();
+        a.b(0xC3);
+        for (const Cold &c : cx.cold)
+        {
+            a.patch(c.from, a.c.size());
+            emitCallHelper(a, c.fn, *c.k);
+            a.patch(a.jmp(), c.resume);
+        }
+        return a.c;
+    }
