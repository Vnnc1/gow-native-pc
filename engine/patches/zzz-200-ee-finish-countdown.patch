     }
     // ---- end EE timer 2 ----
 
+    // Only the register-only countdown is folded. Keep its final decrement, GS flag
+    // load, guest calls and every non-quiet checkpoint in the generated reference.
+    void gowFinishCountdown(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        if (ctx->pc == 0x0017A328u)
+            SET_GPR_S32(ctx, 2, static_cast<int32_t>(GPR_U32(ctx, 2)));
+        while (GPR_U32(ctx, 2) > 1u)
+        {
+            const uint32_t count = GPR_U32(ctx, 2);
+            const uint64_t folded = runtime->eeScheduler().advanceQuietRepeated(32u, count - 1u);
+            SET_GPR_S32(ctx, 2, static_cast<int32_t>(count - (folded ? folded : 1u)));
+            ctx->pc = 0x0017A32Cu;
+            if (!folded && !runtime->eeCheckpointQuiet(32u) && runtime->eeCheckpointFull(32u))
+                return;
+        }
+        // Includes the zero/wraparound case, which deliberately keeps the reference.
+        sub_0017A2A0_0x17a2a0(rdram, ctx, runtime);
+    }
+
     void applyGowOverrides(PS2Runtime &runtime)
     {
+        const char *finishWait = std::getenv("GOW_FINISH_COUNTDOWN");
+        // Preserve the older, explicitly selected real-time sleep experiment.
+        const char *sleepWait = std::getenv("GOW_ESPERA_EE");
+        const bool foldFinishWait = finishWait && std::strcmp(finishWait, "1") == 0 &&
+                                    !(sleepWait && sleepWait[0] == '1');
+        std::fprintf(stderr, "[gow-finish-wait] countdown=%u\n", foldFinishWait ? 1u : 0u);
+        if (foldFinishWait)
+        {
+            runtime.replaceFunction(0x0017A328u, gowFinishCountdown);
+            runtime.replaceFunction(0x0017A32Cu, gowFinishCountdown);
+        }
