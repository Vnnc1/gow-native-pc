+
+    // gow-native-pc (patch 90): one expansion of a run primitive into the per-primitive batch layout. The
+    // per-primitive Submit path and the GsInventory path must see exactly the same vertices (and the same
+    // zero-filled tail the Op::Run encoder writes), so both call this.
+    void fillRunPrimitive(const GSVertex *source, uint8_t vc, GSPrimitiveBatch &batch)
+    {
+        batch.vertexCount = vc;
+        for (uint8_t v = 0; v < vc; ++v)
+            batch.vertices[v] = source[v];
+        for (uint8_t v = vc; v < 3u; ++v)
+            batch.vertices[v] = GSVertex{};
+    }
 }
 
