+bool gowMenuBind(const char *action, int code, bool pad) {
+    size_t a=0; while(a<NumAcciones && std::strcmp(action,kNombresAccion[a])) ++a;
+    if(a==NumAcciones || (pad && (a>AccFuria || code<0 || code>17 || code==14)) ||
+       (!pad && code!=0 && !((code>=32 && code<=348) || (code>=1000 && code<=1006)))) return false;
+    if(pad) {
+        auto m=std::make_shared<MapaMando>(*mapaMando());
+        if(!m->activo) for(size_t i=0;i<=AccFuria;++i) {
+            int b=tobiichiBotonMandoAccion(kNombresAccion[i]); if(b>0) m->botones[i]={b};
+        }
+        m->activo=true; m->botones[a].clear(); if(code) m->botones[a].push_back(code);
