 # GOW-Port include
 target_include_directories(ps2EntryRunner PRIVATE ${CMAKE_CURRENT_SOURCE_DIR}/src/runner)
+
+# Profile-owned, immutable artwork embedded into the runner (no runtime path dependency).
+set(GOW_BRAND_IMAGE "" CACHE FILEPATH "Startup artwork supplied by the game profile")
+set(GOW_BRAND_CPP "${CMAKE_CURRENT_BINARY_DIR}/gow_brand_image.cpp")
+if(GOW_BRAND_IMAGE)
+    if(NOT EXISTS "${GOW_BRAND_IMAGE}")
+        message(FATAL_ERROR "Missing profile branding image: ${GOW_BRAND_IMAGE}")
+    endif()
+    file(READ "${GOW_BRAND_IMAGE}" GOW_BRAND_HEX HEX)
+    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," GOW_BRAND_BYTES "${GOW_BRAND_HEX}")
+    set(GOW_BRAND_CONTENT "#include <cstddef>\nextern const unsigned char gowBrandImage[] = {${GOW_BRAND_BYTES}};\nextern const std::size_t gowBrandImageSize = sizeof(gowBrandImage);\n")
+    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${GOW_BRAND_IMAGE}")
+else()
+    set(GOW_BRAND_CONTENT "#include <cstddef>\nextern const unsigned char gowBrandImage[] = {0};\nextern const std::size_t gowBrandImageSize = 0;\n")
+endif()
+file(CONFIGURE OUTPUT "${GOW_BRAND_CPP}" CONTENT "${GOW_BRAND_CONTENT}" @ONLY)
+target_sources(ps2_runtime PRIVATE "${GOW_BRAND_CPP}")
diff --git a/PS2Recomp/ps2xRuntime/include/runtime/gow_brand.h b/PS2Recomp/ps2xRuntime/include/runtime/gow_brand.h
new file mode 100644
--- /dev/null
+++ b/PS2Recomp/ps2xRuntime/include/runtime/gow_brand.h
@@ -0,0 +1,65 @@
+#pragma once
+#include "raylib.h"
+#include <algorithm>
+#include <atomic>
+#include <cmath>
+#include <cstddef>
+#include <cstdint>
+
+extern const unsigned char gowBrandImage[];
+extern const std::size_t gowBrandImageSize;
+namespace gow_brand {
+constexpr float duration = 4.1f;
+inline std::atomic<bool> inputGuard{false};
+inline uint32_t noise(uint32_t x) { x ^= x >> 16; x *= 0x7feb352dU; x ^= x >> 15; x *= 0x846ca68bU; return x ^ (x >> 16); }
+inline float progress(float time) { return std::clamp((time - .25f) / 2.35f, 0.f, 1.f); }
+inline void draw(Texture2D image, float time, int width, int height) {
+    ClearBackground(BLACK);
+    if (!image.id) return;
+    const float scale = std::min(height * .82f / image.height, width * .65f / image.width);
+    const float w = image.width * scale, h = image.height * scale;
+    const float x = (width-w)*.5f, y = (height-h)*.5f;
+    const float p = progress(time);
+    const float opacity = std::clamp((duration-time)/.45f, 0.f, 1.f);
+    // Reveal the original pixels in irregular vertical spray passes; never recolor the artwork.
+    for (int col=0; col<image.width; col+=8) {
+        const float jitter = (noise(col+19)%1000)/1000.f;
+        const float edge = std::clamp(p*1.12f - jitter*.12f, 0.f, 1.f)*image.height;
+        if (edge <= 0) continue;
+        const float cw = float(std::min(8, image.width-col));
+        DrawTexturePro(image, Rectangle{float(col),0,cw,edge},
+                       Rectangle{x+col*scale,y,cw*scale,edge*scale}, Vector2{},0,Fade(WHITE,opacity));
+    }
+    if (p>0 && p<1) {
+        const int tick = int(time*30);
+        for (int i=0; i<90; ++i) {
+            const uint32_t n = noise(uint32_t(i+tick*101));
+            const float px = x+w*(n%1000)/1000.f;
+            const float py = y+h*p + float(int((n>>10)%51)-25)*scale;
+            DrawCircleV(Vector2{px,py}, (.35f+float((n>>19)%3)*.35f)*std::max(.6f,scale),
+                        Fade(Color{236,228,208,255}, .12f*opacity));
+        }
+    }
+}
+inline Texture2D load() {
+    if (!gowBrandImageSize || gowBrandImageSize > 8*1024*1024) return {};
+    Image image = LoadImageFromMemory(".png",gowBrandImage,int(gowBrandImageSize));
+    Texture2D texture{};
+    if (image.data) { texture=LoadTextureFromImage(image); UnloadImage(image); }
+    return texture;
+}
+inline void startup() {
+    Texture2D texture=load();
+    if (!texture.id) return;
+    const double begin=GetTime();
+    SetTargetFPS(60);
+    while (!WindowShouldClose() && GetTime()-begin<duration) {
+        bool skip=IsKeyPressed(KEY_ENTER)||IsKeyPressed(KEY_SPACE)||IsKeyPressed(KEY_ESCAPE);
+        for (int p=0;p<4;++p) if (IsGamepadAvailable(p))
+            skip |= IsGamepadButtonPressed(p,GAMEPAD_BUTTON_RIGHT_FACE_DOWN)||IsGamepadButtonPressed(p,GAMEPAD_BUTTON_MIDDLE_RIGHT);
+        if (skip) { inputGuard.store(true); break; }
+        BeginDrawing(); draw(texture,float(GetTime()-begin),GetScreenWidth(),GetScreenHeight()); EndDrawing();
+    }
+    UnloadTexture(texture);
+}
+}
