+#pragma once
+#include <atomic>
+#include <algorithm>
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+namespace gow_menu_live {
+inline std::atomic<int> volume{100};
+inline std::atomic<bool> mute{false};
+inline std::atomic<bool>& autoQte() {
+    static std::atomic<bool> enabled{[] { const char *v=std::getenv("GOW_QTE_AUTO"); return v && !std::strcmp(v,"1"); }()};
+    return enabled;
+}
+inline void applyVolume(int16_t *samples, size_t count) {
+    const int gain=mute.load(std::memory_order_relaxed)?0:std::clamp(volume.load(std::memory_order_relaxed),0,100);
+    if(gain==100) return;
+    for(size_t i=0;i<count;++i) samples[i]=int16_t(int(samples[i])*gain/100);
+}
+}
+bool gowMenuBind(const char *action,int code,bool pad);
+void gowMenuResetBindings();
