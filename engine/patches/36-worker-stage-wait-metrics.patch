Separate opt-in worker and GS-stage wait metrics, including stage-only stalls. Snapshot settings per memory instance and bound counters to three sites. No wait ordering or DMA behavior change; procedural worker/stage tests cover the contract.

diff --git a/PS2Recomp/ps2xRuntime/include/runtime/gow_sync_metrics.h b/PS2Recomp/ps2xRuntime/include/runtime/gow_sync_metrics.h
new file mode 100644
--- /dev/null
+++ b/PS2Recomp/ps2xRuntime/include/runtime/gow_sync_metrics.h
@@ -0,0 +1,66 @@
+#pragma once
+// Bounded, opt-in wall-time diagnostics. CPU/GPU utilization cannot be inferred from these waits.
+#include <array>
+#include <algorithm>
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <mutex>
+#include <cstdint>
+
+class GowSyncMetrics
+{
+public:
+    struct Entry {
+        uint64_t calls = 0, workerWaits = 0, stageWaits = 0, workerNs = 0, stageNs = 0, queuePeak = 0;
+    };
+    // Site 0: large VIF1 barrier; 1: MMIO; 2: other explicit synchronizations.
+    static constexpr unsigned Sites = 3;
+    const bool enabled = [] {
+        const char *v = std::getenv("GOW_SYNC_DIAG");
+        if (!v) v = std::getenv("PS2X_GS_WORKER_DIAG");
+        return v && v[0] == '1';
+    }();
+    void add(unsigned site, bool worker, bool stage, uint64_t workerNs, uint64_t stageNs, size_t queue)
+    {
+        if (!enabled || site >= Sites) return;
+        std::lock_guard<std::mutex> lock(m_mutex);
+        for (auto *table : {&m_total, &m_window}) {
+            auto &e = (*table)[site];
+            ++e.calls; e.workerWaits += worker; e.stageWaits += stage;
+            e.workerNs += workerNs; e.stageNs += stageNs;
+            e.queuePeak = std::max(e.queuePeak, static_cast<uint64_t>(queue));
+        }
+        const auto now = Clock::now();
+        if (now - m_start >= std::chrono::seconds(5)) emit(now, false);
+    }
+    std::array<Entry, Sites> snapshot() const
+    {
+        std::lock_guard<std::mutex> lock(m_mutex);
+        return m_total;
+    }
+    void flush()
+    {
+        if (!enabled) return;
+        std::lock_guard<std::mutex> lock(m_mutex);
+        emit(Clock::now(), true);
+    }
+private:
+    using Clock = std::chrono::steady_clock;
+    mutable std::mutex m_mutex;
+    std::array<Entry, Sites> m_total{}, m_window{};
+    Clock::time_point m_start = Clock::now();
+    void emit(Clock::time_point now, bool final)
+    {
+        const double seconds = std::chrono::duration<double>(now - m_start).count();
+        for (unsigned site = 0; site < Sites; ++site) {
+            const auto &e = m_window[site];
+            if (e.calls) std::fprintf(stderr,
+                "[gow-sync] site=%u window=%.6f syncs=%llu worker_waits=%llu stage_waits=%llu worker_ms=%.6f stage_ms=%.6f queue_peak=%llu final=%u\n",
+                site, seconds, (unsigned long long)e.calls, (unsigned long long)e.workerWaits,
+                (unsigned long long)e.stageWaits, e.workerNs / 1e6, e.stageNs / 1e6,
+                (unsigned long long)e.queuePeak, unsigned(final));
+        }
+        m_window = {}; m_start = now;
+    }
+};
