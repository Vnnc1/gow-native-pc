 namespace gow_qte
 {
+    // Explicit keyboard/mouse gesture: only overrides the left stick while held.
+    // Time-based phase makes repeated reads in one frame identical.
+    enum class StickMode { Off, Shake, Rotate };
+    class StickGesture
+    {
+    public:
+        bool apply(StickMode mode, bool held, double now, uint8_t &x, uint8_t &y)
+        {
+            if (!held || mode == StickMode::Off || !std::isfinite(now))
+            {
+                m_active = false;
+                return false;
+            }
+            if (!m_active || now < m_since)
+            {
+                m_since = now;
+                m_active = true;
+            }
+            const double elapsed = now - m_since;
+            if (mode == StickMode::Shake)
+            {
+                x = std::fmod(elapsed, 0.25) < 0.125 ? 1 : 255;
+                y = 128;
+            }
+            else
+            {
+                const double angle = std::fmod(elapsed, 0.5) * 12.566370614359172;
+                x = static_cast<uint8_t>(std::lround(128.0 + 127.0 * std::cos(angle)));
+                y = static_cast<uint8_t>(std::lround(128.0 + 127.0 * std::sin(angle)));
+            }
+            return true;
+        }
+    private:
+        bool m_active = false;
+        double m_since = 0.0;
+    };
+
     struct Config
     {
         uint16_t buttons = 0u;  // the pad's button bits the assist repeats (PAD_CIRCLE...), 0 = off
