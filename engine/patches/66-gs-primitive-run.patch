+    virtual void SubmitRun(const GSDrawState &state, const GSVertex *vertices, const uint8_t *counts, uint32_t primCount)
+    {
+        GSPrimitiveBatch batch{};
+        batch.state = state;
+        for (uint32_t i = 0; i < primCount; ++i)
+        {
+            const uint8_t n = static_cast<uint8_t>(std::min<uint32_t>(counts[i], 3u));
+            batch.vertexCount = n;
+            for (uint8_t v = 0; v < n; ++v)
+                batch.vertices[v] = vertices[static_cast<size_t>(i) * 3u + v];
