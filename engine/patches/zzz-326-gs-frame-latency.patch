@@ -0,0 +1,91 @@
+#pragma once
+// GOW-Port (zzz-326): limita los cuadros del GS que la GPU tiene pendientes.
+//
+// El contexto del trabajador del GS nunca hace SwapBuffers, así que el límite de "cuadros prerenderizados" del
+// controlador no se aplica a él. Lo único que frenaba al trabajador era el anillo de vértices (4 segmentos de 8 MiB),
+// cuya espera usa una valla de hace tres segmentos: en una GPU saturada la cola llegaba a decenas de cuadros y el
+// trabajador se bloqueaba de golpe al dar la vuelta (tirones con el contador de FPS todavía en 45-60, issue 31).
+//
+// Al cerrar cada cuadro se pone una valla; si quedan más de `limit` cuadros sin completar, se espera a la más antigua
+// con un tiempo máximo. Las vallas solo marcan el ritmo: ningún recurso depende de ellas, de modo que un tiempo
+// agotado o una valla que no se pudo crear siguen adelante sin glFinish. limit 0 = desactivado (referencia).
+#include <array>
+#include <cstddef>
+
+template <class Fence>
+class GSFrameLatency
+{
+public:
+    static constexpr unsigned kCapacity = 8u;
+    static constexpr unsigned kMaxLimit = kCapacity - 1u;
+
+    struct Result
+    {
+        unsigned waits = 0;    // cuadros que hubo que esperar (la GPU iba por detrás)
+        unsigned timeouts = 0; // esperas que agotaron el tiempo (se siguió sin bloquear más)
+    };
+
+    static unsigned clampLimit(long value)
+    {
+        if (value <= 0)
+            return 0u;
+        return value > static_cast<long>(kMaxLimit) ? kMaxLimit : static_cast<unsigned>(value);
+    }
+
+    // poll(f): true si la GPU ya la completó (sin esperar). wait(f): espera acotada, true si se completó.
+    template <class Create, class Poll, class Wait, class Destroy>
+    Result endFrame(unsigned limit, Create create, Poll poll, Wait wait, Destroy destroy)
+    {
+        Result result;
+        if (limit == 0u)
+        {
+            clear(destroy);
+            return result;
+        }
+        if (limit > kMaxLimit)
+            limit = kMaxLimit;
+        while (m_count && poll(front()))
+            pop(destroy);
+        Fence fence = create();
+        if (!fence)
+            return result; // sin valla no hay ritmo que medir: el cuadro sigue como sin el límite
+        if (m_count == kCapacity)
+            pop(destroy); // no ocurre con limit <= kMaxLimit; protege el anillo
+        m_fences[(m_head + m_count) % kCapacity] = fence;
+        ++m_count;
+        while (m_count > limit)
+        {
+            ++result.waits;
+            if (!wait(front()))
+                ++result.timeouts;
+            pop(destroy);
+        }
+        return result;
+    }
+
+    template <class Destroy>
+    void clear(Destroy destroy)
+    {
+        while (m_count)
+            pop(destroy);
+        m_head = 0u;
+    }
+
+    unsigned pending() const { return m_count; }
+
+private:
+    Fence &front() { return m_fences[m_head]; }
+
+    template <class Destroy>
+    void pop(Destroy destroy)
+    {
+        destroy(m_fences[m_head]);
+        m_fences[m_head] = Fence{};
+        m_head = (m_head + 1u) % kCapacity;
+        --m_count;
+    }
+
+    std::array<Fence, kCapacity> m_fences{};
+    unsigned m_head = 0u;
+    unsigned m_count = 0u;
+};
