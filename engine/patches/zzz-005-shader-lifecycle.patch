+++ b/PS2Recomp/ps2xRuntime/src/lib/gs/gpu/gs_shader_program.h
@@ -0,0 +1,54 @@
+#pragma once
+
+#include "gs_gl.h"
+#include <cstdio>
+#include <initializer_list>
+
+namespace GSGL
+{
+// Own temporary shaders; expose only a successfully linked program to callers.
+inline GLuint BuildRasterProgram(const Api &g, std::initializer_list<const char *> vertex,
+                                 std::initializer_list<const char *> fragment)
+{
+    const auto compile = [&](GLenum type, std::initializer_list<const char *> source) {
+        const GLuint shader = g.CreateShader(type);
+        if (!shader) return GLuint{0};
+        g.ShaderSource(shader, static_cast<GLsizei>(source.size()), source.begin(), nullptr);
+        g.CompileShader(shader);
+        GLint ok = 0;
+        g.GetShaderiv(shader, kCompileStatus, &ok);
+        if (!ok)
+        {
+            char log[2048]{};
+            g.GetShaderInfoLog(shader, sizeof(log), nullptr, log);
+            std::fprintf(stderr, "[gs-hw] shader error: %s\n", log);
+            g.DeleteShader(shader);
+            return GLuint{0};
+        }
+        return shader;
+    };
+    const GLuint v = compile(kVertexShader, vertex);
+    if (!v) return 0;
+    const GLuint f = compile(kFragmentShader, fragment);
+    if (!f) { g.DeleteShader(v); return 0; }
+    const GLuint program = g.CreateProgram();
+    GLint ok = 0;
+    if (program)
+    {
+        g.AttachShader(program, v);
+        g.AttachShader(program, f);
+        g.LinkProgram(program);
+        g.GetProgramiv(program, kLinkStatus, &ok);
+        if (!ok)
+        {
+            char log[2048]{};
+            g.GetProgramInfoLog(program, sizeof(log), nullptr, log);
+            std::fprintf(stderr, "[gs-hw] link error: %s\n", log);
+            g.DeleteProgram(program);
+        }
+    }
+    g.DeleteShader(v);
+    g.DeleteShader(f);
+    return ok ? program : 0;
+}
+}
