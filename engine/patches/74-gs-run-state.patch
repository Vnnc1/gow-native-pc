+// gow-native-pc (patch 74): the GS frontend coalesces primitives that share one draw state into a run (patch 66). Every
+// primitive of the run therefore carries the same state as the one before it, and the worker only has to compare the
+// run's state with the pending batch once, on the first primitive. The per-primitive results are unchanged: the first
+// submit still does the full comparison and flushes when it differs.
+void GSHwBackend::SubmitRun(const GSDrawState &state, const GSVertex *vertices, const uint8_t *counts, uint32_t primCount)
+{
+    static const bool runFast = []
+    {
+        const char *v = std::getenv("PS2X_GS_RUN_STATE_FAST");
+        return !(v && *v == '0');
+    }();
+    if (!runFast)
+    {
+        GSRasterBackend::SubmitRun(state, vertices, counts, primCount);
+        return;
+    }
+    Impl &d = *m_impl;
+    if (!d.ensure())
+        return;
+    GSPrimitiveBatch batch{};
+    batch.state = state;
+    for (uint32_t i = 0; i < primCount; ++i)
+    {
+        const uint8_t n = static_cast<uint8_t>(std::min<uint32_t>(counts[i], 3u));
+        if (n == 0u)
+            continue;
+        batch.vertexCount = n;
+        for (uint8_t v = 0; v < n; ++v)
+            batch.vertices[v] = vertices[static_cast<size_t>(i) * 3u + v];
+        d.submit(batch, i != 0u);
+    }
+}
