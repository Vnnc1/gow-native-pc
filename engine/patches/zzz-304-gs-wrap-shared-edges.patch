                     for (size_t j = 0; j < groupSize && !touches; ++j)
-                        touches = r0 <= rects[j][1] && rects[j][0] <= r1 && r2 <= rects[j][3] && rects[j][2] <= r3;
+                        touches = r0 <= rects[j][1] && rects[j][0] <= r1 && r2 <= rects[j][3] && rects[j][2] <= r3 &&
