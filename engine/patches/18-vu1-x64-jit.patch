+            return src.isClip ? f->c[src.farJ] : f->m[src.farJ];
+        return src.isClip ? VU1NativeAccess::clipAt(*n, n->cyc[src.i]) : VU1NativeAccess::macAt(*n, n->cyc[src.i]);
+    }
