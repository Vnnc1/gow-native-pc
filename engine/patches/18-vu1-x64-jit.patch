+        void movRR32(int dst, int src) { rex(false, src, dst); b(0x89); modrm(3, src, dst); }
+        void movRI64(int r, uint64_t v) { rex(true, 0, r); b(static_cast<uint8_t>(0xB8 + (r & 7))); q64(v); }
+        void movRM(int dst, int base, int32_t disp) { rex(true, dst, base); b(0x8B); mem(dst, base, disp); }
