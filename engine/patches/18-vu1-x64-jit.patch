@@ -0,0 +1,294 @@
+// gow-native-pc: random-program test of the VU1 native backends, without game data. Random micro memories (programs
+// of valid VU instructions: every FMAC / accumulator / conversion form, CLIP, loads and stores, integer ALU, Q-unit,
+// flag ops, EFU and other exact-engine call-outs, I-bit immediates, relative branches and loops, D/T bits) run with
+// random registers and VU memory. Each run's native result goes into a digest:
+//   vu1_x64_fuzz_test x64 [images] [trials]       in-process x86-64 JIT (GOW_VU1N_X64)
+//   vu1_x64_fuzz_test x64-calls [images] [trials] the same with the inline tier off (GOW_VU1X_INLINE=0)
+//   vu1_x64_fuzz_test exact [images] [trials]     the exact engine alone (compares platforms / compilers)
+//   vu1_x64_fuzz_test module <work dir> <vu1n_gen.py> <python> <clang++> "<flags>" [images] [trials]
+//                                                  background compiler: vu1n_gen.py's code built by clang
+// The digests must be equal: the JIT then runs exactly the code the build's generator writes. Same seed, same programs;
+// the first pass over each image is left out (the background compiler needs it to see the code). No JR / JALR: their
+// targets are not block heads the generator knows, so the two backends would legitimately cover different blocks.
+#include "runtime/ps2_memory.h"
+#include "runtime/ps2_vu1.h"
+#include "runtime/ps2_vu1_native.h"
+#include "runtime/gs/gs_frontend.h"
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <random>
+#include <string>
+#include <vector>
+
+void vu1nJitWaitIdle();
+#if defined(__x86_64__) || defined(_M_X64)
+void vu1xStats(unsigned long long &compiled, unsigned long long &unsupported, unsigned long long &codeBytes, unsigned long long &nanos);
+#endif
+
+namespace
+{
+constexpr uint32_t kNop = 0x2ffu, kLowerNop = 0x8000033cu, kE = 1u << 30, kD = 1u << 28, kT = 1u << 27, kI = 1u << 31;
+
+void setEnv(const char *k, const char *v)
+{
+#if defined(_WIN32)
+    _putenv_s(k, v);
+#else
+    setenv(k, v, 1);
+#endif
+}
+
+struct Gen
+{
+    std::mt19937 &r;
+    explicit Gen(std::mt19937 &rng) : r(rng) {}
+    uint32_t u(uint32_t n) { return r() % n; }
+    uint32_t vf() { return u(9); }           // vf0..vf8
+    uint32_t vi() { return u(8); }           // vi0..vi7
+    uint32_t dest() { const uint32_t d[] = {0xF, 0xF, 0xE, 0x8, 0x1, 0x9, 0x6, 0x3}; return d[u(8)]; }
+    uint32_t upper()
+    {
+        const uint32_t d = dest(), ft = vf(), fs = vf(), fd = vf();
+        switch (u(10))
+        {
+        case 0: return kNop;
+        case 1: // accumulator / special forms: ACC ops, ITOF/FTOI, ABS, CLIP, OPMULA, NOP
+        {
+            static const uint32_t codes[] = {0x00, 0x01, 0x02, 0x03, 0x04, 0x07, 0x08, 0x0A, 0x0C, 0x0F, 0x10, 0x11, 0x12, 0x13,
+                                             0x14, 0x15, 0x16, 0x17, 0x18, 0x1B, 0x1C, 0x1D, 0x1E, 0x1F, 0x20, 0x21, 0x22, 0x23,
+                                             0x24, 0x25, 0x26, 0x27, 0x28, 0x29, 0x2A, 0x2C, 0x2D, 0x2E, 0x2F};
+            const uint32_t c = codes[u(sizeof(codes) / 4)];
+            const uint32_t dd = c == 0x1F ? 0xE : d; // CLIP is always xyz
+            return 0x3Cu | (c & 3u) | ((c >> 2) << 6) | (dd << 21) | (ft << 16) | (fs << 11);
+        }
+        default: // the 0x00-0x2F FMAC forms (broadcast, Q, I, vector, MADD/MSUB, MAX/MINI, OPMSUB)
+            return u(0x30) | (d << 21) | (ft << 16) | (fs << 11) | (fd << 6);
+        }
+    }
+    uint32_t sp(uint32_t code, uint32_t d, uint32_t ft, uint32_t fs)
+    {
+        return 0x80000000u | (d << 21) | (ft << 16) | (fs << 11) | ((code >> 2) << 6) | 0x3Cu | (code & 3u);
+    }
+    uint32_t lower()
+    {
+        const uint32_t d = dest(), ft = vf(), fs = vf(), it = vi(), is = vi(), id = vi();
+        const uint32_t imm11 = u(32) & 0x7FFu;
+        switch (u(30))
+        {
+        case 0: case 1: return kLowerNop;
+        case 2: return (0x00u << 25) | (d << 21) | (ft << 16) | (is << 11) | imm11;           // LQ
+        case 3: return (0x01u << 25) | (d << 21) | (it << 16) | (fs << 11) | imm11;           // SQ
+        case 4: return (0x04u << 25) | (d << 21) | (it << 16) | (is << 11) | imm11;           // ILW
+        case 5: return (0x05u << 25) | (d << 21) | (it << 16) | (is << 11) | imm11;           // ISW
+        case 6: case 7: { const uint32_t imm = u(64); return ((u(2) ? 0x08u : 0x09u) << 25) | ((imm >> 11) << 21) | (it << 16) | (is << 11) | (imm & 0x7FFu); }
+        case 8: { static const uint32_t fn[] = {0x30, 0x31, 0x34, 0x35}; return (0x40u << 25) | (it << 16) | (is << 11) | (id << 6) | fn[u(4)]; }
+        case 9: return (0x40u << 25) | (it << 16) | (is << 11) | ((u(32) & 0x1Fu) << 6) | 0x32u;  // IADDI
+        case 10: return sp(0x30, d, ft, fs);                                                   // MOVE
+        case 11: return sp(0x31, d, ft, fs);                                                   // MR32
+        case 12: return sp(0x34, d, ft, is);                                                   // LQI
+        case 13: return sp(0x35, d, it, fs);                                                   // SQI
+        case 14: return sp(0x36, d, ft, is);                                                   // LQD
+        case 15: return sp(0x37, d, it, fs);                                                   // SQD
+        case 16: return sp(0x38, (u(4) << 2) | u(4), ft, fs);                                  // DIV (fsf / ftf in the DEST bits)
+        case 17: return sp(0x39, u(4) << 2, ft, 0);                                            // SQRT
+        case 18: return sp(0x3A, (u(4) << 2) | u(4), ft, fs);                                  // RSQRT
+        case 19: return sp(0x3B, 0, 0, 0);                                                     // WAITQ
+        case 20: return sp(0x3C, u(4), it, fs);                                                // MTIR
+        case 21: return sp(0x3D, d, ft, is);                                                   // MFIR
+        case 22: return sp(u(2) ? 0x3E : 0x3F, d, it, is);                                    // ILWR / ISWR
+        case 23: return sp(0x64, d, ft, 0);                                                    // MFP
+        case 24: return sp(u(2) ? 0x68 : 0x69, 0, it, 0);                                     // XTOP / XITOP
+        case 25: { static const uint32_t ops[] = {0x10, 0x11, 0x12, 0x13}; return (ops[u(4)] << 25) | (r() & 0xFFFFFFu); } // FC*
+        case 26: return (0x1Cu << 25) | (it << 16);                                           // FCGET
+        case 27: { static const uint32_t ops[] = {0x18, 0x1A, 0x1B}; return (ops[u(3)] << 25) | (it << 16) | (is << 11); } // FM*
+        case 28: return (0x16u << 25) | (it << 16) | (r() & 0xFFFu);                          // FSAND (exact-engine call-out)
+        default: return sp(u(2) ? 0x70 : 0x7B, 0, 0, fs);                                     // ESADD / WAITP (call-outs)
+        }
+    }
+    float flt()
+    {
+        switch (u(6))
+        {
+        case 0: return 0.0f;
+        case 1: return -1.0f;
+        case 2: { const uint32_t b = 0x7F7FFFFFu - u(4); float f; std::memcpy(&f, &b, 4); return u(2) ? f : -f; }
+        default: return std::uniform_real_distribution<float>(-64.0f, 64.0f)(r);
+        }
+    }
+    // one micro memory: programs back to back, each ending with an E pair and its delay pair
+    std::vector<uint8_t> image(std::vector<uint32_t> &starts)
+    {
+        std::vector<uint8_t> code(PS2_VU1_CODE_SIZE);
+        uint32_t p = 0;
+        while (p + 40u * 8u < PS2_VU1_CODE_SIZE && starts.size() < 24u)
+        {
+            const uint32_t len = 4u + u(20);
+            starts.push_back(p);
+            std::vector<std::pair<uint32_t, uint32_t>> prog;
+            for (uint32_t i = 0; i < len; ++i)
+            {
+                uint32_t l = lower(), up = upper();
+                if (u(12) == 0) { const float f = flt(); std::memcpy(&l, &f, 4); up |= kI; } // I-bit immediate
+                if (u(25) == 0) up |= u(2) ? kD : kT;
+                prog.push_back({l, up});
+            }
+            // branches: never in the last pair (it needs a delay slot), never in a delay slot, no halt bits on them
+            for (uint32_t i = 0; i + 1u < len; ++i)
+            {
+                if (u(6) != 0)
+                    continue;
+                if (i > 0 && !(prog[i - 1].second >> 31) && ((prog[i - 1].first >> 25) >= 0x20 && (prog[i - 1].first >> 25) <= 0x2F))
+                    continue;
+                const int32_t target = static_cast<int32_t>(u(len));             // inside the program
+                const int32_t off = target - static_cast<int32_t>(i) - 1;
+                static const uint32_t ops[] = {0x20, 0x21, 0x28, 0x29, 0x2C, 0x2D, 0x2E, 0x2F};
+                const uint32_t op = ops[u(8)];
+                prog[i].first = (op << 25) | (vi() << 16) | (vi() << 11) | (static_cast<uint32_t>(off) & 0x7FFu);
+                prog[i].second &= ~(kI | kD | kT | kE);           // (its lower word is the branch now)
+                if ((prog[i + 1].first >> 25) >= 0x20 && (prog[i + 1].first >> 25) <= 0x2F)
+                    prog[i + 1].first = kLowerNop;
+                if (prog[i + 1].second & kI)
+                    prog[i + 1] = {kLowerNop, prog[i + 1].second & ~kI}; // its lower word was a float immediate
+            }
+            prog.push_back({kLowerNop, kNop | kE});
+            prog.push_back({kLowerNop, kNop});
+            std::memcpy(code.data() + p, prog.data(), prog.size() * 8u);
+            p += static_cast<uint32_t>(prog.size()) * 8u + 8u * u(3);
+        }
+        return code;
+    }
+};
+
+uint64_t mix(uint64_t h, const void *p, size_t n)
+{
+    for (size_t i = 0; i < n; ++i)
+        h = (h ^ static_cast<const uint8_t *>(p)[i]) * 1099511628211ull;
+    return h;
+}
+}
+
+int main(int argc, char **argv)
+{
+    if (argc < 2)
+    {
+        std::fprintf(stderr, "usage: vu1_x64_fuzz_test x64|x64-calls [images] [trials]\n"
+                             "       vu1_x64_fuzz_test module <work dir> <vu1n_gen.py> <python> <clang++> \"<flags>\" [images] [trials]\n");
+        return 2;
+    }
+    const std::string mode = argv[1];
+    int argi = 2;
+    if (mode == "exact") // reference across platforms: the exact engine only
+        setEnv("GOW_VU1_NATIVE_OFF", "1");
+    else if (mode == "x64" || mode == "x64-calls")
+    {
+        setEnv("GOW_VU1N_X64", "1");
+        if (mode == "x64-calls")
+            setEnv("GOW_VU1X_INLINE", "0");
+    }
+    else if (mode == "module" && argc >= 7)
+    {
+        setEnv("GOW_VU1N_JIT", argv[2]);
+        setEnv("GOW_VU1N_JIT_GEN", argv[3]);
+        setEnv("GOW_VU1N_JIT_PY", argv[4]);
+        setEnv("GOW_VU1N_JIT_CXX", argv[5]);
+        setEnv("GOW_VU1N_JIT_FLAGS", argv[6]);
+        setEnv("GOW_VU1N_JIT_DELAY", "10");
+        setEnv("GOW_VU1N_JIT_HEADS", "all"); // the generator builds every entry, as the JIT can
+        argi = 7;
+    }
+    else
+        return 2;
+    const unsigned images = argc > argi ? static_cast<unsigned>(std::atoi(argv[argi])) : 6u;
+    const unsigned trials = argc > argi + 1 ? static_cast<unsigned>(std::atoi(argv[argi + 1])) : 20u;
+
+    PS2Memory mem;
+    if (!mem.initialize())
+        return 2;
+    GS gs;
+    gs.init(mem.getGSVRAM(), 4u * 1024u * 1024u, &mem.gs());
+    const char *seedEnv = std::getenv("GOW_FUZZ_SEED"); // other programs: another seed (same for every mode)
+    std::mt19937 rng(seedEnv ? static_cast<uint32_t>(std::strtoul(seedEnv, nullptr, 10)) : 424242u);
+    Gen g(rng);
+    uint64_t digest = 1469598103934665603ull;
+    // GOW_FUZZ_DUMP=<file>: one line per run (image, trial, pc, run digest, native blocks) to find where two modes differ
+    FILE *dump = std::getenv("GOW_FUZZ_DUMP") ? std::fopen(std::getenv("GOW_FUZZ_DUMP"), "w") : nullptr;
+    unsigned long long runs = 0, nativeBlocks = 0;
+    for (unsigned img = 0; img < images; ++img)
+    {
+        std::vector<uint32_t> starts;
+        const auto code = g.image(starts);
+        std::memcpy(mem.getVU1Code(), code.data(), code.size());
+        for (unsigned t = 0; t < trials + 1u; ++t)
+        {
+            // registers and memory: finite values (entry lanes stay clean, so no backend falls back on an entry check)
+            VU1State init{};
+            for (int r = 1; r < 9; ++r)
+                for (int c = 0; c < 4; ++c)
+                    init.vf[r][c] = g.flt();
+            init.vf[0][3] = 1.0f;
+            for (int r = 1; r < 8; ++r)
+                init.vi[r] = static_cast<int32_t>(g.u(40));
+            init.q = g.flt();
+            init.i = g.flt();
+            init.p = g.flt();
+            init.clip = rng() & 0xFFFFFFu;
+            init.dBitEnabled = g.u(4) == 0;
+            init.tBitEnabled = g.u(4) == 0;
+            init.top = rng() & 0x3FFu;
+            init.itop = rng() & 0x3FFu;
+            std::vector<float> data(PS2_VU1_DATA_SIZE / 4);
+            for (float &f : data)
+                f = g.flt();
+            for (uint32_t pc : starts)
+            {
+                std::memcpy(mem.getVU1Data(), data.data(), PS2_VU1_DATA_SIZE);
+                VU1Interpreter vu;
+                vu.state() = init;
+                vu.execute(mem.getVU1Code(), PS2_VU1_CODE_SIZE, mem.getVU1Data(), PS2_VU1_DATA_SIZE, gs, &mem, pc, init.top,
+                           init.itop, 4096);
+                if (t == 0)
+                    continue; // first pass: the background compiler sees the code here
+                const VU1State &s = vu.state();
+                digest = mix(digest, s.vf, sizeof(s.vf));
+                digest = mix(digest, s.vi, sizeof(s.vi));
+                digest = mix(digest, s.acc, sizeof(s.acc));
+                digest = mix(digest, &s.q, 4);
+                digest = mix(digest, &s.i, 4);
+                digest = mix(digest, &s.mac, 4);
+                digest = mix(digest, &s.clip, 4);
+                digest = mix(digest, &s.pc, 4);
+                digest = mix(digest, &s.stoppedByD, 1);
+                digest = mix(digest, &s.stoppedByT, 1);
+                digest = mix(digest, mem.getVU1Data(), PS2_VU1_DATA_SIZE);
+                if (dump)
+                {
+                    uint64_t h = mix(1469598103934665603ull, s.vf, sizeof(s.vf));
+                    h = mix(h, s.vi, sizeof(s.vi));
+                    h = mix(h, s.acc, sizeof(s.acc));
+                    h = mix(h, &s.q, 4);
+                    h = mix(h, &s.mac, 4);
+                    h = mix(h, &s.clip, 4);
+                    h = mix(h, &s.pc, 4);
+                    h = mix(h, mem.getVU1Data(), PS2_VU1_DATA_SIZE);
+                    std::fprintf(dump, "%u %u %04x %016llx %llu\n", img, t, pc, static_cast<unsigned long long>(h),
+                                 VU1NativeAccess::nativeBlocksRun(vu));
+                }
+                nativeBlocks += VU1NativeAccess::nativeBlocksRun(vu);
+                ++runs;
+            }
+            if (t == 0 && mode == "module")
+                vu1nJitWaitIdle();
+        }
+    }
+    std::printf("mode %s: %u images, %llu runs, %llu native blocks run\n", mode.c_str(), images, runs, nativeBlocks);
+#if defined(__x86_64__) || defined(_M_X64)
+    unsigned long long compiled = 0, unsupported = 0, bytes = 0, ns = 0;
+    vu1xStats(compiled, unsupported, bytes, ns);
+    if (compiled || unsupported)
+        std::printf("x64 JIT: %llu blocks compiled (%llu bytes, %.1f us each), %llu left to the exact engine\n", compiled, bytes,
+                    compiled ? ns / 1000.0 / compiled : 0.0, unsupported);
+#endif
+    std::printf("digest %016llx\n", static_cast<unsigned long long>(digest));
+    return 0;
+}
