+    // --- upper
+    uint32_t hFmac(VU1NativeCtx *n, Frame *f, const Imm *k)
+    {
+        VU1State &s = *n->s;
+        const __m128 a = ldv(s, k->fs, k->aNorm);
+        __m128 b;
+        switch (k->src)
+        {
+        case S_BC: b = bcRt(ldv(s, k->ft, k->bNorm), k->bc); break;
+        case S_Q: b = _mm_set1_ps(s.q); break;
+        case S_I: b = _mm_set1_ps(s.i); break;
+        default: b = ldv(s, k->ft, k->bNorm); break;
+        }
+        __m128 r;
+        switch (k->op)
+        {
+        case K_ADD: r = _mm_add_ps(a, b); break;
+        case K_SUB: r = _mm_sub_ps(a, b); break;
+        case K_MUL: r = _mm_mul_ps(a, b); break;
+        case K_MADD: r = madd<false>(ldAcc(s), a, b); break;
+        case K_MSUB: r = madd<true>(ldAcc(s), a, b); break;
+        case K_MAX: r = _mm_max_ps(a, b); break;
+        default: r = _mm_min_ps(a, b); break;
+        }
+        if (k->mac)
+        {
+            f->m[k->i] = macValRt(r, k->m);
+            f->q[k->i] = r;
+        }
+        if (k->clamp)
+            r = clampv(r);
+        if (k->store)
+            stfRt(k->toAcc ? s.acc : s.vf[k->fd], r, k->m);
+        return 0;
+    }
+    // inline tier: m{i} from the stored unclamped result (same macValRt as hFmac)
+    uint32_t hMacVal(VU1NativeCtx *, Frame *f, const Imm *k)
+    {
+        f->m[k->i] = macValRt(f->q[k->i], k->m);
+        return 0;
+    }
+    uint32_t hClip(VU1NativeCtx *n, Frame *f, const Imm *k)
+    {
+        const uint32_t prev = k->prevClip >= 0 ? f->c[k->prevClip] : VU1NativeAccess::clipChain(*n);
