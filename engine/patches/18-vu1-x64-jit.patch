+    // executable memory: 1 MB chunks, read-write-execute, never freed
+    class CodeArena
+    {
+    public:
+        void *put(const std::vector<uint8_t> &code)
+        {
+            const size_t size = (code.size() + 15u) & ~size_t(15);
+            if (!m_cur || static_cast<size_t>(m_end - m_cur) < size)
+            {
+                const size_t chunk = std::max<size_t>(size, 1u << 20);
+#if defined(_WIN32)
+                void *p = VirtualAlloc(nullptr, chunk, MEM_COMMIT | MEM_RESERVE, PAGE_EXECUTE_READWRITE);
+#else
+                void *p = mmap(nullptr, chunk, PROT_READ | PROT_WRITE | PROT_EXEC, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+                if (p == MAP_FAILED)
+                    p = nullptr;
+#endif
+                if (!p)
+                    return nullptr;
+                m_cur = static_cast<uint8_t *>(p);
+                m_end = m_cur + chunk;
+                m_total += chunk;
+            }
+            uint8_t *at = m_cur;
+            std::memcpy(at, code.data(), code.size());
+            m_cur += size;
+#if defined(_WIN32)
+            FlushInstructionCache(GetCurrentProcess(), at, code.size());
+#endif
+            return at;
+        }
+        size_t reserved() const { return m_total; }
+
+    private:
+        uint8_t *m_cur = nullptr, *m_end = nullptr;
+        size_t m_total = 0;
+    };
