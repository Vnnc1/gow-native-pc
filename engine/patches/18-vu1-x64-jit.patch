+            break;
+        default:
+            x.movupsLoad(XMM2, R14, vfOff(k.ft));
+            if (k.bNorm)
+                emitNrm(x, XMM2);
+            break;
+        }
+        size_t slow = 0;
+        bool hasSlow = false;
+        switch (k.op)
+        {
+        case K_ADD: x.arith(OP_ADD, XMM1, XMM2); break;
+        case K_SUB: x.arith(OP_SUB, XMM1, XMM2); break;
+        case K_MUL: x.arith(OP_MUL, XMM1, XMM2); break;
+        case K_MAX: x.arith(OP_MAX, XMM1, XMM2); break;
+        case K_MINI: x.arith(OP_MIN, XMM1, XMM2); break;
+        case K_MADD:
+        case K_MSUB:
+            // vu1n::madd: p = a * b; r = acc +/- p; any lane of p or r beyond 0x7F7FFFFE -> the helper (wide evaluation)
+            x.arith(OP_MUL, XMM1, XMM2);                                          // xmm1 = p
+            x.movupsLoad(XMM5, R14, static_cast<int32_t>(offsetof(VU1State, acc)));
+            x.arith(k.op == K_MADD ? OP_ADD : OP_SUB, XMM5, XMM1);                // xmm5 = r
+            x.movaps(XMM0, XMM1);
+            x.arithM(OP_AND, XMM0, RCX, C_ABS);
+            x.pM(0x66, XMM0, RCX, C_LIM);                                         // pcmpgtd
+            x.movaps(XMM3, XMM5);
+            x.arithM(OP_AND, XMM3, RCX, C_ABS);
+            x.pM(0x66, XMM3, RCX, C_LIM);
+            x.pRR(0xEB, XMM0, XMM3);                                              // por
+            x.pmovmskb(RAX, XMM0);
+            a.testEaxEax();
+            slow = a.jcc(CC_NZ);
+            hasSlow = true;
+            x.movaps(XMM1, XMM5);                                                 // r in xmm1
+            break;
+        default:
+            return false;
+        }
+        // r = xmm1
+        if (k.mac)
+            x.movupsStore(R12, static_cast<int32_t>(offsetof(Frame, q) + k.i * 16u), XMM1); // q{i}: unclamped
+        if (k.clamp)
+        {
+            x.arithM(OP_MAX, XMM1, RCX, C_NFMAX);
+            x.arithM(OP_MIN, XMM1, RCX, C_FMAX);
+        }
+        if (k.store)
+            emitStf(x, R14, k.toAcc ? static_cast<int32_t>(offsetof(VU1State, acc)) : vfOff(k.fd), XMM1, k.m);
+        size_t done = 0;
+        if (hasSlow)
+            done = a.jmp();
+        if (hasSlow)
+        {
+            a.patch(slow, a.c.size());
+            emitCallHelper(a, hFmac, k); // the whole statement, from the unchanged state
+        }
+        if (hasSlow)
+            a.patch(done, a.c.size());
+        if (k.mac && k.macM)
+            emitCallHelper(a, hMacVal, k); // m{i} from q{i} (both paths stored it)
+        return true;
+    }
+
+    bool emitInline(Asm &a, const Imm &k, InlineKind kind)
+    {
+        SseAsm x{a};
+        switch (kind)
+        {
+        case IN_FMAC:
+            return emitFmac(a, k);
+        case IN_MOVE: // stf<m>(vf[ft], ld(vf[fs]))
+            x.movupsLoad(XMM1, R14, vfOff(k.fs));
+            emitStf(x, R14, vfOff(k.ft), XMM1, k.m);
+            return true;
+        case IN_LQ: // vf[ft] <- data[(vi[fs] + imm) * 16 & mask]
+            movR32M(a, RAX, R14, viOff(k.fs));
+            addEaxImm(a, k.imm);
+            emitQaddr(a);
+            x.movupsLoad(XMM1, RAX, 0);
+            emitStf(x, R14, vfOff(k.ft), XMM1, k.m);
+            return true;
+        case IN_SQ: // data[(vi[ft] + imm) * 16 & mask] <- vf[fs]
+            movR32M(a, RAX, R14, viOff(k.ft));
+            addEaxImm(a, k.imm);
+            emitQaddr(a);
+            x.movupsLoad(XMM1, R14, vfOff(k.fs));
+            emitStf(x, RAX, 0, XMM1, k.m);
+            return true;
+        case IN_LQI: // if ft: vf[ft] <- data[(u16)vi[fs]]; if fs: vi[fs] = sx16(vi[fs] + 1)
+            if (k.ft)
+            {
+                movzxEaxM16(a, R14, viOff(k.fs));
+                emitQaddr(a);
+                x.movupsLoad(XMM1, RAX, 0);
+                emitStf(x, R14, vfOff(k.ft), XMM1, k.m);
+            }
+            if (k.fs)
+            {
+                movR32M(a, RAX, R14, viOff(k.fs));
+                addEaxImm(a, 1);
+                movsxEaxAx(a);
+                movM32R(a, R14, viOff(k.fs), RAX);
+            }
+            return true;
+        case IN_SQI: // data[(u16)vi[ft]] <- vf[fs]; if ft: vi[ft] = sx16(vi[ft] + 1)
+            movzxEaxM16(a, R14, viOff(k.ft));
+            emitQaddr(a);
+            x.movupsLoad(XMM1, R14, vfOff(k.fs));
+            emitStf(x, RAX, 0, XMM1, k.m);
+            if (k.ft)
+            {
+                movR32M(a, RAX, R14, viOff(k.ft));
+                addEaxImm(a, 1);
+                movsxEaxAx(a);
+                movM32R(a, R14, viOff(k.ft), RAX);
+            }
+            return true;
+        case IN_IADDIU: case IN_ISUBIU: case IN_IADDI: // vi[ft] = sx16(vi[fs] +/- imm)
+            movR32M(a, RAX, R14, viOff(k.fs));
+            addEaxImm(a, kind == IN_ISUBIU ? -k.imm : k.imm);
+            movsxEaxAx(a);
+            movM32R(a, R14, viOff(k.ft), RAX);
+            return true;
+        case IN_IADD: case IN_ISUB: case IN_IAND: case IN_IOR: // vi[fd] = vi[fs] op vi[ft] (sx16 for add / sub)
+            movR32M(a, RAX, R14, viOff(k.fs));
+            aluR32M(a, kind == IN_IADD ? 0x03 : kind == IN_ISUB ? 0x2B : kind == IN_IAND ? 0x23 : 0x0B, RAX, R14, viOff(k.ft));
+            if (kind == IN_IADD || kind == IN_ISUB)
+                movsxEaxAx(a);
+            movM32R(a, R14, viOff(k.fd), RAX);
+            return true;
+        case IN_ISET: // s.i = qnorm(immediate), folded now
+        {
+            float imm;
+            std::memcpy(&imm, &k.lower, 4);
+            const float v = qnorm(imm);
+            uint32_t bits;
+            std::memcpy(&bits, &v, 4);
+            movM32I(a, R14, static_cast<int32_t>(offsetof(VU1State, i)), bits);
+            return true;
+        }
+        default:
+            return false;
+        }
+    }
+}
+
+VU1NativeFn VU1NativeAccess::chainFn(VU1NativeCtx &n, uint32_t next)
+{
+    static_assert(VU1Interpreter::kFmacLatency == vu1x::kFlat, "vu1x::kFlat must follow the flag latency");
+    VU1Interpreter::NativeState::Slot *sl = chain(n, next);
+    return sl ? sl->fn : nullptr;
+}
+
