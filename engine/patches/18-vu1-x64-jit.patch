+        case 0: ftoiDispatch<0>(*n->s, k->fs, k->ft, k->m, seq); break;
+        case 4: ftoiDispatch<4>(*n->s, k->fs, k->ft, k->m, seq); break;
+        case 12: ftoiDispatch<12>(*n->s, k->fs, k->ft, k->m, seq); break;
