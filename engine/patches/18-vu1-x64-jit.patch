+    uint32_t flagValue(VU1NativeCtx *n, Frame *f, const FlagSrc &src)
+    {
+        for (uint32_t k = 0; k < src.nNear; ++k)
+        {
+            const uint32_t j = src.nearJ[k];
+            if (static_cast<int>(n->cyc[src.i]) - static_cast<int>(n->cyc[j]) >= static_cast<int>(kFlat))
