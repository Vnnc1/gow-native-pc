diff --git a/PS2Recomp/ps2xRuntime/src/lib/vu/ps2_vu1_x64.inl b/PS2Recomp/ps2xRuntime/src/lib/vu/ps2_vu1_x64.inl
new file mode 100644
index 0000000..41466ea
--- /dev/null
+++ b/PS2Recomp/ps2xRuntime/src/lib/vu/ps2_vu1_x64.inl
@@ -0,0 +1,1598 @@
+// gow-native-pc: in-process x86-64 JIT for VU1 blocks (included by ps2_vu1_native.inl). Opt-in: GOW_VU1N_X64=1.
+//
+// A VU1 block the game reaches without native code (no build-time block, no background-compiled module) is translated
+// at its first slot setup, in microseconds, without a compiler, Python or files, and registered like the build's blocks.
+//
+// Translation (vu1x::translate) is a line-by-line port of tools/vu1/vu1n_gen.py gen_block(): the same structural checks
+// (unsupported shapes fall back to the exact engine), the same order of lower/upper ops, the same flag model (MAC / clip
+// writers visible after kFmacLatency on the exact engine's issue cycles n.cyc, flush at D/T exits, tail records and
+// ring pushes at the block end), the same clean-operand choice between ld and ldn (with the conservative entry
+// assumption: only vf00 clean, so the runtime never has to check entry lanes), the same VI backups for branches in a
+// delay slot. Every C++ statement the generator would write becomes one statement here (Stmt): a helper function that
+// runs exactly that statement with the same vu1n:: helpers (bit-identical by construction), or, with the inline tier on
+// (default; GOW_VU1X_INLINE=0 turns it off), x86 SSE code for the hot statements (FMAC, MOVE, loads/stores, integer
+// ALU). Control flow (D/T exits, the end of program, the jump to the next block through VU1NativeAccess::chainFn as a
+// tail jump) is emitted directly.
+//
+// Code: System V (Linux) and Windows x64 calling conventions; rbx = VU1NativeCtx *, r12 = the block's frame (temporaries:
+// unclamped FMAC results, MAC / clip values, VI backups, the branch decision), r13 = the next pc at the block end, r14 =
+// VU1State *, r15 = VU data. Only xmm0-xmm5 are used (callee-saved xmm6-15 on Windows stay untouched). Code memory:
+// 1 MB read-write-execute chunks, never freed (a block's code stays valid for the process lifetime, like the build's).
+// Statement data (operands, flag-source lists) lives next to the block, also never freed.
+//
+// Tests: tests/vu1_jit_test.cpp (mode x64: digest must equal the build's compiled-in blocks) and tests/vu1_x64_fuzz_test.cpp
+// (random programs: x64 JIT digest == background-compiler digest == vu1n_gen.py's code). Docs: docs/research/vu1-x64-jit.md
+// in gow-native-pc.
+
+#if defined(__x86_64__) || defined(_M_X64)
+#define VU1X_SUPPORTED 1
+#else
+#define VU1X_SUPPORTED 0
+#endif
+
+#if VU1X_SUPPORTED
+#if !defined(_WIN32)
+#include <sys/mman.h>
+#endif
+#include <cstddef>
+#include <deque>
+#include <memory>
+#include <unordered_set>
+#include <vector>
+
+namespace vu1x
+{
+    // ------------------------------------------------------------------------------------------------- decode (vu1n_gen.py)
+    constexpr uint32_t kFlat = 4u; // FLAT in vu1n_gen.py = VU1Interpreter::kFmacLatency (private there)
+    constexpr int kRev4[16] = {0, 8, 4, 12, 2, 10, 6, 14, 1, 9, 5, 13, 3, 11, 7, 15};
+
+    enum Kind : uint8_t
+    {
+        K_NOP, K_ADD, K_SUB, K_MADD, K_MSUB, K_MAX, K_MINI, K_MUL, K_ITOF, K_FTOI, K_ABS, K_CLIP, K_OPMSUB, K_OPMULA, K_OTHER
+    };
+    enum Src : uint8_t
+    {
+        S_NONE, S_BC, S_Q, S_I, S_V
+    };
+    struct UpperOp
+    {
+        Kind kind = K_OTHER;
+        Src src = S_V;
+        bool toAcc = false;
+        uint8_t bc = 0;    // broadcast lane
+        uint8_t shift = 0; // ITOF / FTOI: 0, 4, 12, 15
+    };
+
+    inline bool isArith(Kind k) { return k == K_ADD || k == K_SUB || k == K_MADD || k == K_MSUB || k == K_MAX || k == K_MINI || k == K_MUL; }
+    inline bool isBranchOp(uint32_t op)
+    {
+        switch (op)
+        {
+        case 0x20: case 0x21: case 0x24: case 0x25: case 0x28: case 0x29: case 0x2C: case 0x2D: case 0x2E: case 0x2F:
+            return true;
+        default:
+            return false;
+        }
+    }
+    inline bool isBranch(uint32_t l, uint32_t u) { return !(u >> 31) && isBranchOp(l >> 25); }
+    inline int32_t sx(uint32_t v, int bits)
+    {
+        v &= (1u << bits) - 1u;
+        return (v & (1u << (bits - 1))) ? static_cast<int32_t>(v) - (1 << bits) : static_cast<int32_t>(v);
+    }
+
+    UpperOp classify(uint32_t u)
+    {
+        UpperOp r;
+        const uint32_t op = u & 0x3Fu;
+        auto set = [&](Kind k, Src s, bool acc, uint32_t bc) { r.kind = k, r.src = s, r.toAcc = acc, r.bc = static_cast<uint8_t>(bc); return r; };
+        if (op < 0x3C)
+        {
+            const uint32_t c = op;
+            if (c <= 0x03) return set(K_ADD, S_BC, false, c & 3);
+            if (c <= 0x07) return set(K_SUB, S_BC, false, c & 3);
+            if (c <= 0x0B) return set(K_MADD, S_BC, false, c & 3);
+            if (c <= 0x0F) return set(K_MSUB, S_BC, false, c & 3);
+            if (c <= 0x13) return set(K_MAX, S_BC, false, c & 3);
+            if (c <= 0x17) return set(K_MINI, S_BC, false, c & 3);
+            if (c <= 0x1B) return set(K_MUL, S_BC, false, c & 3);
+            switch (c)
+            {
+            case 0x1C: return set(K_MUL, S_Q, false, 0);
+            case 0x1D: return set(K_MAX, S_I, false, 0);
+            case 0x1E: return set(K_MUL, S_I, false, 0);
+            case 0x1F: return set(K_MINI, S_I, false, 0);
+            case 0x20: return set(K_ADD, S_Q, false, 0);
+            case 0x21: return set(K_MADD, S_Q, false, 0);
+            case 0x22: return set(K_ADD, S_I, false, 0);
+            case 0x23: return set(K_MADD, S_I, false, 0);
+            case 0x24: return set(K_SUB, S_Q, false, 0);
+            case 0x25: return set(K_MSUB, S_Q, false, 0);
+            case 0x26: return set(K_SUB, S_I, false, 0);
+            case 0x27: return set(K_MSUB, S_I, false, 0);
+            case 0x28: return set(K_ADD, S_V, false, 0);
+            case 0x29: return set(K_MADD, S_V, false, 0);
+            case 0x2A: return set(K_MUL, S_V, false, 0);
+            case 0x2B: return set(K_MAX, S_V, false, 0);
+            case 0x2C: return set(K_SUB, S_V, false, 0);
+            case 0x2D: return set(K_MSUB, S_V, false, 0);
+            case 0x2E: return set(K_OPMSUB, S_V, false, 0);
+            case 0x2F: return set(K_MINI, S_V, false, 0);
+            default: return set(K_OTHER, S_V, false, 0);
+            }
+        }
+        const uint32_t sp = (u & 3u) | ((u >> 4) & 0x7Cu);
+        if (sp <= 0x03) return set(K_ADD, S_BC, true, sp & 3);
+        if (sp <= 0x07) return set(K_SUB, S_BC, true, sp & 3);
+        if (sp <= 0x0B) return set(K_MADD, S_BC, true, sp & 3);
+        if (sp <= 0x0F) return set(K_MSUB, S_BC, true, sp & 3);
+        static const uint8_t kShift[4] = {0, 4, 12, 15};
+        if (sp >= 0x10 && sp <= 0x13) { set(K_ITOF, S_NONE, false, 0); r.shift = kShift[sp & 3]; return r; }
+        if (sp >= 0x14 && sp <= 0x17) { set(K_FTOI, S_NONE, false, 0); r.shift = kShift[sp & 3]; return r; }
+        if (sp >= 0x18 && sp <= 0x1B) return set(K_MUL, S_BC, true, sp & 3);
+        if (sp == 0x1D) return set(K_ABS, S_NONE, false, 0);
+        if (sp == 0x1F) return set(K_CLIP, S_NONE, false, 0);
+        if (sp == 0x2F || sp == 0x30) return set(K_NOP, S_NONE, false, 0);
+        switch (sp)
+        {
+        case 0x1C: return set(K_MUL, S_Q, true, 0);
+        case 0x1E: return set(K_MUL, S_I, true, 0);
+        case 0x20: return set(K_ADD, S_Q, true, 0);
+        case 0x21: return set(K_MADD, S_Q, true, 0);
+        case 0x22: return set(K_ADD, S_I, true, 0);
+        case 0x23: return set(K_MADD, S_I, true, 0);
+        case 0x24: return set(K_SUB, S_Q, true, 0);
+        case 0x25: return set(K_MSUB, S_Q, true, 0);
+        case 0x26: return set(K_SUB, S_I, true, 0);
+        case 0x27: return set(K_MSUB, S_I, true, 0);
+        case 0x28: return set(K_ADD, S_V, true, 0);
+        case 0x29: return set(K_MADD, S_V, true, 0);
+        case 0x2A: return set(K_MUL, S_V, true, 0);
+        case 0x2C: return set(K_SUB, S_V, true, 0);
+        case 0x2D: return set(K_MSUB, S_V, true, 0);
+        case 0x2E: return set(K_OPMULA, S_V, true, 0);
+        default: return set(K_OTHER, S_V, false, 0);
+        }
+    }
+
+    struct UpperInfo
+    {
+        uint32_t writes = 0, reads = 0; // VF register bit sets
+        bool writesMac = false, readsQ = false;
+    };
+    UpperInfo upperInfo(uint32_t u)
+    {
+        UpperInfo r;
+        const UpperOp k = classify(u);
+        const uint32_t dest = (u >> 21) & 0xFu, ft = (u >> 16) & 31u, fs = (u >> 11) & 31u, fd = (u >> 6) & 31u;
+        if (k.kind == K_NOP || (dest == 0 && k.kind != K_CLIP))
+            return r;
+        if (isArith(k.kind))
+        {
+            r.reads |= 1u << fs;
+            if (k.src == S_BC || k.src == S_V)
+                r.reads |= 1u << ft;
+            if (!k.toAcc)
+                r.writes |= 1u << fd;
+        }
+        else if (k.kind == K_ITOF || k.kind == K_FTOI || k.kind == K_ABS)
+        {
+            r.reads |= 1u << fs;
+            r.writes |= 1u << ft;
+        }
+        else if (k.kind == K_CLIP)
+            r.reads |= (1u << fs) | (1u << ft);
+        else if (k.kind == K_OPMSUB || k.kind == K_OPMULA || k.kind == K_OTHER)
+        {
+            r.reads |= (1u << fs) | (1u << ft);
+            if (!k.toAcc)
+                r.writes |= 1u << fd;
+        }
+        r.writesMac = (k.kind == K_ADD || k.kind == K_SUB || k.kind == K_MADD || k.kind == K_MSUB || k.kind == K_MUL) && dest != 0;
+        r.readsQ = k.src == S_Q;
+        r.writes &= ~1u; // vf00 is never written
+        return r;
+    }
