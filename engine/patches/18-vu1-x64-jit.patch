+    // clean-operand lanes: bit r*4 + lane (vu1n_gen.py pair_effect / apply_pair / block_summary)
+    struct L128
+    {
+        uint64_t w[2] = {0, 0};
+        static L128 all() { L128 x; x.w[0] = x.w[1] = ~0ull; return x; }
+        static L128 lanes(uint32_t r, uint32_t m = 0xF)
+        {
+            L128 x;
+            const uint32_t b = r * 4u;
+            x.w[b >> 6] = static_cast<uint64_t>(m & 0xFu) << (b & 63u);
+            return x;
+        }
+        L128 operator&(const L128 &o) const { L128 x; x.w[0] = w[0] & o.w[0]; x.w[1] = w[1] & o.w[1]; return x; }
+        L128 operator|(const L128 &o) const { L128 x; x.w[0] = w[0] | o.w[0]; x.w[1] = w[1] | o.w[1]; return x; }
+        L128 operator~() const { L128 x; x.w[0] = ~w[0]; x.w[1] = ~w[1]; return x; }
+        bool operator==(const L128 &o) const { return w[0] == o.w[0] && w[1] == o.w[1]; }
+    };
+    struct PairEffect
+    {
+        L128 killLower, killUpper, setUpper;
+    };
+    PairEffect pairEffect(uint32_t l, uint32_t u)
+    {
+        PairEffect e;
+        const bool iBit = (u >> 31) != 0u;
+        const LowerInfo li = lowerInfo(iBit ? 0u : l);
+        for (uint32_t r = 1; r < 32; ++r)
+            if (li.vfw & (1u << r))
+                e.killLower = e.killLower | L128::lanes(r);
+        const UpperOp k = classify(u);
+        const uint32_t dest = (u >> 21) & 0xFu, ft = (u >> 16) & 31u, fd = (u >> 6) & 31u;
+        const uint32_t m = static_cast<uint32_t>(kRev4[dest]);
+        const uint32_t uw = upperInfo(u).writes;
+        if (isArith(k.kind) && !k.toAcc && fd && dest)
+            e.setUpper = L128::lanes(fd, m);
+        else if (k.kind == K_ITOF && ft && dest)
+            e.setUpper = L128::lanes(ft, m);
+        else
+            for (uint32_t r = 1; r < 32; ++r)
+                if (uw & (1u << r))
+                    e.killUpper = e.killUpper | L128::lanes(r);
+        return e;
+    }
+    L128 applyPair(L128 st, const PairEffect &e)
+    {
+        st = st & ~e.killLower;
+        return (st & ~e.killUpper) | e.setUpper;
+    }
