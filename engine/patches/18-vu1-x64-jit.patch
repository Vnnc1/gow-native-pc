+            if (k->ft) stfRt(s.vf[k->ft], ldq(*n, qaddr(*n, static_cast<uint16_t>(s.vi[k->fs]))), k->m);
+            break;
+        case 0x37: // SQD
+            if (k->ft) s.vi[k->ft] = sx16(s.vi[k->ft] - 1);
+            stfRt(reinterpret_cast<float *>(n->data + qaddr(*n, static_cast<uint16_t>(s.vi[k->ft]))), ld(s, k->fs), k->m);
+            break;
+        case 0x38: divOp(s, k->fs, k->fsf, k->ft, k->ftf); break;
+        case 0x39: sqrtOp(s, k->ft, k->ftf); break;
+        case 0x3A: rsqrtOp(s, k->fs, k->fsf, k->ft, k->ftf); break;
+        case 0x3C: viSet(s, k->ft, compBits(s, k->fs, k->fsf)); break;
+        case 0x3D: stfRt(s.vf[k->ft], fromInt(sx16(s.vi[k->fs])), k->m); break;
+        case 0x3E: viSet(s, k->ft, ldWord(*n, qaddr(*n, static_cast<uint16_t>(s.vi[k->fs])), k->comp)); break;
+        case 0x3F: stWords(*n, qaddr(*n, static_cast<uint16_t>(s.vi[k->fs])), s.vi[k->ft], k->dest); break;
+        case 0x64: stfRt(s.vf[k->ft], _mm_set1_ps(s.p), k->m); break;
+        case 0x68: viSet(s, k->ft, static_cast<int32_t>(s.top & 0x3FFu)); break;
+        case 0x69: viSet(s, k->ft, static_cast<int32_t>(s.itop & 0x3FFu)); break;
+        case 0x6C: VU1NativeAccess::xgkick(*n, static_cast<uint32_t>(static_cast<uint16_t>(s.vi[k->fs]))); break;
+        default: break;
+        }
+        return 0;
+    }
+    uint32_t hISet(VU1NativeCtx *n, Frame *, const Imm *k)
+    {
+        float imm;
+        std::memcpy(&imm, &k->lower, 4);
+        n->s->i = qnorm(imm);
+        return 0;
+    }
+    uint32_t hBackup(VU1NativeCtx *n, Frame *f, const Imm *k)
+    {
+        f->vib[k->i] = n->s->vi[k->fs];
+        return 0;
+    }
+    uint32_t hBranch(VU1NativeCtx *n, Frame *f, const Imm *k)
+    {
+        VU1State &s = *n->s;
+        const auto rd = [&](uint32_t reg, bool vib) { return vib ? f->vib[k->i] : s.vi[reg]; };
+        const uint32_t link = (k->pc + 16u) / 8u;
+        switch (k->op)
+        {
+        case 0x20: f->taken = 1; f->target = static_cast<uint32_t>(k->imm); break;
+        case 0x21: if (k->ft) s.vi[k->ft] = static_cast<int32_t>(link); f->taken = 1; f->target = static_cast<uint32_t>(k->imm); break;
+        case 0x24: f->taken = 1; f->target = (static_cast<uint32_t>(static_cast<uint16_t>(s.vi[k->fs])) * 8u) & 0x3FFFu; break;
+        case 0x25:
+            f->target = (static_cast<uint32_t>(static_cast<uint16_t>(s.vi[k->fs])) * 8u) & 0x3FFFu;
+            if (k->ft) s.vi[k->ft] = static_cast<int32_t>(link);
+            f->taken = 1;
+            break;
+        default:
+        {
+            const int16_t a = static_cast<int16_t>(rd(k->fs, k->useVibFs));
+            const int16_t b = static_cast<int16_t>(rd(k->ft, k->useVibFt));
+            bool t = false;
+            switch (k->op)
+            {
+            case 0x28: t = a == b; break;
+            case 0x29: t = a != b; break;
+            case 0x2C: t = a < 0; break;
+            case 0x2D: t = a > 0; break;
+            case 0x2E: t = a <= 0; break;
+            default: t = a >= 0; break;
+            }
+            f->taken = t ? 1u : 0u;
+            f->target = static_cast<uint32_t>(k->imm);
+            break;
+        }
+        }
+        return 0;
+    }
+
+    // --- flag flush / block end
+    void pushList(VU1NativeCtx *n, Frame *f, const FlushList &l, bool clip, uint32_t i)
+    {
+        for (uint32_t k = 0; k < l.n; ++k)
+        {
+            if (l.next[k] >= 0 && !(static_cast<uint32_t>(n->cyc[l.next[k]]) + kFlat > static_cast<uint32_t>(n->cyc[i]) + 1u))
+                continue;
+            if (clip)
+                VU1NativeAccess::pushClip(*n, n->cyc[l.j[k]], f->c[l.j[k]]);
+            else
+                VU1NativeAccess::pushMacRaw(*n, n->cyc[l.j[k]], f->q[l.j[k]], l.mask[k], nullptr);
+        }
+    }
+    // D/T halt after pair i: exit when enabled
+    uint32_t hHalt(VU1NativeCtx *n, Frame *f, const Imm *k)
+    {
+        VU1State &s = *n->s;
+        if (!(k->flagT ? s.tBitEnabled : s.dBitEnabled))
+            return 0;
+        pushList(n, f, k->fm, false, k->i);
+        pushList(n, f, k->fc, true, k->i);
+        if (k->flagT)
+            s.stoppedByT = true;
+        else
+            s.stoppedByD = true;
+        return kVu1nEnded | k->endPc;
+    }
+    uint32_t hTailQ(VU1NativeCtx *n, Frame *f, const Imm *k) { n->tail->q[k->k] = f->q[k->j]; return 0; }
+    uint32_t hTailC(VU1NativeCtx *n, Frame *f, const Imm *k) { n->tail->c[k->k] = f->c[k->j]; return 0; }
+    uint32_t hPushMacEnd(VU1NativeCtx *n, Frame *f, const Imm *k)
+    {
+        VU1NativeAccess::pushMacRaw(*n, n->cyc[k->j], f->q[k->j], k->m, k->hasTail ? n->tail : nullptr);
+        return 0;
+    }
+    uint32_t hPushClipEnd(VU1NativeCtx *n, Frame *f, const Imm *k)
+    {
+        VU1NativeAccess::pushClipTail(*n, n->cyc[k->j], f->c[k->j], k->hasTail ? n->tail : nullptr);
+        return 0;
+    }
+    uint32_t hNext(VU1NativeCtx *, Frame *f, const Imm *k) { return k->op ? (f->taken ? f->target : k->endPc) : k->endPc; }
+    VU1NativeFn chainFnThunk(VU1NativeCtx *n, uint32_t next) { return VU1NativeAccess::chainFn(*n, next); }
+
+    // ------------------------------------------------------------------------------------------------- translate
+    struct Translator
+    {
+        Block &b;
+        explicit Translator(Block &blk) : b(blk) {}
+        Imm &add(HelperFn fn, InlineKind inl = IN_NONE, bool exitNz = false)
+        {
+            b.imms.emplace_back();
+            b.stmts.push_back({fn, static_cast<uint32_t>(b.imms.size() - 1u), exitNz, inl});
+            return b.imms.back();
+        }
+    };
+
+    FlagSrc flagSrc(uint32_t i, const std::vector<uint32_t> &writers, bool clip)
+    {
+        FlagSrc f;
+        f.i = static_cast<uint8_t>(i);
+        f.isClip = clip;
+        for (auto it = writers.rbegin(); it != writers.rend(); ++it)
+        {
+            const uint32_t j = *it;
+            if (j >= i)
+                continue;
+            if (i - j < kFlat)
+            {
+                if (f.nNear < 3)
+                    f.nearJ[f.nNear++] = static_cast<uint8_t>(j);
+            }
+            else
+            {
+                f.farJ = static_cast<int8_t>(j);
+                break; // the newest far writer hides older ones
+            }
+        }
+        return f;
+    }
+
+    // gen_block(): false = unsupported shape (the exact engine runs the block, as with vu1n_gen.py's None)
