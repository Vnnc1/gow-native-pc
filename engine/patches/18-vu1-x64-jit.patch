+        case 0: itofDispatch<0>(*n->s, k->fs, k->ft, k->m, seq); break;
+        case 4: itofDispatch<4>(*n->s, k->fs, k->ft, k->m, seq); break;
+        case 12: itofDispatch<12>(*n->s, k->fs, k->ft, k->m, seq); break;
+        default: itofDispatch<15>(*n->s, k->fs, k->ft, k->m, seq); break;
+        }
+        return 0;
+    }
+    uint32_t hFtoi(VU1NativeCtx *n, Frame *, const Imm *k)
