+                const auto basic = [&](Imm &x) { x.i = static_cast<uint8_t>(i), x.fs = static_cast<uint8_t>(fs), x.ft = static_cast<uint8_t>(ft), x.fd = static_cast<uint8_t>(vid), x.m = static_cast<uint8_t>(m), x.dest = static_cast<uint8_t>(dest), x.comp = comp, x.pc = pc, x.lower = l, x.upper = u; };
