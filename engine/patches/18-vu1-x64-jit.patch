+    // ------------------------------------------------------------------------------------------------- compile + register
+    struct State
+    {
+        std::mutex mutex;
+        CodeArena arena;
+        std::vector<std::unique_ptr<Block>> blocks;
+        std::unordered_set<uint64_t> failed;
+        unsigned long long compiled = 0, unsupported = 0, codeBytes = 0, nanos = 0;
+    };
+    State &state()
+    {
+        static State s;
+        return s;
+    }
+    bool enabled()
+    {
+        static const bool on = [] {
+            const char *v = std::getenv("GOW_VU1N_X64");
+            const bool e = v && v[0] && v[0] != '0';
+            if (e)
+                std::fprintf(stderr, "[vu1x] x86-64 JIT on (inline tier %s)\n", inlineEnabled() ? "on" : "off");
+            return e;
+        }();
+        return on;
+    }
+    // A block without native code: translate, emit, register (key = vu1n::blockKey). False: unsupported (the exact engine
+    // keeps it; remembered so the translation is not tried again).
+    bool compile(uint32_t pc, const uint32_t *words, uint32_t count, uint64_t key)
+    {
+        State &g = state();
+        std::lock_guard<std::mutex> lock(g.mutex);
+        if (g.failed.count(key))
+            return false;
+        const auto t0 = std::chrono::steady_clock::now();
+        auto blk = std::make_unique<Block>();
+        blk->imms.reserve(8u * count + 16u);
+        if (!translate(pc, words, count, *blk))
+        {
+            g.failed.insert(key);
+            ++g.unsupported;
+            return false;
+        }
+        const std::vector<uint8_t> code = emit(*blk);
+        void *fn = g.arena.put(code);
+        if (!fn)
+        {
+            g.failed.insert(key);
+            return false;
+        }
+        vu1nRegisterBlock(key, reinterpret_cast<VU1NativeFn>(fn), count | (blk->readsEntry ? 0x10000u : 0u),
+                          blk->hasTail ? &blk->tail : nullptr, &blk->lanes);
+        g.blocks.push_back(std::move(blk));
+        ++g.compiled;
+        g.codeBytes += code.size();
+        g.nanos += static_cast<unsigned long long>(std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now() - t0).count());
+        return true;
+    }
