+    struct LowerInfo
+    {
+        uint32_t vfw = 0, vfr = 0, viReads = 0;
+        bool readsMac = false, readsClip = false, writesQ = false, native = true, callsOut = false;
+        uint8_t delay = 0, branch = 0;
+    };
+    inline uint32_t lowerSpecial(uint32_t l) { return (l & 3u) | ((l >> 4) & 0x7Cu); }
+    LowerInfo lowerInfo(uint32_t l)
+    {
+        LowerInfo info;
+        const uint32_t op = l >> 25;
+        if (l == 0u || l == 0x8000033Cu)
+            return info;
+        const uint32_t ft = (l >> 16) & 31u, fs = (l >> 11) & 31u, vid = (l >> 6) & 31u;
+        const auto bit = [](uint32_t r) { return 1u << r; };
+        if (op == 0x00) { info.vfw = bit(ft); info.viReads = bit(fs); }
+        else if (op == 0x01) { info.vfr = bit(fs); info.viReads = bit(ft); }
+        else if (op == 0x04 || op == 0x05) info.viReads = op == 0x05 ? (bit(fs) | bit(ft)) : bit(fs);
+        else if (op == 0x08 || op == 0x09) { info.delay = static_cast<uint8_t>(ft); info.viReads = bit(fs); }
+        else if (op == 0x10 || op == 0x11 || op == 0x12 || op == 0x13 || op == 0x1C) info.readsClip = op != 0x11;
+        else if (op == 0x18 || op == 0x1A || op == 0x1B) { info.readsMac = true; info.viReads = bit(fs); }
+        else if (isBranchOp(op))
+        {
+            info.branch = static_cast<uint8_t>(op);
+            if (op == 0x28 || op == 0x29)
+                info.viReads = bit(fs) | bit(ft);
+            else if (op == 0x24 || op == 0x25 || op == 0x2C || op == 0x2D || op == 0x2E || op == 0x2F)
+                info.viReads = bit(fs);
+        }
+        else if (op == 0x40)
+        {
+            const uint32_t fn = l & 0x3Fu;
+            if (fn == 0x30 || fn == 0x31 || fn == 0x34 || fn == 0x35) { info.delay = static_cast<uint8_t>(vid); info.viReads = bit(fs) | bit(ft); }
+            else if (fn == 0x32) { info.delay = static_cast<uint8_t>(ft); info.viReads = bit(fs); }
+            else if (fn >= 0x3C)
+            {
+                const uint32_t sp = lowerSpecial(l);
+                switch (sp)
+                {
+                case 0x30: case 0x31: info.vfw = bit(ft); info.vfr = bit(fs); break;
+                case 0x34: case 0x36: info.vfw = bit(ft); info.delay = static_cast<uint8_t>(fs); info.viReads = bit(fs); break;
+                case 0x35: case 0x37: info.vfr = bit(fs); info.delay = static_cast<uint8_t>(ft); info.viReads = bit(ft); break;
+                case 0x38: info.vfr = bit(fs) | bit(ft); info.writesQ = true; break;
+                case 0x39: info.vfr = bit(ft); info.writesQ = true; break;
+                case 0x3A: info.vfr = bit(fs) | bit(ft); info.writesQ = true; break;
+                case 0x3B: break;
+                case 0x3C: info.vfr = bit(fs); info.delay = static_cast<uint8_t>(ft); break;
+                case 0x3D: info.vfw = bit(ft); info.viReads = bit(fs); break;
+                case 0x3E: case 0x3F: info.viReads = bit(fs) | bit(ft); break;
+                case 0x64: info.vfw = bit(ft); break;
+                case 0x68: case 0x69: break;
+                case 0x6C: info.viReads = bit(fs); break;
+                default: info.native = false; info.callsOut = true; info.vfr = bit(fs) | bit(ft); info.vfw = bit(ft); break;
+                }
+            }
+            else { info.native = false; info.callsOut = true; }
+        }
+        else { info.native = false; info.callsOut = true; info.vfr = bit(fs) | bit(ft); info.vfw = bit(ft); }
+        info.vfw &= ~1u;
+        return info;
+    }
