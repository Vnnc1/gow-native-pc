+    // ------------------------------------------------------------------------------------------------- helpers
+    using namespace vu1n;
+    inline __m128 ldv(const VU1State &s, int r, bool norm) { return norm ? ldn(s, r) : ld(s, r); }
+    inline __m128 bcRt(__m128 v, int lane)
+    {
+        switch (lane)
+        {
+        case 0: return bc<0>(v);
+        case 1: return bc<1>(v);
+        case 2: return bc<2>(v);
+        default: return bc<3>(v);
+        }
+    }
+    template <int... M>
+    void stfDispatch(float *p, __m128 v, int m, std::integer_sequence<int, M...>)
+    {
+        ((m == M ? (stf<M>(p, v), 0) : 0), ...);
+    }
+    inline void stfRt(float *p, __m128 v, int m) { stfDispatch(p, v, m, std::make_integer_sequence<int, 16>{}); }
+    template <int S, int... M>
+    void itofDispatch(VU1State &s, int fs, int ft, int m, std::integer_sequence<int, M...>) { ((m == M ? (itof<S, M>(s, fs, ft), 0) : 0), ...); }
+    template <int S, int... M>
+    void ftoiDispatch(VU1State &s, int fs, int ft, int m, std::integer_sequence<int, M...>) { ((m == M ? (ftoi<S, M>(s, fs, ft), 0) : 0), ...); }
