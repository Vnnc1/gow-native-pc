     // next | kVu1nDone and runNative continues from there.
     static VU1Interpreter::NativeState::Slot *chain(VU1NativeCtx &n, uint32_t next);
+    // Finishes the current block even on false: callers must not invoke chain again for the same exit.
+    static bool chainSelf(VU1NativeCtx &n, uint32_t selfPc)
+    {
+        const void *current = n.slot;
+        return chain(n, selfPc) == current;
+    }
     // gow-native-pc: chain() for the x64 JIT (ps2_vu1_x64.inl): the next block's function, nullptr = return to runNative
