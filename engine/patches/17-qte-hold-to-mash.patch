new file mode 100644
index 0000000..6e7f972
--- /dev/null
+++ b/PS2Recomp/ps2xRuntime/include/runtime/gow_qte_hold.h
@@ -0,0 +1,76 @@
+#pragma once
+// gow-native-pc: accessibility. Holding a button instead of mashing it in God of War's minigames.
+//
+// The game's minigames ask for repeated presses ("Tap O" on a grapple or a context kill, the one thing in the game that
+// cannot be played slowly). This turns a held button into that train of presses. Only the player's own press is
+// repeated: nothing is pressed on its own, and a button that is not listed is never touched.
+//
+//   - A press shorter than `delay` goes through untouched, so single presses keep their meaning (grabbing an enemy,
+//     opening a chest): only a button the player keeps down becomes a train of presses.
+//   - Inside each press the button reads as released for `release` seconds only, so it is down about two thirds of the
+//     time; whether that is enough for a "Hold" prompt on the same button to keep charging has not been tried in game.
+//   - `release` must cover one pad poll: the game polls once per frame, so the default 34 ms (two frames at 60 fps)
+//     is seen even when the game runs at 30 fps.
+//
+// The logic is here, with no dependency on the runtime, so `tools/tests/qte_hold_test.cpp` can run it; `ps2_pad.cpp`
+// reads the player's choice from GOW_QTE_HOLD* and applies it to the finished button word of every input device.
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+
+namespace gow_qte
+{
+    struct Config
+    {
+        uint16_t buttons = 0u;  // the pad's button bits the assist repeats (PAD_CIRCLE...), 0 = off
+        double period = 0.1;    // seconds per press
+        double release = 0.034; // seconds of each period the button reads as released
+        double delay = 0.25;    // a button held this long starts the assist
+    };
+
+    // Button words are the pad's: one bit per button, a bit at 0 meaning pressed.
+    class HoldToMash
+    {
+    public:
+        uint16_t apply(const Config &config, uint16_t buttons, double now)
+        {
+            if (!config.buttons)
+                return buttons;
+            const double period = config.period > 0.0 ? config.period : 0.1;
+            const double release = std::min(std::max(config.release, 0.0), period * 0.5);
+            for (int bit = 0; bit < 16; ++bit)
+            {
+                const uint16_t mask = static_cast<uint16_t>(1u << bit);
+                if (!(config.buttons & mask))
+                    continue;
+                if (buttons & mask) // the player is not holding it
+                {
+                    m_held[bit] = false;
+                    m_presses[bit] = 0;
+                    continue;
+                }
+                if (!m_held[bit]) // first poll of this press
+                {
+                    m_held[bit] = true;
+                    m_since[bit] = now;
+                    continue;
+                }
+                const double held = now - m_since[bit] - config.delay;
+                if (held < 0.0)
+                    continue; // still a press the player could have made alone
+                if (std::fmod(held, period) >= period - release)
+                    buttons |= mask; // the gap the game reads as a release, so the next poll is a new press
+                m_presses[bit] = static_cast<int>(held / period) + 1;
+            }
+            return buttons;
+        }
+
+        // Presses the assist has made out of the press being held, for the diagnostics of ps2_pad.cpp.
+        int presses(int bit) const { return bit >= 0 && bit < 16 ? m_presses[bit] : 0; }
+
+    private:
+        bool m_held[16]{};
+        double m_since[16]{};
+        int m_presses[16]{};
+    };
+}
