+    // gow-native-pc: accessibility. Holding a button instead of mashing it in the game's minigames (runtime/gow_qte_hold.h
+    // explains how a held button becomes a train of presses). The launcher's Controls tab writes the variables:
+    //   GOW_QTE_HOLD          the actions it works on, by the names of kNombresAccion ("circle,cross"); "1" alone means
+    //                         circle, the button God of War's minigames ask for. Without it nothing changes.
+    //   GOW_QTE_HOLD_HZ       presses per second (default 10, 2 to 20).
+    //   GOW_QTE_HOLD_DELAY    ms a button has to be held before the assist starts (default 250): a shorter press is the
+    //                         player's own, untouched.
+    //   GOW_QTE_HOLD_RELEASE  ms of each press the button reads as released (default 34, two frames at 60 fps).
+    //   GOW_QTE_HOLD_DIAG=1   logs every press the assist makes.
+    const gow_qte::Config &configQte()
+    {
+        static const gow_qte::Config config = []
+        {
+            gow_qte::Config c;
+            const char *valor = std::getenv("GOW_QTE_HOLD");
+            if (!valor || !*valor || std::strcmp(valor, "0") == 0)
+                return c;
+            const std::string texto(valor);
+            if (texto == "1")
+                c.buttons = kBitAccion[AccCirculo];
+            size_t pos = texto == "1" ? texto.size() : 0;
+            while (pos < texto.size())
+            {
+                size_t fin = texto.find(',', pos);
+                if (fin == std::string::npos)
+                    fin = texto.size();
+                const std::string nombre = texto.substr(pos, fin - pos);
+                for (size_t a = 0; a <= AccFuria; ++a)
+                    if (nombre == kNombresAccion[a])
+                        c.buttons |= kBitAccion[a];
+                pos = fin + 1;
+            }
+            if (!c.buttons)
+                return c;
+            const auto numero = [](const char *nombre, double porDefecto, double minimo, double maximo)
+            {
+                const char *bruto = std::getenv(nombre);
+                const double v = bruto && *bruto ? std::atof(bruto) : porDefecto;
+                return v < minimo ? minimo : v > maximo ? maximo : v;
+            };
+            c.period = 1.0 / numero("GOW_QTE_HOLD_HZ", 10.0, 2.0, 20.0);
+            c.release = numero("GOW_QTE_HOLD_RELEASE", 34.0, 17.0, 200.0) / 1000.0;
+            c.delay = numero("GOW_QTE_HOLD_DELAY", 250.0, 0.0, 2000.0) / 1000.0;
+            std::fprintf(stderr, "[gow-qte] hold to mash: buttons %04x, %.0f presses/s after %.0f ms\n", c.buttons,
+                         1.0 / c.period, c.delay * 1000.0);
+            return c;
+        }();
+        return config;
+    }
+
+    // Every listed button the player keeps down reads as a train of presses; the rest of the word is untouched.
+    uint16_t repetirMantenidos(uint16_t btns)
+    {
+        const gow_qte::Config &config = configQte();
+        if (!config.buttons)
+            return btns;
+        static const bool diag = []
+        {
+            const char *valor = std::getenv("GOW_QTE_HOLD_DIAG");
+            return valor && std::strcmp(valor, "0") != 0;
+        }();
+        static gow_qte::HoldToMash asistencia;
+        static int registradas[16] = {};
+        const uint16_t resultado = asistencia.apply(config, btns, GetTime());
+        if (diag)
+            for (int bit = 0; bit < 16; ++bit)
+                if (const int n = asistencia.presses(bit); n != registradas[bit])
+                {
+                    registradas[bit] = n;
+                    if (n > 0)
+                        std::fprintf(stderr, "[gow-qte] %04x press %d\n", 1u << bit, n);
+                }
+        return resultado;
+    }
 }
 
