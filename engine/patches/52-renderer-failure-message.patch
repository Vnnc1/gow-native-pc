+
+// gow-native-pc (patch 52): when the GS renderer could not start no frame ever arrives and the window kept the magenta
+// placeholder, which players reported as a frozen pink screen. Say why instead, in the launcher's language.
+static void drawRendererFailure(GSSharedPresent::RendererFailure failure)
+{
+    const char *v = std::getenv("TOBIICHI_IDIOMA");
+    const std::string language = v ? v : "en";
+    const bool es = language == "es", pt = language == "pt";
+    const bool noContext = failure == GSSharedPresent::RendererFailure::NoContext;
+    const char *lines[4] = {
+        es ? "No se pudo iniciar el renderizador de la GPU." : pt ? "Nao foi possivel iniciar o renderizador da GPU." : "The GPU renderer could not start.",
+        noContext ? (es ? "El driver de video no ofrece OpenGL 4.3." : pt ? "O driver de video nao oferece OpenGL 4.3." : "The graphics driver does not offer OpenGL 4.3.")
+                  : (es ? "El driver de video rechazo los shaders del juego." : pt ? "O driver de video recusou os shaders do jogo." : "The graphics driver rejected the game's shaders."),
+        noContext ? (es ? "Instala el driver mas reciente de NVIDIA, AMD o Intel (no sirven el adaptador basico de Microsoft ni el Escritorio remoto)."
+                        : pt ? "Instale o driver mais recente da NVIDIA, AMD ou Intel (o adaptador basico da Microsoft e a Area de Trabalho Remota nao servem)."
+                             : "Install the latest driver from NVIDIA, AMD or Intel (Microsoft Basic Display Adapter and Remote Desktop do not work).")
+                  : (es ? "Actualiza el driver de video y envia standalone.log en un reporte de error."
+                        : pt ? "Atualize o driver de video e envie o standalone.log num relato de bug."
+                             : "Update the graphics driver and send standalone.log with a bug report."),
+        es ? "Detalles en el registro: lineas [gs-hw]." : pt ? "Detalhes no log: linhas [gs-hw]." : "Details in the log: [gs-hw] lines."};
+    const int width = GetScreenWidth(), height = GetScreenHeight();
+    DrawRectangle(0, 0, width, height, BLACK);
+    const int size = std::max(16, height / 36), gap = size / 2;
+    int y = height / 2 - (4 * size + 3 * gap) / 2;
+    for (int i = 0; i < 4; ++i, y += size + gap)
+    {
+        int lineSize = i == 0 ? size + size / 3 : size;
+        while (lineSize > 10 && MeasureText(lines[i], lineSize) > width - 32) // a long line shrinks to fit the window
+            --lineSize;
+        DrawText(lines[i], std::max(8, (width - MeasureText(lines[i], lineSize)) / 2), y, lineSize, i == 0 ? RED : RAYWHITE);
+    }
 }
 
