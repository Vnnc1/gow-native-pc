--- /dev/null
+++ b/PS2Recomp/ps2xRuntime/include/runtime/gs/gs_sampler_state.h
@@ -0,0 +1,23 @@
+#pragma once
+#include <array>
+
+// Sampler parameters belong to the GL texture object. Reset after external writes
+// or storage initialization; content invalidation alone need not change them.
+struct GSSamplerState
+{
+    std::array<int, 4> values{{-1, -1, -1, -1}};
+
+    template<class Set>
+    unsigned apply(const std::array<int, 4>& requested, Set set)
+    {
+        unsigned changed = 0;
+        for (unsigned i = 0; i < values.size(); ++i)
+            if (values[i] != requested[i])
+            {
+                set(i, requested[i]);
+                values[i] = requested[i];
+                ++changed;
+            }
+        return changed;
+    }
+};
