+    // ---- texture packs (gow-native-pc, patch 52) -------------------------------------------------------------------
+    // A texture's name as PCSX2 names its dumps and replacements (GSTextureCache::HashCacheKey + GSTextureReplacements),
+    // so existing PCSX2 packs work unchanged: "<texture hash>-<palette hash>-<bits>" (paletted formats) or
+    // "<texture hash>-<bits>". texture hash = XXH3-64 of the texture's memory: whole GS blocks in block-row order where the
+    // texture covers at least one block in each axis and its format uses whole words (CT32, CT16, T8, T4), otherwise its
+    // rows unswizzled (tw indices of 1 byte for paletted formats, tw RGBA words expanded with TEXA for colour formats).
+    // palette hash = XXH3-64 of the 16 / 256 32-bit palette entries in index order. bits = PSM | TW << 6 | TH << 10, plus
+    // TEXA (TA0 << 15, AEM << 23, TA1 << 24) for 24/16-bit colour. Base level only (PCSX2 adds the mip levels to the hash
+    // only while it draws with hardware mipmapping); no regions.
+    // The texture hash is kept in `tex` until the texture is decoded again; the palette hash per CLUT state.
+    std::unordered_map<uint64_t, uint64_t> pcsx2PaletteHashes; // (CLUT content hash, CSA, CPSM, PSM, TEXA) -> XXH3
+    bool pcsx2TextureHash(const GSDrawState &s, Texture &tex)
+    {
+        if (tex.pcsx2Hashed)
+            return true;
+        const GSTex0Reg &t = s.context.tex0;
+        uint32_t bx = 8, by = 8;
+        bool wholeWords = false;
+        switch (t.psm)
+        {
+        case GS_PSM_CT32: wholeWords = true; break;
+        case GS_PSM_CT16: case GS_PSM_CT16S: bx = 16; wholeWords = true; break;
+        case GS_PSM_T8: bx = 16; by = 16; wholeWords = true; break;
+        case GS_PSM_T4: bx = 32; by = 16; wholeWords = true; break;
+        case GS_PSM_CT24: case GS_PSM_T8H: case GS_PSM_T4HL: case GS_PSM_T4HH: break;
+        default: return false; // depth formats and the rest: never replaced
+        }
+        const uint32_t tw = 1u << std::min<uint32_t>(t.tw, 10u), th = 1u << std::min<uint32_t>(t.th, 10u);
+        XXH3_state_t state;
+        XXH3_64bits_reset(&state);
+        if (wholeWords && tw >= bx && th >= by)
+        {
+            const GSSwizzle::Format &f = GSSwizzle::GetFormat(t.psm);
+            for (uint32_t y = 0; y < th; y += by)
+                for (uint32_t x = 0; x < tw; x += bx)
+                {
+                    const uint32_t block = GSSwizzle::Locate(f, t.tbp0, t.tbw, x, y).byte >> 8u;
+                    XXH3_64bits_update(&state, vram + static_cast<size_t>(block & 0x3FFFu) * 256u, 256u);
+                }
+        }
+        else if (isIndexed(t.psm))
+        {
+            std::vector<uint8_t> row(tw);
+            for (uint32_t y = 0; y < th; ++y)
+            {
+                GSMem::ReadIndexRun(vram, t.psm, t.tbp0, t.tbw, 0u, y, tw, row.data());
+                XXH3_64bits_update(&state, row.data(), tw);
+            }
+        }
+        else
+        {
+            const GSSwizzle::Format &f = GSSwizzle::GetFormat(t.psm);
+            const bool sixteen = t.psm == GS_PSM_CT16 || t.psm == GS_PSM_CT16S;
+            std::vector<uint32_t> row(tw);
+            for (uint32_t y = 0; y < th; ++y)
+            {
+                const GSSwizzle::AxisPart part = GSSwizzle::RowPart(f, t.tbp0, t.tbw, y);
+                for (uint32_t x = 0; x < tw; ++x)
+                {
+                    const GSSwizzle::Location at = GSSwizzle::Combine(f, part, GSSwizzle::ColumnPart(f, x));
+                    const uint32_t raw = GSSwizzle::LoadAt(f, vram + at.byte, at.shift);
+                    row[x] = GSCpuInternal::applyTexa(s.texa, t.psm, sixteen ? GSCpuInternal::Rgba5551ToRgba8888(static_cast<uint16_t>(raw)) : raw);
+                }
+                XXH3_64bits_update(&state, row.data(), tw * 4u);
+            }
+        }
+        tex.pcsx2Hash = XXH3_64bits_digest(&state);
+        tex.pcsx2Hashed = true;
+        return true;
+    }
+    uint64_t pcsx2PaletteHash(const GSDrawState &s)
+    {
+        const GSTex0Reg &t = s.context.tex0;
+        uint64_t key = clutHash;
+        for (const uint64_t v : {static_cast<uint64_t>(t.csa), static_cast<uint64_t>(t.cpsm), static_cast<uint64_t>(t.psm),
+                                 static_cast<uint64_t>(s.texa.ta0), static_cast<uint64_t>(s.texa.ta1), static_cast<uint64_t>(s.texa.aem)})
+            key = (key ^ v) * 1099511628211ull;
+        const auto it = pcsx2PaletteHashes.find(key);
+        if (it != pcsx2PaletteHashes.end())
+            return it->second;
+        uint32_t pal[256];
+        store.BuildPalette(s, pal); // index order, 32-bit (16-bit CLUTs expanded with TEXA, as PCSX2's GSClut)
+        const uint64_t hash = XXH3_64bits(pal, (t.psm == GS_PSM_T8 || t.psm == GS_PSM_T8H ? 256u : 16u) * 4u);
+        if (pcsx2PaletteHashes.size() > 4096u)
+            pcsx2PaletteHashes.clear();
+        pcsx2PaletteHashes.emplace(key, hash);
+        return hash;
+    }
+    // the bits field of the name (the TCC bit 0x4000 of older PCSX2 dumps is ignored, as PCSX2 does when it loads them)
+    static uint32_t pcsx2Bits(const GSDrawState &s)
+    {
+        const GSTex0Reg &t = s.context.tex0;
+        uint32_t bits = (t.psm & 0x3Fu) | ((t.tw & 0xFu) << 6u) | ((t.th & 0xFu) << 10u);
+        if (t.psm == GS_PSM_CT24 || t.psm == GS_PSM_CT16 || t.psm == GS_PSM_CT16S)
+            bits |= (static_cast<uint32_t>(s.texa.ta0) << 15u) | (static_cast<uint32_t>(s.texa.aem ? 1u : 0u) << 23u) |
+                    (static_cast<uint32_t>(s.texa.ta1) << 24u);
+        return bits;
+    }
+    struct PackKey
+    {
+        uint64_t tex = 0, pal = 0;
+        uint32_t bits = 0;
+        bool operator==(const PackKey &) const = default;
+    };
+    struct PackKeyHash
+    {
+        size_t operator()(const PackKey &k) const { return static_cast<size_t>((k.tex * 1099511628211ull ^ k.pal) * 1099511628211ull ^ k.bits); }
+    };
+    static bool parsePackName(const std::string &stem, PackKey &key)
