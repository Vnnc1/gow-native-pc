+    // The pack: GOW_TEXTURE_PACK=<folder> (PNG files named as above, in any subfolder; their pixels are the texture's
+    // colours in GS units, alpha 128 = opaque, as PCSX2 writes and reads them), GOW_TEXTURE_PACK_MB = GPU memory for its
+    // images (default 1024). Images are decoded on a worker thread: until one is ready the draw uses the game's texture.
+    // Uploaded here (the render thread owns the GL context) with mipmaps, kept while used, least recently used out first.
+    class TexturePack
+    {
+    public:
+        struct Entry
+        {
+            std::string path;
+            GLuint id = 0;
+            uint32_t width = 0, height = 0;
+            uint64_t bytes = 0, lastUse = 0;
+            enum class State : uint8_t { Idle, Queued, Ready, Failed } state = State::Idle;
+        };
+        ~TexturePack()
+        {
+            {
+                std::lock_guard<std::mutex> lock(m_mutex);
+                m_stop = true;
+            }
+            m_wake.notify_all();
+            if (m_worker.joinable())
+                m_worker.join();
+        }
+        void open()
+        {
+            const char *dir = std::getenv("GOW_TEXTURE_PACK");
+            if (!dir || !*dir)
+                return;
+            if (const char *mb = std::getenv("GOW_TEXTURE_PACK_MB"))
+                m_budget = std::max<uint64_t>(64u, std::strtoull(mb, nullptr, 10)) << 20u;
+            std::error_code error;
+            for (auto it = std::filesystem::recursive_directory_iterator(std::filesystem::path(dir), error);
+                 !error && it != std::filesystem::recursive_directory_iterator(); it.increment(error))
+            {
+                if (!it->is_regular_file(error))
+                    continue;
+                std::string ext = it->path().extension().string();
+                std::transform(ext.begin(), ext.end(), ext.begin(), [](unsigned char c) { return static_cast<char>(std::tolower(c)); });
+                PackKey key;
+                if (ext == ".png" && parsePackName(it->path().stem().string(), key))
+                    m_entries[key].path = it->path().string();
+            }
+            std::fprintf(stderr, "[gs-texpack] %zu images in %s, %llu MB for them\n", m_entries.size(), dir,
+                         static_cast<unsigned long long>(m_budget >> 20u));
+            if (!m_entries.empty())
+                m_worker = std::thread([this] { work(); });
+        }
+        bool enabled() const { return !m_entries.empty(); }
+        bool has(const PackKey &key) const { return m_entries.count(key) != 0u; }
+        // the image's texture when it is ready (0 meanwhile, or when the pack has none)
+        GLuint lookup(const Api &g, const PackKey &key, uint64_t now)
+        {
+            const auto it = m_entries.find(key);
+            if (it == m_entries.end())
+                return 0u;
+            Entry &e = it->second;
+            e.lastUse = now;
+            if (e.state == Entry::State::Ready)
+            {
+                ++m_hits;
+                return e.id;
+            }
+            if (e.state == Entry::State::Idle)
+            {
+                e.state = Entry::State::Queued;
+                std::lock_guard<std::mutex> lock(m_mutex);
+                m_queue.push_back(&e);
+                m_wake.notify_one();
+            }
+            return 0u;
+        }
+        // once per frame on the render thread: upload what the worker decoded, then keep the images within the budget
+        void service(const Api &g, uint64_t now)
+        {
+            std::vector<Decoded> done;
+            {
+                std::lock_guard<std::mutex> lock(m_mutex);
+                done.swap(m_done);
+            }
+            for (Decoded &d : done)
+            {
+                Entry &e = *d.entry;
+                if (d.pixels.empty())
+                {
+                    e.state = Entry::State::Failed;
+                    std::fprintf(stderr, "[gs-texpack] cannot read %s\n", e.path.c_str());
+                    continue;
+                }
+                g.GenTextures(1, &e.id);
+                g.ActiveTexture(kTexture0);
+                g.BindTexture(kTexture2D, e.id);
+                g.TexImage2D(kTexture2D, 0, static_cast<GLint>(kRgba8), static_cast<GLsizei>(d.width), static_cast<GLsizei>(d.height), 0, kRgba,
+                             kUnsignedByte, d.pixels.data());
+                g.GenerateMipmap(kTexture2D);
+                e.width = d.width;
+                e.height = d.height;
+                e.bytes = static_cast<uint64_t>(d.width) * d.height * 4u * 4u / 3u;
+                e.state = Entry::State::Ready;
+                m_resident += e.bytes;
+                ++m_loads;
+            }
+            while (m_resident > m_budget)
+            {
+                Entry *oldest = nullptr;
+                for (auto &kv : m_entries)
+                    if (kv.second.state == Entry::State::Ready && kv.second.lastUse < now && (!oldest || kv.second.lastUse < oldest->lastUse))
+                        oldest = &kv.second;
+                if (!oldest)
+                    break;
+                g.DeleteTextures(1, &oldest->id);
+                oldest->id = 0;
+                oldest->state = Entry::State::Idle;
+                m_resident -= oldest->bytes;
+                ++m_evictions;
+            }
+            static const bool stats = std::getenv("GOW_TEXTURE_PACK_STATS") != nullptr;
+            if (stats && ++m_frames % 300u == 0u)
+                std::fprintf(stderr, "[gs-texpack] hits=%llu loads=%llu evictions=%llu resident=%llu MB\n",
+                             static_cast<unsigned long long>(m_hits), static_cast<unsigned long long>(m_loads),
+                             static_cast<unsigned long long>(m_evictions), static_cast<unsigned long long>(m_resident >> 20u));
+        }
+
+    private:
+        struct Decoded
+        {
+            Entry *entry = nullptr;
+            uint32_t width = 0, height = 0;
+            std::vector<uint8_t> pixels;
+        };
+        void work()
+        {
+            for (;;)
+            {
+                Entry *e = nullptr;
+                {
+                    std::unique_lock<std::mutex> lock(m_mutex);
+                    m_wake.wait(lock, [this] { return m_stop || !m_queue.empty(); });
