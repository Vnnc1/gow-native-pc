+            key = {a, b, bits & ~0x4000u};
+        else if (std::sscanf(stem.c_str(), "%llx-%x%n", &a, &bits, &n) == 2 && stem[static_cast<size_t>(n)] == '\0')
+            key = {a, 0u, bits & ~0x4000u};
+        else
+            return false;
+        return true;
+    }
+    bool pcsx2Key(const GSDrawState &s, Texture &tex, PackKey &key)
+    {
+        if (!pcsx2TextureHash(s, tex))
