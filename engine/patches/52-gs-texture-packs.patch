+            return;
+        const GSTex0Reg &t = s.context.tex0;
+        if (isIndexed(t.psm))
+            std::fprintf(pcsx2Names, "%llx-%llx-%08x", static_cast<unsigned long long>(key.tex), static_cast<unsigned long long>(key.pal), key.bits);
+        else
