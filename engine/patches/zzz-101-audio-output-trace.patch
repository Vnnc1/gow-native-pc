diff --git a/PS2Recomp/ps2xIOP/src/emulator/core/sound_output_trace.h b/PS2Recomp/ps2xIOP/src/emulator/core/sound_output_trace.h
new file mode 100644
--- /dev/null
+++ b/PS2Recomp/ps2xIOP/src/emulator/core/sound_output_trace.h
@@ -0,0 +1,76 @@
+#pragma once
+#include <array>
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+
+namespace ps2x::iop::detail
+{
+// Diagnostic only. Calls are serialized by the existing output mutex; dump after audio shutdown.
+struct SoundOutputTrace
+{
+    using Clock = std::chrono::steady_clock;
+    struct Event {
+        uint64_t kind, t, available, requested, produced, wait, drain, callbackGap;
+        uint64_t producerKnown, producerAge, producerGap, lastBatch, resets, publications, totalPublished;
+    };
+    static constexpr size_t Capacity = 512;
+    std::array<Event, Capacity> events{};
+    size_t count = 0;
+    uint64_t overflow = 0, resets = 0, publications = 0, totalPublished = 0;
+    uint64_t lastPublication = 0, producerGap = 0, lastBatch = 0, lastCallback = 0;
+    bool producerKnown = false, callbackKnown = false, dumped = false;
+    const Clock::time_point origin = Clock::now();
+
+    uint64_t now() const {
+        return static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::microseconds>(Clock::now() - origin).count());
+    }
+    void record(uint64_t kind, uint64_t t, uint64_t observed, uint64_t available,
+                uint64_t requested = 0, uint64_t produced = 0, uint64_t wait = 0,
+                uint64_t drain = 0, uint64_t callbackGap = 0) {
+        if (count == Capacity) { ++overflow; return; }
+        events[count++] = {kind, t, available, requested, produced, wait, drain, callbackGap,
+            producerKnown, producerKnown ? observed - lastPublication : 0, producerGap,
+            lastBatch, resets, publications, totalPublished};
+    }
+    void reset(uint64_t t, uint64_t available) {
+        ++resets;
+        record(0, t, t, available);
+        producerKnown = false;
+        lastBatch = producerGap = 0;
+    }
+    void publish(uint64_t t, uint64_t frames) {
+        producerGap = producerKnown ? t - lastPublication : 0;
+        producerKnown = true;
+        lastPublication = t;
+        lastBatch = frames;
+        ++publications;
+        totalPublished += frames;
+    }
+    void drained(uint64_t started, uint64_t acquired, uint64_t ended, uint64_t available,
+                 uint64_t requested, uint64_t produced) {
+        const uint64_t gap = callbackKnown ? started - lastCallback : 0;
+        if (produced < requested || acquired - started >= 1000 || ended - acquired >= 1000)
+            record(produced < requested ? 1 : 2, started, acquired, available,
+                   requested, produced, acquired - started, ended - acquired, gap);
+        lastCallback = started;
+        callbackKnown = true;
+    }
+    void dump(std::FILE *output = stderr) {
+        if (dumped) return;
+        dumped = true;
+        for (size_t i = 0; i < count; ++i) {
+            const auto &e = events[i];
+            std::fprintf(output, "[gow-audio-trace] kind=%llu t_us=%llu available=%llu requested=%llu produced=%llu wait_us=%llu drain_us=%llu callback_gap_us=%llu producer_known=%llu producer_age_us=%llu producer_gap_us=%llu last_batch=%llu resets=%llu publications=%llu total_published=%llu\n",
+                (unsigned long long)e.kind, (unsigned long long)e.t, (unsigned long long)e.available,
+                (unsigned long long)e.requested, (unsigned long long)e.produced, (unsigned long long)e.wait,
+                (unsigned long long)e.drain, (unsigned long long)e.callbackGap, (unsigned long long)e.producerKnown,
+                (unsigned long long)e.producerAge, (unsigned long long)e.producerGap, (unsigned long long)e.lastBatch,
+                (unsigned long long)e.resets, (unsigned long long)e.publications, (unsigned long long)e.totalPublished);
+        }
+        std::fprintf(output, "[gow-audio-trace] end=1 events=%zu overflow=%llu resets=%llu publications=%llu total_published=%llu\n",
+            count, (unsigned long long)overflow, (unsigned long long)resets,
+            (unsigned long long)publications, (unsigned long long)totalPublished);
+    }
+};
+}
