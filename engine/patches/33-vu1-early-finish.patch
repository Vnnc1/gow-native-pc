+++ b/PS2Recomp/ps2xRuntime/include/runtime/ps2_memory.h
@@ -494,6 +494,7 @@ public:
     void runGsWorkerJob(GsWorkerJob &job);
     void gsWorkerLoop();
     bool m_gsWorkerEnabled = false;
+    bool m_vu1EarlyFinish = false; // bound large VIF1 submissions while asynchronous FINISH is used
     std::thread m_gsWorker;
     std::thread::id m_gsWorkerId;
     std::mutex m_gsWorkerMutex;
