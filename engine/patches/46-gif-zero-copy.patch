+void PS2Memory::setGifArbiter(GifArbiter *arbiter)
+{
+    m_gifArbiter = arbiter;
+    if (arbiter)
+        arbiter->setRecycleFn([](std::vector<uint8_t> &&buffer) { returnDmaBuffer(std::move(buffer)); });
+}
+
+// The masked FIFO copies and the callback reads in place, so there `data` is left to the caller (runGsWorkerJob
+// returns it to the DMA buffer pool); only the arbiter takes it over, and gives it back through its recycle callback.
+void PS2Memory::submitGifPacketBuffer(GifPathId pathId, std::vector<uint8_t> &&data, bool path2DirectHl)
+{
+    const uint32_t sizeBytes = static_cast<uint32_t>(data.size());
+    if (sizeBytes < 16)
+        return;
+
+    if (pathId == GifPathId::Path3)
+    {
+        if (m_path3Masked)
+        {
+            m_path3MaskedFifo.emplace_back(data.begin(), data.end()); // the FIFO keeps its own copy
+            return;
+        }
+        flushMaskedPath3Packets(false);
+    }
+
+    if (m_gifArbiter)
+        m_gifArbiter->submitBuffer(pathId, std::move(data), path2DirectHl); // zero-copy handover
+    else if (m_gifPacketCallback)
+        m_gifPacketCallback(data.data(), sizeBytes);
+}
