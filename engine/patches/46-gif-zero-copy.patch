             if (!pkt.data.empty())
                 m_processFn(pkt.pathId, pkt.data.data(), static_cast<uint32_t>(pkt.data.size()));
         }
+        // buffers taken over by submitBuffer go back to their owner's pool once processed
+        if (m_recycleFn)
+            for (size_t i = 0u; i < count; ++i)
