diff --git a/PS2Recomp/ps2xRuntime/include/runtime/gow_prompt_input.h b/PS2Recomp/ps2xRuntime/include/runtime/gow_prompt_input.h
new file mode 100644
--- /dev/null
+++ b/PS2Recomp/ps2xRuntime/include/runtime/gow_prompt_input.h
@@ -0,0 +1,60 @@
+#pragma once
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <cctype>
+#include <cmath>
+#include <string>
+
+// Values match the renderer's styles: keyboard, Xbox, DualShock 4, DualSense.
+inline int gowPromptFamily(const char *name) {
+    std::string s = name ? name : "";
+    std::transform(s.begin(), s.end(), s.begin(), [](unsigned char c) { return char(std::tolower(c)); });
+    if (s.find("xbox") != std::string::npos || s.find("xinput") != std::string::npos) return 2;
+    if (s.find("dualsense") != std::string::npos || s.find("ps5") != std::string::npos) return 4;
+    for (const char *part : {"dualshock", "ps4", "sony", "playstation", "wireless controller"})
+        if (s.find(part) != std::string::npos) return 3;
+    return 2;
+}
+
+namespace gow_prompt {
+struct Input {
+    bool focused = true;
+    std::array<bool, 520> keys{};
+    std::array<bool, 4> connected{};
+    std::array<std::array<bool, 18>, 4> buttons{};
+    std::array<std::array<float, 4>, 4> sticks{};
+};
+class Tracker {
+    Input previous{};
+    bool used = false;
+public:
+    int slot = -1;
+    bool mouse = false;
+    void update(const Input &now) {
+        if (slot >= 0 && !now.connected[slot]) slot = -1;
+        if (!used && slot < 0)
+            for (int p=0; p<4; ++p) if (now.connected[p]) { slot=p; break; }
+        if (now.focused && previous.focused) {
+            for (int p=0; p<4; ++p) {
+                if (!now.connected[p]) continue;
+                bool edge = false;
+                for (int b=1; b<18; ++b) edge |= now.buttons[p][b] && !previous.buttons[p][b];
+                for (int a=0; a<4; ++a) {
+                    edge |= now.sticks[p][a] > .35f && previous.sticks[p][a] <= .35f;
+                    edge |= now.sticks[p][a] < -.35f && previous.sticks[p][a] >= -.35f;
+                }
+                if (edge) { slot=p; used=true; }
+            }
+            // Keyboard wins a simultaneous poll; held buttons and drift cannot steal focus back.
+            for (size_t k=0; k<now.keys.size(); ++k)
+                if (now.keys[k] && !previous.keys[k]) { slot=-1; mouse=k>=512; used=true; break; }
+        }
+        previous=now;
+    }
+};
+inline std::atomic<int> activeSlot{-2};
+inline std::atomic<bool> preferMouse{false};
+}
+int gowPromptGamepad();
+void gowPromptPoll();
