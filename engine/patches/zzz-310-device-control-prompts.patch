+int gowPromptGamepad()
+{
+    const int slot = gow_prompt::activeSlot.load(std::memory_order_relaxed);
+    if (slot != -2) return slot;
+    for (int p = 0; p < 4; ++p) if (IsGamepadAvailable(p)) return p;
+    return -1;
+}
+
+void gowPromptPoll()
+{
+    // Poll on the window thread, then share only the selected slot with the guest.
+    static gow_prompt::Tracker tracker;
+    gow_prompt::Input input;
+    input.focused = IsWindowFocused();
+    const auto &map = mapaTeclas();
+    if (map.activo) {
+        for (const auto &codes : map.codigos)
+            for (int code : codes) {
+                const int index = code >= 1000 ? 512 + code - 1000 : normalizedKey(code);
+                if (index >= 0 && index < int(input.keys.size())) input.keys[index] = codigoPulsado(code);
+            }
+    } else {
+        for (int key : {KEY_W,KEY_A,KEY_S,KEY_D,KEY_UP,KEY_DOWN,KEY_LEFT,KEY_RIGHT,KEY_SPACE,
+                        KEY_F,KEY_Q,KEY_E,KEY_V,KEY_X,KEY_C,KEY_Z,KEY_ENTER,KEY_TAB,KEY_ESCAPE,
+                        KEY_LEFT_SHIFT,KEY_RIGHT_SHIFT,KEY_LEFT_CONTROL,KEY_RIGHT_CONTROL,KEY_KP_0,KEY_KP_1})
+            input.keys[key] = IsKeyDown(key);
+        input.keys[512] = IsMouseButtonDown(MOUSE_BUTTON_LEFT);
+        input.keys[513] = IsMouseButtonDown(MOUSE_BUTTON_RIGHT);
+    }
+    for (int p = 0; p < 4; ++p) {
+        input.connected[p] = IsGamepadAvailable(p);
+        if (!input.connected[p]) continue;
+        for (int b = 1; b < 18; ++b) input.buttons[p][b] = IsGamepadButtonDown(p,b);
+        for (int axis = 0; axis < 4; ++axis) input.sticks[p][axis] = GetGamepadAxisMovement(p,axis);
+    }
+    tracker.update(input);
+    gow_prompt::activeSlot.store(tracker.slot, std::memory_order_relaxed);
+    gow_prompt::preferMouse.store(tracker.mouse, std::memory_order_relaxed);
+}
+
+int tobiichiCodigosAccion(const char *accion, int *codigos, int max)
+{
+    size_t a = NumAcciones;
+    for (size_t i = 0; i < NumAcciones; ++i)
+        if (std::strcmp(kNombresAccion[i], accion) == 0)
+            a = i;
+    if (a == NumAcciones || max <= 0)
+        return 0;
+    const MapaTeclas &m = mapaTeclas();
+    int n = 0;
+    if (m.activo)
+    {
+        const bool mouse = gow_prompt::preferMouse.load(std::memory_order_relaxed);
+        const auto *codes = &m.codigos[a];
+        // D-pad spells and the Rage shortcut produce the same guest button bits.
+        if (codes->empty() && a <= AccFuria)
+            for (size_t alias = AccPoseidon; alias <= AccFuria; ++alias)
+                if (!m.codigos[alias].empty() && (kBitAccion[alias] & kBitAccion[a]) == kBitAccion[a]) {
+                    codes = &m.codigos[alias]; break;
+                }
+        for (bool preferred : {true, false})
+            for (const int c : *codes)
+                if (((c >= 1000) == mouse) == preferred && n < max) codigos[n++] = c;
+        return n;
+    }
+    static const bool dmc5 = [] {
+        const char *val = std::getenv("TOBIICHI_DMC5_CONTROLS");
+        return val == nullptr || std::strcmp(val, "0") != 0;
+    }();
+
+    int c = -1;
+    switch (a)
+    {
+    case AccArriba: c = KEY_UP; break;
+    case AccAbajo: c = KEY_DOWN; break;
+    case AccIzquierda: c = KEY_LEFT; break;
+    case AccDerecha: c = KEY_RIGHT; break;
+    case AccCruz: c = dmc5 ? KEY_SPACE : KEY_X; break;
+    case AccCirculo: c = dmc5 ? KEY_F : KEY_C; break;
+    case AccCuadrado: c = dmc5 ? 1000 + MOUSE_BUTTON_LEFT : KEY_Z; break;
+    case AccTriangulo: c = dmc5 ? 1000 + MOUSE_BUTTON_RIGHT : KEY_V; break;
+    case AccL1: c = dmc5 ? KEY_LEFT_SHIFT : KEY_Q; break;
+    case AccR1: c = KEY_E; break;
+    case AccL2: c = dmc5 ? -1 : KEY_LEFT_SHIFT; break;
+    case AccR2: c = dmc5 ? KEY_Q : KEY_RIGHT_SHIFT; break;
+    case AccL3:
+    case AccR3:
+    case AccFuria: c = dmc5 ? KEY_V : -1; break;
+    case AccStart: c = KEY_ENTER; break;
+    case AccSelect: c = KEY_TAB; break;
+    case AccLiArriba: c = KEY_W; break;
+    case AccLiAbajo: c = KEY_S; break;
+    case AccLiIzq: c = KEY_A; break;
+    case AccLiDer: c = KEY_D; break;
+    case AccLdMod: c = KEY_LEFT_CONTROL; break;
+    default: break;
+    }
+    if (c >= 0)
+        codigos[n++] = c;
+    return n;
+}
