+// Flash prompt recognition adapted from Tobiichi-Port before a25331d (GPL-3.0).
+#include "ps2_runtime.h"
+#include "ps2_runtime_macros.h"
+#include "raylib.h"
+#include "runtime/gow_prompt_input.h"
