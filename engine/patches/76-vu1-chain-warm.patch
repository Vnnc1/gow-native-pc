+// gow-native-pc (patch 76): the entry-timing memo's hit test, split out of blockTiming so the chain path can try it without
+// a call (the memo answers ~99% of the blocks that need exact entry timing). Same predicate as blockTiming's first branch.
+// A template so NativeState, a private member of VU1Interpreter, is only named inside its member functions.
+namespace
+{
+template <typename NS>
+bool vu1nMemoTry(const NS &ns, const typename NS::Slot &sl, uint64_t start, const uint8_t *&cyc, uint32_t &cycId)
+{
+    if (!sl.memoable || !sl.memoCyc || ns.histCount == 0u)
+        return false;
+    const typename NS::Hist *pred = &ns.hist[(ns.histNext + NS::kHist - 1u) % NS::kHist];
+    if (pred->end != start || pred->end - pred->start < ns.maxLat || ns.arraysReadyBy > start)
+        return false;
+    if (sl.memoPred != pred->bt || sl.memoPredId != pred->cycId)
+        return false;
+    cyc = sl.memoCyc;
+    cycId = sl.memoId;
+    return true;
+}
+}
