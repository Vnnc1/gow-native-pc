+@contextmanager
+def changed_output(path):
+    """Keep Ninja's dependency timestamps when an IOP module's generated code is unchanged."""
+    buffer = io.StringIO()
+    yield buffer
+    text = buffer.getvalue()
+    old = open(path, encoding='utf-8').read() if os.path.exists(path) else None
+    if text != old:
+        with open(path + '.tmp', 'w', encoding='utf-8', newline='\n') as output:
+            output.write(text)
+        os.replace(path + '.tmp', path)
+
