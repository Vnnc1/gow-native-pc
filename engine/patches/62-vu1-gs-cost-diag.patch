+        unsigned long long exitTicks = 0;       // native exit: syncInflight + exportFlags
+        unsigned long long blockTicks = 0;      // sampled 1/8, already scaled: time inside the block functions
+        unsigned long long blockTicksRaw = 0;   // sampled 1/8, unscaled
+        unsigned long long dispatchTicks = 0;   // native loop minus the two above (slot lookup, lane checks, timing)
+        unsigned long long xgkickTicks = 0;     // XGKICK tag walk + finishXgkick (part of the block time)
+        unsigned long long xgkickSubmitTicks = 0; // the part of that spent handing the packet to the GS (submitGifPacket)
+        unsigned long long xgkickSamples = 0;
+    };
+    inline Counters counters;
