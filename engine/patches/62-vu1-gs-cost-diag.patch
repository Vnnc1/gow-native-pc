+    // cost of one empty ticks() pair, measured once: subtracted from every sample so the scaled estimate is not inflated
+    inline uint64_t rdtscOverhead()
+    {
+        static const uint64_t overhead = [] {
+            uint64_t best = 0xFFFFFFFFu;
+            for (int i = 0; i < 512; ++i)
+            {
+                const uint64_t a = ticks();
+                const uint64_t d = ticks() - a;
+                if (d < best)
