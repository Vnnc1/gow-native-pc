+// Host-owned acquisition accounting; sequence changes do not prove changed pixels or scanout.
+struct SharedFrameWindow {
+    struct Counts {
+        uint64_t polls=0, fresh=0, repeated=0, unavailable=0, blank=0, skipped=0, maxHoldNs=0;
+    } counts;
+    uint64_t sequence=0, sinceNew=0;
+    bool active=false;
+    void sample(uint64_t next, bool isBlank, uint64_t now) {
+        ++counts.polls;
+        if (!next || isBlank) {
+            if (!next) ++counts.unavailable; else ++counts.blank;
+            active=false;
+            return;
+        }
+        if (active && now >= sinceNew)
+            counts.maxHoldNs=std::max(counts.maxHoldNs, now-sinceNew);
+        if (!active || next != sequence) {
+            if (active && next > sequence) counts.skipped += next-sequence-1;
+            ++counts.fresh;
+            sequence=next; sinceNew=now; active=true;
+        } else ++counts.repeated;
+    }
+    // Keep the last acquisition across windows: a long freeze must not look like fresh output.
+    void clearCounts() { counts={}; }
+};
+
 }
