+// zzz-333: Accessibility > automatic QTE also performs recognized stick gestures (the player's live toggle). Half
+// turns repeat start > arc > hold > release every 0.6 s while the prompt shows; full turns keep turning the prompt's way
+// at two turns per second. Time-based like AutoButtons, so repeated reads agree; any guide change restarts the cycle.
+class AutoStick {
+public:
+    static constexpr double kHalfCycle=0.6;
+    bool apply(const Sequence &guide,double now,bool enabled,bool focused,uint8_t &x,uint8_t &y) {
+        const int turn=turnOf(guide);
+        if (!enabled || !focused || !turn || !guide.count || guide.keys[0]>3 || !std::isfinite(now)) { m_started=-1.0; return false; }
+        if (m_started<0.0 || now<m_started || guide.count!=m_guide.count || guide.turn!=m_guide.turn ||
+            guide.keys!=m_guide.keys) { m_started=now; m_guide=guide; }
+        const double t=now-m_started, start=90.0*guide.keys[0];
+        double angle=start;
+        if (guide.count==1) angle=start+turn*720.0*t;
+        else {
+            const double p=std::fmod(t,kHalfCycle);
+            if (p>=0.45) { x=y=128; return true; } // release so the next repetition starts as a new gesture
+            if (p>=0.1) angle=start+turn*180.0*std::fmin(1.0,(p-0.1)/0.2);
+        }
+        const double radians=angle/57.29577951308232;
+        x=static_cast<uint8_t>(std::lround(128.0+127.0*std::sin(radians)));
+        y=static_cast<uint8_t>(std::lround(128.0-127.0*std::cos(radians)));
+        return true;
+    }
+private:
+    double m_started=-1.0;
+    Sequence m_guide{};
+};
 inline std::mutex mutex;
 inline uint16_t buttons=0;
 inline Sequence guide{};
