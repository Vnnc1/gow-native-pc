     const double age=std::chrono::duration<double>(std::chrono::steady_clock::now()-published).count();
     return age>=0.0 && age<=0.25 ? guide : Sequence{};
 }
+// zzz-333: the left stick (x, y) of one pad read; false leaves the axes untouched (no fresh guide, disabled, unfocused).
+inline bool applyStick(uint8_t &x,uint8_t &y,bool enabled,bool focused) {
+    static AutoStick assist;
+    static std::mutex stickMutex; // both pad readers call this
+    const Sequence current=activeGuide();
+    std::lock_guard<std::mutex> lock(stickMutex);
+    const double now=std::chrono::duration<double>(std::chrono::steady_clock::now().time_since_epoch()).count();
+    return assist.apply(current,now,enabled,focused,x,y);
+}
