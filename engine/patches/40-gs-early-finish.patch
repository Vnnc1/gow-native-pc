+
+// PATH2 FINISH writes in a VIF1 packet: walks the VIF codes as processVIF1Data sizes them (STCYCL state carried in
+// `cycle`, a DIRECT cut by the packet end in `directLeft`) and the GIF tags inside DIRECT/DIRECTHL payloads, counting
+// A+D writes to FINISH (0x61). A miscount only changes when the game sees FINISH within this job, never its order.
+uint32_t PS2Memory::countPath2Finish(const uint8_t *data, uint32_t sizeBytes, uint32_t &cycle, uint32_t &directLeft)
+{
+    uint32_t pos = std::min(directLeft, sizeBytes);
+    directLeft -= pos;
+    uint32_t found = 0u;
+    while (pos + 4u <= sizeBytes)
+    {
+        uint32_t cmd;
+        std::memcpy(&cmd, data + pos, 4);
+        pos += 4u;
+        const uint32_t opcode = (cmd >> 24) & 0x7Fu, imm = cmd & 0xFFFFu, num = (cmd >> 16) & 0xFFu;
+        if (opcode == 0x01u) // STCYCL
+            cycle = imm;
+        else if (opcode == 0x20u) // STMASK
+            pos += 4u;
+        else if (opcode == 0x30u || opcode == 0x31u) // STROW, STCOL
+            pos += 16u;
+        else if (opcode == 0x4Au) // MPG
+            pos += (num == 0u ? 256u : num) * 8u;
+        else if (opcode == 0x50u || opcode == 0x51u) // DIRECT, DIRECTHL
+        {
+            const uint32_t bytes = (imm == 0u ? 65536u : imm) * 16u;
+            if (bytes > sizeBytes - pos)
+            {
+                directLeft = bytes - (sizeBytes - pos);
+                break;
+            }
+            for (uint32_t q = pos; q + 16u <= pos + bytes;)
+            {
+                uint64_t tag, regs;
+                std::memcpy(&tag, data + q, 8);
+                std::memcpy(&regs, data + q + 8, 8);
+                q += 16u;
+                const uint32_t nloop = static_cast<uint32_t>(tag & 0x7FFFu);
+                const uint32_t flg = static_cast<uint32_t>((tag >> 58) & 3u);
+                const uint32_t nreg = static_cast<uint32_t>(tag >> 60) == 0u ? 16u : static_cast<uint32_t>(tag >> 60);
+                if (flg == 0u) // PACKED: one qword per register; A+D (0xE) carries the register address
+                {
+                    for (uint32_t l = 0; l < nloop && q + 16u <= pos + bytes; ++l)
+                        for (uint32_t r = 0; r < nreg && q + 16u <= pos + bytes; ++r, q += 16u)
+                            if (((regs >> (4u * r)) & 0xFu) == 0xEu && data[q + 8] == 0x61u)
+                                ++found;
+                }
+                else if (flg == 1u) // REGLIST: 64-bit words, padded to a qword
+                    q += ((nloop * nreg + 1u) / 2u) * 16u;
+                else // IMAGE
+                    q += nloop * 16u;
+            }
+            pos += bytes;
+        }
+        else if ((opcode & 0x60u) == 0x60u) // UNPACK, sized as processVIF1Data does
+        {
+            const uint32_t vn = (opcode >> 2) & 3u, vl = opcode & 3u;
+            const uint32_t bits = vl == 0u ? 32u : vl == 1u ? 16u : vl == 2u ? 8u : (vn == 3u ? 4u : 16u);
+            const uint32_t bitsPerVector = (vl == 3u && vn == 3u) ? 16u : (vn + 1u) * bits;
+            const uint32_t bytesPerVector = (bitsPerVector + 7u) / 8u;
+            const uint32_t writes = num == 0u ? 256u : num;
+            uint32_t cl = cycle & 0xFFu, wl = (cycle >> 8) & 0xFFu;
+            cl = cl ? cl : 1u;
+            wl = wl ? wl : 1u;
+            uint32_t sources = writes;
+            if (cl < wl)
+                sources = (writes / wl) * cl + std::min(writes % wl, cl);
+            pos += ((sources * bytesPerVector) + 3u) & ~3u;
+        }
+    }
+    return found;
+}
