+#pragma once
+#include <filesystem>
+#include <fstream>
+#include <cstdlib>
+#include <string>
+namespace gow_menu_settings {
+inline bool publish(const std::string &fields) {
+    const char *root = std::getenv("GOW_MENU_SETTINGS");
+    if (!root || !*root) return false;
+    static unsigned sequence = 0;
+    if (sequence >= 4096 || fields.size() > 32768) return false;
+    try {
+        const auto dir = std::filesystem::u8path(root);
+        const auto path = dir / (std::to_string(++sequence) + ".json");
+        const auto temp = dir / (std::to_string(sequence) + ".tmp");
+        std::ofstream file(temp, std::ios::binary | std::ios::trunc);
+        file << "{" << fields << "}"; file.close();
+        if (!file) return false;
+        std::filesystem::rename(temp, path);
+        return true;
+    } catch (...) { return false; }
+}
