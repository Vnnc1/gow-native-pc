 #include <cstdint>
 #include <cstdlib>
 #include <cstring>
+#include <chrono>
+#include <condition_variable>
+#include <mutex>
 namespace gow_menu_live {
+// The scheduler acknowledges only at a guest execution boundary. The host keeps polling.
+inline std::atomic<bool> pauseRequested{false};
+inline std::atomic<bool> paused{false};
+inline std::chrono::steady_clock::duration pauseAtBoundary(std::atomic<bool> &stop,
+        std::mutex &mutex, std::condition_variable &cv) {
+    if (!pauseRequested.load(std::memory_order_acquire)) return {};
+    std::unique_lock lock(mutex);
+    const auto began=std::chrono::steady_clock::now();
+    paused.store(true,std::memory_order_release);
+    while(pauseRequested.load(std::memory_order_acquire) && !stop.load(std::memory_order_acquire))
+        cv.wait_for(lock,std::chrono::milliseconds(8));
+    const auto elapsed=std::chrono::steady_clock::now()-began;
+    paused.store(false,std::memory_order_release);
+    return elapsed;
+}
 inline std::atomic<int> volume{100};
 inline std::atomic<bool> mute{false};
+inline void loadAudio() {
+    static const bool loaded=[] {
+        if(const char *v=std::getenv("GOW_AUDIO_VOLUME")) volume.store(std::clamp(std::atoi(v),0,100));
+        const char *m=std::getenv("GOW_AUDIO_MUTE");mute.store(m && !std::strcmp(m,"1"));
+        return true;
+    }(); (void)loaded;
+}
 inline std::atomic<bool>& autoQte() {
     static std::atomic<bool> enabled{[] { const char *v=std::getenv("GOW_QTE_AUTO"); return v && !std::strcmp(v,"1"); }()};
     return enabled;
